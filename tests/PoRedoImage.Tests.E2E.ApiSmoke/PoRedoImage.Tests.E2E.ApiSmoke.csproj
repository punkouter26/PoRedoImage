<Project Sdk="Microsoft.NET.Sdk">

  <!-- PoRedoImage.Tests.E2E.ApiSmoke: pure HTTP smoke tests against a live instance.
       The split from the previous merged Tests.E2E project lets the API suite run on
       any agent without the Playwright / Chromium cache dependency. The companion
       PoRedoImage.Tests.E2E.UI project owns the C# Playwright browser tests.
       Both self-skip when no live instance is reachable via LiveServerFactAttribute
       (defined here so the UI project can reference it). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PoRedoImage.Shared\PoRedoImage.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestCounting.cs" Link="TestCounting.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
