<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Trim analysis is off for test projects (Directory.Build.props enables it solution-wide);
         NetArchTest is reflection-driven by nature and would light up IL2026 everywhere. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.eNhancedEdition" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencing the composition root transitively pulls in every assembly the rules inspect
         (Domain, Application, Infrastructure, Shared, Client), so each one is loadable by
         reflection. PoRedoImage.Mobile is deliberately absent: it targets net10.0-android and a
         net10.0 test project cannot reference it. -->
    <ProjectReference Include="..\..\src\PoRedoImage.Web\PoRedoImage.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestCounting.cs" Link="TestCounting.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
