flowchart LR
    subgraph Triggers["Triggers"]
        PR["Pull Request\nto master"]
        Push["Push to master\nor manual dispatch"]
    end

    subgraph CI["ci.yml — CI Gate"]
        direction TB
        Restore["dotnet restore\nNuGet cache hit"]
        Build["dotnet build\nRelease config\nWarningsAsErrors"]
        UnitTest["Unit Tests\nxUnit pure logic"]
        IntTest["Integration Tests\nTestcontainers\nAzurite Table Storage"]
        CovGate["Coverage Gate\n≥ 80% opencover\n⚠ warn-only today"]
        Artifacts["Upload\nTestResults TRX\nCoverage XML"]
    end

    subgraph E2EJob["e2e.yml — E2E Gate"]
        direction TB
        InstallPW["npm ci\nPlaywright install"]
        ServePW["Start App\nASP.NET Development"]
        RunPW["npx playwright test\nHeadless Chromium\nMobile viewports"]
        PWReport["Upload\nPlaywright Report\nScreenshots on failure"]
    end

    subgraph Deploy["azure-deploy.yml — Production Deploy"]
        direction TB
        DotnetPub["dotnet publish\nRelease → ./publish"]
        AzLogin["Azure Login\nOIDC Federated Identity\nNo long-lived secrets"]
        ZipDeploy["az webapp deploy\nzip → OneDeploy API\nasync=true"]
        Startup["Set startup command\ndotnet PoRedoImage.Web.dll"]
        Smoke["Smoke check\ncurl /health → 200"]
    end

    PR -->|"triggers"| CI
    CI --> CovGate
    CovGate --> Artifacts

    Push -->|"triggers"| Deploy
    Push -->|"optional"| E2EJob

    Deploy --> Smoke

    Restore --> Build --> UnitTest --> IntTest --> CovGate
    InstallPW --> ServePW --> RunPW --> PWReport
    DotnetPub --> AzLogin --> ZipDeploy --> Startup --> Smoke

