flowchart TB
    subgraph Roles["User Roles"]
        direction LR
        Anon["Anonymous\n(unauthenticated)"]
        DevUser["Dev User\n(dev|email cookie)"]
        ProdUser["Prod User\n(Entra ID OIDC)"]
        Admin["Admin\n(future — Entra group)"]
    end

    subgraph PublicEndpoints["Public / Anonymous Endpoints"]
        Health["/health\nGET — all roles"]
        Diag["/diag\nGET — all roles\n(values masked)"]
        Scalar["/scalar/v1\nAPI docs — all roles"]
        Login["/login\nGET — all roles"]
        DevLoginEP["/dev-login\nGET — Dev env only\nAllowAnonymous"]
        ChallengeMicrosoft["/challenge-microsoft\nGET — all roles"]
    end

    subgraph AIEndpoints["AI Endpoints — RequireRateLimiting(ai-endpoints)\n10 req/min per user or IP"]
        Analyze["/api/images/analyze\nPOST — all authenticated + anon (no auth attr)\nRate limited"]
        Describe["/api/bulk-generate/describe\nPOST — rate limited (no auth attr)"]
        Variation["/api/bulk-generate/variation\nPOST — rate limited (no auth attr)"]
    end

    subgraph AuthEndpoints["Authenticated Endpoints — RequireAuthorization"]
        GetPrompts["/api/bulk-generate/prompts\nGET — authenticated users\nReads own UserId"]
        SavePrompts["/api/bulk-generate/prompts\nPOST — authenticated users\nWrites own UserId"]
        SaveOriginal["/api/user-images/save-original\nPOST — authenticated users"]
        SaveResult["/api/user-images/save-result\nPOST — authenticated users"]
        GetImages["/api/user-images\nGET — authenticated users\nReturns own images only"]
        DeleteImage["/api/user-images/{id}\nDELETE — authenticated users\nOwnership check enforced"]
    end

    subgraph BlazorPages["Blazor Pages (Server-side auth)"]
        Studio["/ Studio.razor\nSSR — auth optional\nfeatures degrade if no auth"]
        BulkPage["/bulk-generate BulkGenerate.razor\nSSR — auth required for save"]
        UserImagesPage["/user-images\nSSR — auth required"]
        DiagPage["/diag Diag.razor\nSSR — all roles"]
    end

    Anon -->|"can access"| PublicEndpoints
    Anon -->|"rate limited"| AIEndpoints
    Anon -.->|"blocked"| AuthEndpoints

    DevUser -->|"can access"| PublicEndpoints
    DevUser -->|"rate limited"| AIEndpoints
    DevUser -->|"can access"| AuthEndpoints
    DevUser -->|"can access"| BlazorPages

    ProdUser -->|"can access"| PublicEndpoints
    ProdUser -->|"rate limited"| AIEndpoints
    ProdUser -->|"can access"| AuthEndpoints
    ProdUser -->|"can access"| BlazorPages

