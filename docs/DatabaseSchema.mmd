%% DatabaseSchema.mmd — Azure Table Storage architecture
%% Strongly typed ITableEntity layout, partition/row keys, and indexing relation bounds.
%% Render with:
%%   npx @mermaid-js/mermaid-cli -i DatabaseSchema.mmd -o DatabaseSchema.svg

erDiagram
    USER_IMAGE ||--o{ USER_IMAGE_TAG : "has"
    USER_IMAGE ||--o| AI_METADATA : "annotated by"
    BULK_PROMPT ||--o{ USER_IMAGE : "may produce"
    MEME_TEMPLATE ||--o{ USER_IMAGE : "renders into"
    STYLE_DIRECTOR_RUN ||--o{ USER_IMAGE : "may produce"
    PRICING_SNAPSHOT }o--|| PRICING_PROVIDER : "scoped by"

    USER_IMAGE {
        string PartitionKey "PK = UserId (string, hashed) — colocation of one user's images"
        string RowKey       "RK = Guid.NewGuid().ToString('N') — log-scale, append-only"
        string ContentType  "image/jpeg | image/png"
        bytes  ImageData    "Blob ref (URL) — actual bytes go to Blob Storage"
        string Mode         "ImageRegeneration | MemeGeneration"
        double ConfidenceScore "0.0 - 1.0"
        string Description  "string, max 1024 chars (FluentValidation enforced)"
        datetime CreatedAt  "DateTimeOffset.UtcNow (indexed by)"
        string CorrelationId "matches X-Correlation-ID for the AI run"
        string ETag         "for optimistic concurrency"
    }

    USER_IMAGE_TAG {
        string PartitionKey "PK = ImagePK (forwarded) for tag joins"
        string RowKey       "RK = tag (lowercased, trimmed)"
        float  Confidence   "tag confidence from CV"
    }

    AI_METADATA {
        string PartitionKey "PK = CorrelationId — colocation of one AI run"
        string RowKey       "RK = step ('cv' | 'openai' | 'gemini')"
        long   DurationMs   "duration of that step"
        int    TokensUsed   "OpenAI only"
        string Provider     "google | openai | huggingface"
        string ModelId      "gemini-2.5-flash-image | gpt-4.1-nano | ..."
    }

    BULK_PROMPT {
        string PartitionKey "PK = UserId"
        string RowKey       "RK = '{yyyymm}:{slug}' (date-prefixed for time-range queries)"
        string Title        "max 80 chars"
        string Body         "prompt text"
        string[] Tags       "client-side flatten"
        bool    IsFavorite  "favorites list cross-cut"
        datetime UpdatedAt
    }

    MEME_TEMPLATE {
        string PartitionKey "PK = 'templates' — shared global set"
        string RowKey       "RK = slug"
        string TopText      "max 60 chars"
        string BottomText   "max 60 chars"
        string ImgUrl       "template asset URL"
        int    Width        "template native width"
        int    Height       "template native height"
    }

    STYLE_DIRECTOR_RUN {
        string PartitionKey "PK = UserId"
        string RowKey       "RK = Guid.NewGuid().ToString('N')"
        string ImageRef     "UserImage.RowKey"
        string[] AgentLog   "serialised agent reasoning entries (VisionAnalyst → Strategist → PromptRefiner → Critic)"
        long   ElapsedMs    "total wall-clock"
        int    TokensUsed   "OpenAI usage across the 4 agents"
        string Status       "Running | Succeeded | Failed"
    }

    PRICING_PROVIDER {
        string PartitionKey "PK = 'providers'"
        string RowKey       "RK = provider key ('google' | 'huggingface')"
        string DisplayName  "Gemini Imagen3 | HuggingFace Inference Providers"
        bool    Enabled     "feature flag — same value as ImageGen:Provider"
    }

    PRICING_SNAPSHOT {
        string PartitionKey "PK = ProviderRowKey"
        string RowKey       "RK = '{yyyymmddHH}:{modelId}' — append-only price history"
        decimal PerImageUsd "indicative USD per image"
        datetime CapturedAt
        string Source       "'static' | 'live-fetch'"
    }

    %% Indexing relation bounds
    %% Index 1: USER_IMAGE.partition (UserId, CreatedAt desc)  — gallery listing
    %% Index 2: AI_METADATA.partition (CorrelationId)         — trace lookup
    %% Index 3: BULK_PROMPT.partition (UserId, RowKey)         — date-range favourite list
    %% Constraint: USER_IMAGE.ImageData is a Blob URL, not raw bytes — Table max 64 KB