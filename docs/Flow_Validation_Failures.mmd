%% Flow_Validation_Failures.mmd — UI validation to backend exception mapping inside a vertical slice.
%% Single slice example: POST /api/images/analyze. Native HTML input / EditForm rules run client-side;
%% FluentValidation + ProblemDetails on the server surface the same rule violations.
%% Render with:
%%   npx @mermaid-js/mermaid-cli -i Flow_Validation_Failures.mmd -o Flow_Validation_Failures.svg

graph TD
    classDef ui fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef slice fill:#fff3e0,stroke:#e65100,color:#bf360c
    classDef infra fill:#ede7f6,stroke:#4527a0,color:#311b92
    classDef ok fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef err fill:#ffebee,stroke:#c62828,color:#b71c1c

    User["User clicks Analyze"]:::ok
    Req["HttpRequestMessage plus CorrelationHeader"]:::ui

    C1["InputFile accept image slash star max size 12 MB"]:::ui
    C2["Magic-byte sniff JPEG FFD8FF PNG 89504E47 WEBP RIFF WEBP"]:::ui
    C3["EditForm plus DataAnnotations ImageData required ContentType required"]:::ui
    C4["DescriptionLength between 200 and 500"]:::ui
    C5["Display Radzen Alert inline plus summary"]:::ui

    S1["Minimal API endpoint POST /api/images/analyze"]:::slice
    S2["FluentValidation ImageAnalysisRequestValidator"]:::slice
    S3["ImageAnalysisHandler orchestrator"]:::slice
    S4["IImageAnalysisService.ComputerVision.AnalyzeAsync"]:::slice
    S5["OpenAIService.EnhanceDescriptionAsync"]:::slice
    S6["GeminiImagen3Service.GenerateAsync"]:::slice

    I1["HttpValidationProblemDetails RFC 7807"]:::infra
    I2["Exception handler InvalidImageException to 400"]:::infra
    I3["RateLimiter 10 req per min per IP to 429"]:::infra
    I4["AI policy violation to 422"]:::infra
    I5["AI key/endpoint mismatch to 503"]:::infra

    RespOK["ImageAnalysisResponse 200"]:::ok
    RespBad["ValidationProblemDetails 400"]:::err
    RespUnauth["401 Unauthorized"]:::err
    RespRate["429 Too Many Requests"]:::err
    RespPolicy["422 Unprocessable Entity"]:::err
    RespDown["503 Service Unavailable"]:::err
    Retried["User fixes input and retries"]:::ok
    RenderUI["Radzen ResultsPanel"]:::ui

    User --> C1
    C1 -- "invalid file" --> C5 --> Retried
    C1 -- "valid" --> C2
    C2 -- "bad magic bytes" --> C5 --> Retried
    C2 -- "ok" --> C3
    C3 -- "invalid form" --> C5 --> Retried
    C3 -- "ok" --> C4
    C4 -- "out of range" --> C5 --> Retried
    C4 -- "ok" --> Req
    Req --> S1
    S1 -- "no cookie" --> RespUnauth
    S1 --> I3
    I3 -- "rate more than 10 per min" --> RespRate
    I3 -- "ok" --> S2
    S2 -- "FluentValidation failure" --> RespBad
    S2 -- "passes" --> S3
    S3 --> S4
    S4 -- "InvalidImageException" --> I2 --> RespBad
    S4 -- "ok" --> S5
    S5 -- "AIContentPolicyException" --> I4 --> RespPolicy
    S5 -- "ok" --> S6
    S6 -- "AIServiceUnavailableException" --> I5 --> RespDown
    S6 -- "ok" --> RespOK

    RespOK --> RenderUI