graph TD
    classDef web fill:#fff3e0,stroke:#e65100,color:#bf360c
    classDef client fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef shared fill:#ede7f6,stroke:#4527a0,color:#311b92
    classDef domain fill:#f3e5f5,stroke:#6a1b9a,color:#4a148c
    classDef infra fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef slice fill:#fff8e1,stroke:#ff8f00,color:#e65100
    classDef ext fill:#f5f5f5,stroke:#616161,color:#212121

    Browser["Browser"]:::ext
    HostDoc["Components/App.razor (host doc only)"]:::web
    Mw["Middleware: Auth · Correlation · Exception · RateLimit · Idempotency"]:::web
    Slices["Features/{Name}/ slices (Auth · ImageAnalysis · BulkGenerate · StyleDirector · MemeTemplates · UserImages · Pricing · Diagnostics)"]:::slice

    Pages["Pages · Shared · Http · Models"]:::client
    SharedBox["DTOs · Json source-gen · Imaging helpers"]:::shared
    DomainBox["Entities · Interfaces (IImageGenerationService · IRepository)"]:::domain
    InfraBox["Repositories (Table Storage) · Services (CV · OpenAI · Gemini · HF)"]:::infra

    External["Azure Table · Key Vault · CV · OpenAI · Gemini · App Insights"]:::ext

    subgraph ClientAsm["PoRedoImage.Client (Blazor WASM)"]
        Pages
    end

    subgraph WebAsm["PoRedoImage.Web (BFF/API host)"]
        HostDoc --> Mw --> Slices
    end

    subgraph SharedAsm["PoRedoImage.Shared (RESTRICTED)"]
        SharedBox
    end

    subgraph DomainAsm["PoRedoImage.Domain (cross-slice only)"]
        DomainBox
    end

    subgraph InfraAsm["PoRedoImage.Infrastructure"]
        InfraBox
    end

    Browser <-->|"cookies only"| HostDoc
    Pages -- "typed HttpClient" --> HostDoc
    Slices --> SharedBox
    Slices --> DomainBox
    Slices --> InfraBox
    InfraBox --> External