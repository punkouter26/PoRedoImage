flowchart TD
    subgraph AuthErrors["Authentication & Access Errors"]
        NotAuth["Unauthenticated request\nto protected page"]
        --> RedirectLogin["Redirect → /login\n401 or cookie missing"]
        RedirectLogin --> LoginAttempt{"Login attempt"}
        LoginAttempt -->|"OIDC failure / timeout"| OIDCFail["OIDC error page\nDisplay error description\nfrom callback params"]
        LoginAttempt -->|"Dev login without email"| DevEmpty["Redirect → /login\n(no cookie set)"]
        LoginAttempt -->|"Invalid returnUrl"| SanitizeRedirect["returnUrl sanitized\nfallback → /\n(open-redirect prevention)"]
    end

    subgraph ValidationErrors["Input Validation Errors"]
        BadBase64["Non-base64 image data"]
        --> Base64Fail["HTTP 400\n'Invalid base64 image data'"]

        BadMagic["Invalid image magic bytes\nnot JPEG FF D8 FF\nnot PNG 89 50 4E 47"]
        --> MagicFail["HTTP 400\n'Not a valid JPEG or PNG'"]

        BadDescLen["DescriptionLength < 200\nor > 500"]
        --> DescFail["HTTP 400\n'DescriptionLength must be 200-500'"]

        BadPrompts["Prompts array ≠ 10 items\nor item > 2000 chars"]
        --> PromptFail["HTTP 400\n'Exactly 10 prompts required'"]
    end

    subgraph RateLimiting["Rate Limiting"]
        TooManyReqs["User exceeds\n10 req/min on /api/images\nor /api/bulk-generate"]
        --> HTTP429["HTTP 429 Too Many Requests\nRetry-After header\nUI shows cooldown timer"]
    end

    subgraph ContentPolicy["AI Content Policy Violations"]
        PolicyViolation["Azure OpenAI / Gemini\ncontent_policy_violation\nin response"]
        --> HTTP422["HTTP 422\n'Image blocked by content filters'\nUser prompt: try different image"]
    end

    subgraph AIErrors["AI Service Failures"]
        CVDown["Computer Vision\ntimeout / service unavailable"]
        --> CVFail["HTTP 500\n'Processing Error'\nLog: LogError with trace"]

        GeminiDown["Gemini endpoint\nnot configured / quota exceeded"]
        --> GeminiFail["HTTP 400\n'Imagen3 service not configured'\nor HTTP 500 on quota"]

        OpenAIDown["Azure OpenAI\ndeployment throttle / outage"]
        --> OpenAIFail["HTTP 500\nRetry-after propagated\nto client"]
    end

    subgraph StorageErrors["Storage Errors"]
        TableFail["Azure Table Storage\nconnection failure"]
        --> TableErr["Health check → Degraded\n/health returns 503\nBulkPrompts save silently fails"]
    end

    style NotAuth fill:#d4512b,stroke:#a83a1f,color:#fff
