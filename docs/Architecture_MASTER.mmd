flowchart TB
    subgraph Edge["Edge Delivery"]
        direction TB
        User["👤 User\nBrowser / Mobile"]
        CDN["Azure CDN\nStatic Assets"]
    end

    subgraph Compute["Compute Tier — Azure App Service"]
        direction TB
        Blazor["Blazor Web App\n.NET 10 SSR + Interactive Server\nPoRedoImage.Web"]
        API["Minimal API\n/api/images · /api/bulk-generate\n/api/user-images · /health · /diag"]
        Auth["Auth Layer\nCookie · Microsoft Entra OIDC\n/dev-login (Dev only)"]
        RateLimit["Rate Limiter\n10 req/min per user\nHTTP 429 on breach"]
    end

    subgraph Application["Application Layer"]
        Orchestrator["ImageAnalysisOrchestrator\nVSA Feature Slices"]
        BulkOrch["BulkGenerate Pipeline\nParallel Gemini calls"]
    end

    subgraph AIServices["AI Services"]
        direction LR
        CV["Azure Computer Vision\ncv-poshared-eastus\nImage tagging + confidence"]
        OpenAI["Azure OpenAI\nGPT-4.1-nano\nDescription enhancement\nMeme captions"]
        Gemini["Google Gemini\ngemini-2.5-flash-image\nImage regeneration\nBulk 10x variations"]
    end

    subgraph DataTier["Data Persistence"]
        direction LR
        Tables["Azure Table Storage\nstporedoimage26\nUSER_IMAGES · BULK_PROMPTS"]
        KV["Azure Key Vault\nkv-poshared\n30-min secret rotation"]
        Blobs["In-Memory Blob\nBase64 pipeline transfer"]
    end

    subgraph Ops["Observability"]
        direction LR
        AI_Insights["Application Insights\nTraces · Metrics · Logs"]
        Serilog["Serilog\nStructured logging\nFile + Console + AppInsights"]
        OTel["OpenTelemetry\nASP.NET + HttpClient\nRuntime metrics"]
    end

    subgraph CICD["CI/CD — GitHub Actions"]
        direction LR
        PR["Pull Request\nci.yml\nBuild + Test + Coverage 80%"]
        Deploy["master push\nazure-deploy.yml\nOIDC → App Service"]
        E2E["e2e.yml\nPlaywright TypeScript\nHeadless Chromium"]
    end

    User -->|"HTTPS"| CDN
    CDN -->|"Static"| Blazor
