%% PoRedoImage — Testing Tier Hierarchy (DETAILED)
%% Counts are declared [Fact]/[Theory]/[DockerFact]/[LiveServerFact] attributes at the
%% documented commit (ccd3d60). Ceilings are enforced by TestCountCeilingTests per tier.
flowchart TB

    subgraph T1["Tier 1 — Unit · PoRedoImage.Tests.Unit"]
        direction TB
        U1["Ceiling 100 methods (100/50/25 Rule)<br/>~101 declared attributes incl. the meta-test"]
        U2["xUnit 2.9 + Moq 4.20 · NO I/O, NO network, NO container"]
        U3["Agents/ StyleDirectorWorkflowTests · VisionAnalystAgentTests"]
        U4["Features/ LocalAiChainTests (DtypeChain pruning + advance)<br/>OpenAIServiceTests · Imagen3ServiceTests · ComputerVisionServiceTests<br/>MemeGeneratorServiceTests · MemeTemplateServiceTests · RapRoastTests<br/>DiagnosticsEndpointsTests · KeyVaultSecretNameMappingTests"]
        U5["Models/ + Shared/ ImageAnalysisResult · ProcessingMetrics<br/>ImageSessionServiceCrossPageState"]
        U1 --> U2 --> U3 --> U4 --> U5
    end

    subgraph T2["Tier 2 — Integration · PoRedoImage.Tests.Integration"]
        direction TB
        I1["Ceiling 50 methods"]
        I2["Microsoft.AspNetCore.Mvc.Testing WebApplicationFactory<br/>+ Testcontainers 4.3 (Azurite)"]
        I3["AzuriteContainerFixture owns a THROWAWAY container<br/>docker-compose Azurite is F5-only and must never be touched (ADR-019)"]
        I4["[DockerFact] self-skips when the Docker daemon is unreachable"]
        I5["ASPNETCORE_ENVIRONMENT=Test -> FakeAuthHandler + /auth/login/fake"]
        I6["Endpoint tests: ImageAnalysis · BulkGenerate · RapRoast<br/>Diagnostics · Health · Azurite round-trip<br/>BudgetGuardrailTests (no live token spend)<br/>Contracts/ request + options validators, SceneSnapshot parsing"]
        I1 --> I2 --> I3 --> I4 --> I5 --> I6
    end

    subgraph T3["Tier 3 — E2E API smoke · PoRedoImage.Tests.E2E.ApiSmoke"]
        direction TB
        A1["Ceiling 25 methods · ~11 declared"]
        A2["Pure HTTP against a LIVE instance — no browser, no Playwright cache"]
        A3["[LiveServerFact] self-skips when nothing answers on E2E_BASE_URL<br/>(default http://localhost:4000)"]
        A4["ApiSmokeTests: /health · /alive · /api/diag authz · OpenAPI · Scalar"]
        A1 --> A2 --> A3 --> A4
    end

    subgraph T4["Tier 4 — E2E UI · PoRedoImage.Tests.E2E.UI"]
        direction TB
        P1["Ceiling 25 methods · ~11 declared"]
        P2["Microsoft.Playwright 1.59 (C#) + Chromium"]
        P3["Deque.AxeCore.Playwright — automated WCAG 2.2 AA gate, offline"]
        P4["Class names containing 'Ui' identify the UI suite"]
        P5["LoginUiTests: anonymous home redirects to /login (awaits WaitForURLAsync,<br/>not NetworkIdle — the WASM router performs the redirect after boot)<br/>AccessibilityUiTests: axe scan per route<br/>PlaywrightViewports: mobile-first portrait matrix"]
        P1 --> P2 --> P3 --> P4 --> P5
    end

    Code["Production code<br/>src/*"] --> T1
    T1 -->|"green, no I/O"| T2
    T2 -->|"green, real Azurite"| T3
    T3 -->|"green, live host"| T4

    Shared["tests/TestCounting.cs — linked into ALL four projects<br/>single reflection helper backing every ceiling test"]
    Shared -.-> T1
    Shared -.-> T2
    Shared -.-> T3
    Shared -.-> T4

    Policy["CI/CD does NOT run tests (project policy).<br/>Suites run locally or in a dedicated non-deploy workflow.<br/>SCRIPTS/run-e2e.ps1 drives tiers 3 and 4."]
    T4 --> Policy

