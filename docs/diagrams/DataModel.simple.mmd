%% PoRedoImage — Persistence ERD (SIMPLE)
erDiagram
    USER ||--o{ USER_IMAGES : owns
    USER_IMAGES ||--|| USER_IMAGE_BLOB : "bytes"
    BULK_PROMPTS }o--|| PROMPT_PARTITION : "single partition"

    USER {
        string UserId PK
    }
    USER_IMAGES {
        string PartitionKey PK "userId"
        string RowKey PK "imageId"
        int Kind "Original Regeneration Meme BulkVariation"
        long SizeBytes
    }
    USER_IMAGE_BLOB {
        string BlobName PK "userId/imageId"
        binary Content
    }
    BULK_PROMPTS {
        string RowKey PK
        string PromptText
    }
    PROMPT_PARTITION {
        string Value PK "prompts"
    }
