%% Flow_RealTime_Lobby.mmd — Client-side processing vs async backend propagation
%% Server-validated SignalR Hub states and user connectivity lifecycles.
%% Render with:
%%   npx @mermaid-js/mermaid-cli -i Flow_RealTime_Lobby.mmd -o Flow_RealTime_Lobby.svg

flowchart LR
    classDef client fill:#e3f2fd,stroke:#1565c0,color:#0d47a1
    classDef signalr fill:#fff3e0,stroke:#e65100,color:#bf360c
    classDef state fill:#ede7f6,stroke:#4527a0,color:#311b92
    classDef ok fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20
    classDef warn fill:#ffebee,stroke:#c62828,color:#b71c1c

    C1["User drags cursor on canvas<br/>pointermove event approx 60 Hz"]:::client
    C2["Throttle to 20 Hz in JS<br/>skip below 8 px move"]:::client
    C3["GroupBy roomId on client<br/>queue outbound frames"]:::client
    C4["Optimistic local render<br/>no server round-trip"]:::client

    H1["/hubs/lobby negotiate<br/>WebSocket transport fallback SSE"]:::signalr
    H2["LobbyHub.OnMoveAsync uid x y<br/>validate coord in 0 to 1 plus rate-limit 20 Hz per user"]:::signalr
    H3["ConnectionMultiplexer<br/>fan-out to room group"]:::signalr
    H4["Backpressure: drop frames<br/>if more than 500 pending"]:::signalr

    S1["LobbyStateStore<br/>PK equals RoomId, RK equals UserId"]:::state
    S2["Room presence counter<br/>expires after 30 s heartbeat"]:::state
    S3["Versioning: last-write-wins<br/>plus Lamport clock for ordering"]:::state
    S4["Idle eviction job more than 5 min<br/>snapshots to cold storage"]:::state

    L1["Connected"]:::ok
    L2["Authenticated cookie validated via JWT bearer on /hubs/"]:::ok
    L3["Joined room group"]:::ok
    L4["Active"]:::ok
    L5["Reconnecting transient less than 30 s"]:::warn
    L6["Hard-fail more than 30 s"]:::warn
    L7["Closed"]:::warn

    OtherClients["Broadcast to other members"]:::ok
    Drop["Drop frame, log"]:::warn

    C1 --> C2 --> C3 --> C4
    C4 -- "sendMove(x,y)" --> H1
    H1 --> H2
    H2 -- "invalid coord or rate too high" --> Drop
    H2 -- "valid" --> H3
    H3 --> H4
    H4 --> OtherClients
    H3 --> S1
    S1 --> S2
    S2 --> S3
    S3 --> S4

    L1 --> L2 --> L3 --> L4
    L4 -- "transient loss" --> L5 --> L4
    L5 -- "more than 30 s" --> L6 --> L7
    L4 -- "/auth/logout" --> L7
    L4 -- "idle more than 5 min" --> S4