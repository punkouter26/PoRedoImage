flowchart TD
    Start(["👤 Authenticated User\non Studio page"])

    Start --> OpenBulk["Navigate to /bulk-generate\nBulkGenerate.razor"]
    OpenBulk --> UploadImg["Upload reference photo\n(file picker / drag-drop / paste)"]
    UploadImg --> ViewPrompts["Review 10 art-style prompts\n(loaded from saved or defaults)"]

    ViewPrompts --> EditPrompts{"Edit prompts?"}
    EditPrompts -->|"Yes"| ModifyPrompt["Modify prompt text\n≤ 2000 chars each"]
    EditPrompts -->|"No"| SaveOpt
    ModifyPrompt --> SaveOpt

    SaveOpt{"Save prompts?"}
    SaveOpt -->|"Yes"| SavePrompts["POST /api/bulk-generate/prompts\nPersist to Table Storage\nPartition=userId"]
    SaveOpt -->|"No"| Describe
    SavePrompts --> Describe

    Describe["POST /api/bulk-generate/describe\nGPT-4.1-nano describes person\nin uploaded image"]
    --> ShowDesc["Person description displayed\nUsed as shared context for all prompts"]

    ShowDesc --> GenerateAll["Click 'Generate All'\n10 parallel variation calls"]

    subgraph Parallel["Parallel Execution — 10 slots"]
        direction LR
        V1["Slot 1\nPOST /variation\nGemini Imagen3"]
        V2["Slot 2\nPOST /variation\nGemini Imagen3"]
        Vdots["Slots 3–9\n..."]
        V10["Slot 10\nPOST /variation\nGemini Imagen3"]
    end

    GenerateAll --> Parallel

    V1 & V2 & Vdots & V10 --> StreamDisplay["Results stream live\nas each slot completes\nProgressBar updates"]

    StreamDisplay --> AllDone["All 10 variations displayed\nin BulkResultsGrid"]
    AllDone --> Download["Download individual images\nor save to gallery"]

