    User([User drags cursor]) --> Throttle["Throttle 60→20 Hz<br/>optimistic local render"]:::client
    Throttle --> Hub["LobbyHub<br/>validate coord + rate-limit 20 Hz/user"]:::signalr
    Hub -- "invalid" --> Drop([Drop frame]):::warn
    Hub -- "ok" --> Fanout["Fan-out to room group"]
    Fanout --> Other(["Other clients"]):::ok
    Fanout --> Store["LobbyStateStore<br/>PK=RoomId, RK=UserId"]:::state

    Conn["Connected → AuthN → Joined → Active"]:::ok
    Conn -- "transient" --> Reconnect --> Conn
    Conn -- "> 30 s" --> Closed(["Closed"]):::warn