erDiagram
    USER ||--o{ BULK_PROMPT : "creates"
    BULK_PROMPT ||--o{ IMAGE_RESULT : "contains"
    BULK_PROMPT }|--|| PROMPT_STATUS : "tracks state via"

    USER {
        string NameIdentifier PK "ClaimTypes.NameIdentifier"
        string Email
        string DisplayName
    }

    BULK_PROMPT {
        string PartitionKey PK "= NameIdentifier"
        string RowKey PK "= PromptId GUID"
        string PromptText
        string ArtStyle
        string Status "Pending|Processing|Complete|Failed"
        int ImageCount
        datetime Timestamp
    }

    IMAGE_RESULT {
        string PromptId FK "= BulkPrompt RowKey"
        int Index PK "0-based art style index"
        string ImageUrl
        string ContentType "image/png"
        int GenerationMs
    }

    PROMPT_STATUS {
        string Value PK "Pending → Processing → Complete|Failed"
    }
