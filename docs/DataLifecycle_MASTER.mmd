flowchart TD
    subgraph Ingestion["Ingestion"]
        Upload["User Uploads JPEG or PNG\nbase64 encoded via browser"]
        Validate["Magic Byte Validation\nJPEG: FF D8 · PNG: 89 50 4E 47"]
        Mode["Select Processing Mode\nAnalyze · Regenerate · Meme"]
    end

    subgraph Processing["Processing Pipeline"]
        CVStep["Azure Computer Vision\nAnalyzeImageAsync\ndescription + tags + confidence score"]
        GPTStep["Azure OpenAI GPT-4.1-nano\nEnhanceDescriptionAsync\n200-500 char prompt refinement"]
        BranchRegen{"Mode?"}
        GeminiRegen["Google Gemini\ngemini-2.5-flash-image\nGenerateImageAsync with reference bytes"]
        MemeStep["Meme Generator Service\nSkiaSharp text overlay\non original image bytes"]
        AnalysisOnly["Analysis Result Only\nno image generation"]
        BulkPath["Bulk Generate Path\n10 art styles in parallel\nper-style Gemini calls"]
    end

    subgraph Egress["Egress and UI Update"]
        Metrics["ProcessingMetrics\ncvMs · gptMs · regenMs · totalMs"]
        ImageResult["ImageAnalysisResult\nbase64 image + tags + description"]
        BulkStore["Azure Table Storage\nBulkPrompt entity persisted\nImageResult per index stored"]
        RenderUI["Blazor Component Re-render\nStreaming update via SignalR"]
    end

    Upload --> Validate
    Validate -->|"Valid"| Mode
    Validate -->|"Invalid"| Reject["400 Bad Request\nInvalid Image"]
    Mode --> CVStep --> GPTStep --> BranchRegen
    BranchRegen -->|"Regenerate"| GeminiRegen --> ImageResult
    BranchRegen -->|"Meme"| MemeStep --> ImageResult
    BranchRegen -->|"Analyze"| AnalysisOnly --> ImageResult
    BranchRegen -->|"Bulk"| BulkPath --> BulkStore
    ImageResult --> Metrics --> RenderUI
    BulkStore --> RenderUI

