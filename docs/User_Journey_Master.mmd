flowchart TD
    subgraph IDENTITY["Identity Provider"]
        direction TB
        START([User Visits App]) --> CHECK_AUTH{Auth Check}
        CHECK_AUTH -->|"Dev (no OIDC)"| DEV_LOGIN["/dev-login\nCookie Auth"]
        CHECK_AUTH -->|"Prod (OIDC)"| ENTRA["Microsoft Entra ID\nOIDC Challenge"]
        ENTRA --> GOOGLE["Google OIDC\n(Alt Provider)"]
        DEV_LOGIN --> SESSION["Session Created\nClaimsPrincipal"]
        ENTRA --> SESSION
        GOOGLE --> SESSION
    end

    subgraph SUCCESS["Success Path"]
        SESSION --> UPLOAD["Upload Image\n(Magic-byte validate)"]
        UPLOAD --> CHOOSE_MODE{Choose Mode}
        CHOOSE_MODE -->|"ImageRegen"| REGEN["CV → OpenAI → Gemini\nImage Regeneration"]
        CHOOSE_MODE -->|"MemeGen"| MEME["CV → OpenAI Caption\n→ SkiaSharp Overlay"]
        CHOOSE_MODE -->|"Bulk Generate"| BULK["Describe → 10× Parallel\nGemini Variations"]
        CHOOSE_MODE -->|"Caption Battle"| BATTLE["8× Persona\nParallel Caption"]
        CHOOSE_MODE -->|"Style Director"| DIRECTOR["4-Agent Sequential\nWorkflow"]
        REGEN --> GALLERY["Save to Gallery\n(Table Storage + Blob)"]
        MEME --> GALLERY
        BULK --> GALLERY
        BATTLE --> RESULT["Display Result\n(Radzen Components)"]
        DIRECTOR --> RESULT
        GALLERY --> RESULT
    end

    subgraph ERROR["Error Handling"]
        UPLOAD -->|"Invalid Format"| E400["400 Bad Request\nMagic-byte mismatch"]
        REGEN -->|"Content Policy"| E422["422 Content Policy\nViolation"]
        REGEN -->|"Rate Limit"| E429["429 Too Many Requests\nSliding Window"]
        REGEN -->|"AI Auth Fail"| E503["503 Service Unavailable\nKey/Endpoint mismatch"]
        REGEN -->|"Gemini Refused"| E422B["422 Generation Declined\nTry different image"]
        BULK -->|"Storage Fail"| E500["500 Processing Error\nTransient retry"]
        E400 --> RETRY["User Retries"]
        E422 --> RETRY
        E429 --> RETRY
        E503 --> RETRY
        E422B --> RETRY
        E500 --> RETRY
        RETRY --> UPLOAD
    end

    classDef logic fill:#111,stroke:#89b4fa,color:#fff
    classDef data fill:#eee,stroke:#f2c811,color:#000
    classDef error fill:#111,stroke:#f38ba8,color:#fff
    classDef success fill:#111,stroke:#a6e3a1,color:#fff

    class START,CHECK_AUTH,DEV_LOGIN,ENTRA,GOOGLE,SESSION logic
    class UPLOAD,CHOOSE_MODE,BATTLE,DIRECTOR data
    class REGEN,MEME,BULK,GALLERY,RESULT success
    class E400,E422,E429,E503,E422B,E500,RETRY error