<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PoRedoImage.Mobile.ViewModels"
             x:Class="PoRedoImage.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#0B0F19">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BgDark">#0B0F19</Color>
            <Color x:Key="BgCard">#161F30</Color>
            <Color x:Key="BgCardHover">#1E293B</Color>
            <Color x:Key="Primary">#3B82F6</Color>
            <Color x:Key="PrimaryDark">#1D4ED8</Color>
            <Color x:Key="AccentPurple">#8B5CF6</Color>
            <Color x:Key="AccentPink">#EC4899</Color>
            <Color x:Key="AccentAmber">#F59E0B</Color>
            <Color x:Key="AccentEmerald">#10B981</Color>
            <Color x:Key="TextPrimary">#F8FAFC</Color>
            <Color x:Key="TextSecondary">#94A3B8</Color>
            <Color x:Key="BorderLight">#334155</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,16" Spacing="20">

            <Label Text="SETTINGS"
                   FontSize="12"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextSecondary}"
                   CharacterSpacing="1.5" />

            <!-- ── Server Connection ─────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Server Endpoint"
                           FontSize="15"
                           FontAttributes="Bold" />

                    <Label Text="PoRedoImage BFF API URL. For Android Emulator use 10.0.2.2:4000."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />

                    <Entry Text="{Binding ServerUrl}"
                           BackgroundColor="{StaticResource BgDark}"
                           TextColor="{StaticResource TextPrimary}"
                           HeightRequest="42" />

                    <Button Text="⚡ Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="40" />

                    <Label Text="{Binding ConnectionStatus}"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Guest Identity ────────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Guest Identity"
                           FontSize="15"
                           FontAttributes="Bold" />

                    <Label Text="Dev &amp; Guest sessions are isolated by Guest ID."
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Text="{Binding GuestId}"
                               BackgroundColor="{StaticResource BgDark}"
                               TextColor="{StaticResource TextPrimary}"
                               HeightRequest="42" />

                        <Button Grid.Column="1"
                                Text="🎲 New"
                                Command="{Binding GenerateNewGuestIdCommand}"
                                BackgroundColor="{StaticResource BgCardHover}"
                                TextColor="{StaticResource TextPrimary}"
                                HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Art Transformation Default ────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Art Transformation Style"
                           FontSize="15"
                           FontAttributes="Bold" />

                    <Picker ItemsSource="{Binding AvailableStyles}"
                            SelectedItem="{Binding SelectedStyle}"
                            BackgroundColor="{StaticResource BgDark}"
                            TextColor="{StaticResource TextPrimary}"
                            Title="Choose default style"
                            TitleColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- ── Auto Save Option ──────────────────────────────── -->
            <Border BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderLight}"
                    StrokeShape="RoundRectangle 14"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Auto-Save Results"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <Label Text="Save all generated images to device storage"
                               FontSize="11"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            IsToggled="{Binding AutoSaveToGallery}"
                            OnColor="{StaticResource Primary}" />
                </Grid>
            </Border>

            <!-- ── Save Button ───────────────────────────────────── -->
            <Button Text="💾 Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="{StaticResource AccentEmerald}"
                    TextColor="White"
                    HeightRequest="44" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

