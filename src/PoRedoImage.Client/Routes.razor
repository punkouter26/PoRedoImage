<Router AppAssembly="typeof(PoRedoImage.Client._Imports).Assembly"
        NotFoundPage="typeof(PoRedoImage.Client.Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(PoRedoImage.Client.Layout.MainLayout)">
            <NotAuthorized>
                <PoRedoImage.Client.Shared.RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
