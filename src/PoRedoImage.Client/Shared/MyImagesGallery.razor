@* The strip on each feature page is for PICKING a saved photo: tap to use, zoom to look.
   Deleting (with undo) used to live here too, duplicating the Gallery page's delete with a
   second, different confirm/undo flow. Managing images is the Gallery page's job. *@
@inject HttpClient Http
@inject ImageSessionService SessionService
@inject IJSRuntime JSRuntime
@inject DialogService DialogService
@inject ILogger<MyImagesGallery> Logger

@if (_loading)
{
    <div class="gallery-bar gallery-bar--loading" aria-busy="true">
        <span class="gallery-bar__label"><i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span></span>
        <div class="gallery-bar__scroll" role="list" aria-label="Loading gallery">
            @for (int i = 0; i < 4; i++)
            {
                // Skeletons are placeholder thumbnails. role="listitem" satisfies axe's
                // aria-required-children check on the parent role="list"; aria-hidden keeps
                // a generic placeholder from polluting the accessibility tree (the parent
                // aria-busy="true" already announces the loading state).
                <div class="gallery-thumb gallery-thumb--skeleton shimmer-anim" role="listitem" aria-hidden="true"></div>
            }
        </div>
    </div>
}
else if (_images.Count > 0)
{
    <div class="gallery-bar">
        <span class="gallery-bar__label" title="Your saved originals and results">
            <i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span>
            <span class="gallery-bar__count">@_images.Count</span>
        </span>
        <div class="gallery-bar__scroll" role="list" aria-label="Your saved images" aria-busy="false">
            @foreach (var img in _images)
            {
                var item = img;
                <div class="gallery-thumb-wrap" role="listitem">
                    <button class="gallery-thumb @KindClass(item.Kind)"
                            title="@item.FileName (@item.Kind.ToString()) — click to use"
                            @onclick="@(() => SelectImage(item))">
                        <img src="@item.ImageUrl" alt="@item.FileName" loading="lazy" decoding="async" fetchpriority="low" />
                        <span class="gallery-thumb__badge" aria-label="@item.Kind"><i class="bi @KindIcon(item.Kind)" aria-hidden="true"></i></span>
                    </button>
                    <button class="gallery-thumb__zoom" title="View full size"
                            aria-label="@($"View {item.FileName} full size")"
                            @onclick="@(() => OpenLightboxAsync(item))">
                        <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
        <button class="gallery-bar__refresh" @onclick="LoadAsync" title="Refresh gallery" aria-label="Refresh gallery">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
}
else if (_loadError is not null)
{
    @* NOT the same thing as an empty gallery, and it used to render as one. Every failure
       path — 401, 500, a storage account that is down, an 8-second timeout — collapsed to
       `_images = []` and the user was told "No images yet", i.e. that their saved work did
       not exist. A gallery that cannot be reached has to say so; silently reporting absence
       as emptiness is the degradation this project forbids. *@
    <div class="gallery-bar gallery-bar--error" role="status">
        <span class="gallery-bar__label"><i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span></span>
        <div class="gallery-bar__empty-hint gallery-bar__empty-hint--error">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
            <span>@_loadError</span>
        </div>
        <button class="gallery-bar__refresh" @onclick="LoadAsync" title="Retry loading gallery" aria-label="Retry loading gallery">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
}
else
{
    // F8 mitigation: explicit empty state so the bar doesn't disappear silently.
    // Reached only when the request SUCCEEDED and returned nothing — see _loadError above.
    <div class="gallery-bar gallery-bar--empty" role="status">
        <span class="gallery-bar__label"><i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span></span>
        <div class="gallery-bar__empty-hint">
            <i class="bi bi-cloud-arrow-up me-1"></i>
            <span class="d-none d-sm-inline">No images yet — upload one to get started.</span>
            <span class="d-sm-none">No images yet.</span>
        </div>
        <button class="gallery-bar__refresh" @onclick="LoadAsync" title="Refresh gallery" aria-label="Refresh gallery">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
}

@code {
    [Parameter] public EventCallback<GalleryItem> OnImageSelected { get; set; }

    private List<GalleryItem> _images = [];
    private bool _loading = true;

    /// <summary>
    /// Why the gallery could not be read, or null when the read succeeded. Distinct from an empty
    /// <see cref="_images"/>: "you have no images" and "I could not find out" are different answers
    /// and only one of them is reassuring.
    /// </summary>
    private string? _loadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    public async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            // The gallery is a non-critical widget. Cap the wait so a slow/unreachable backend
            // (e.g. storage emulator down locally, which otherwise retries for ~37s before 500ing)
            // degrades quickly instead of shimmering skeletons indefinitely.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var httpResponse = await Http.GetAsync("/api/user-images", cts.Token);
            var contentType = httpResponse.Content.Headers.ContentType?.MediaType;
            if (!httpResponse.IsSuccessStatusCode || contentType != "application/json")
            {
                _images = [];
                _loadError = httpResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "Sign in to see your saved images."
                    : "Your gallery is unavailable right now — this isn't a sign your images are gone.";
                Logger.LogWarning(
                    "User image gallery returned {Status} ({ContentType})", httpResponse.StatusCode, contentType);
                return;
            }
            var result = await httpResponse.Content.ReadFromJsonAsync<List<GalleryItem>>(SharedJsonOptions.Default,cts.Token);
            _images = result ?? [];
        }
        catch (OperationCanceledException)
        {
            _images = [];
            _loadError = "Your gallery took too long to answer. Retry?";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load user image gallery");
            _images = [];
            _loadError = "Your gallery is unavailable right now — this isn't a sign your images are gone.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectImage(GalleryItem item)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(item.ImageUrl);
            SessionService.SetImage(null, item.ContentType, item.FileName, bytes);
            await OnImageSelected.InvokeAsync(item);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load gallery image {Id}", item.Id);
        }
    }

    /// <summary>
    /// Opens the full-size view as a real modal and acts on what the viewer chose.
    /// </summary>
    /// <remarks>
    /// Radzen owns the focus trap and the Escape key here; this method owns only the
    /// outcome. A dismissal returns null, which correctly does nothing.
    /// </remarks>
    private async Task OpenLightboxAsync(GalleryItem item)
    {
        // Snapshot the thumbnail first so the dialog's image morphs out of it (fx.js).
        await JSRuntime.InvokeVoidAsync("poFx.heroFrom", item.ImageUrl);
        var choice = await DialogService.OpenAsync<GalleryLightbox>(
            item.FileName,
            new Dictionary<string, object> { ["Item"] = item, ["IconClass"] = KindIcon(item.Kind) },
            new DialogOptions { CloseDialogOnOverlayClick = true, ShowClose = true, CssClass = "gallery-lightbox" });

        switch (choice as GalleryLightbox.LightboxResult?)
        {
            case GalleryLightbox.LightboxResult.Use:
                await SelectImage(item);
                break;
            case GalleryLightbox.LightboxResult.Download:
                await JSRuntime.InvokeAsync<bool>("downloadImage", item.ImageUrl, item.FileName);
                break;
        }
    }

    private static string KindClass(UserImageKind kind) => kind switch
    {
        UserImageKind.Regeneration => "gallery-thumb--regen",
        UserImageKind.Meme => "gallery-thumb--meme",
        UserImageKind.BulkVariation => "gallery-thumb--bulk",
        _ => "gallery-thumb--original"
    };

    /// <summary>
    /// Bootstrap-icon class for the kind badge. These were emoji, which render in whatever
    /// colour and weight the platform font supplies — unusable in a board built on one
    /// consistent stroke, and unreadable at the 16px badge size on several platforms.
    /// </summary>
    private static string KindIcon(UserImageKind kind) => kind switch
    {
        UserImageKind.Regeneration => "bi-palette2",
        UserImageKind.Meme => "bi-chat-square-text",
        UserImageKind.BulkVariation => "bi-grid-3x3",
        _ => "bi-camera"
    };

    public sealed record GalleryItem(
        string Id,
        string FileName,
        string ContentType,
        UserImageKind Kind,
        System.DateTimeOffset CreatedAt,
        long SizeBytes,
        string ImageUrl,
        System.Collections.Generic.IReadOnlyList<string> Tags);
}
