@inject HttpClient Http
@inject ImageSessionService SessionService
@inject NotificationService NotificationService
@inject PoRedoImage.Client.Services.UserImageSaveService UserImageSave
@inject IJSRuntime JSRuntime
@inject ILogger<MyImagesGallery> Logger

@if (_loading)
{
    <div class="gallery-bar gallery-bar--loading" aria-busy="true">
        <span class="gallery-bar__label"><i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span></span>
        <div class="gallery-bar__scroll" role="list" aria-label="Loading gallery">
            @for (int i = 0; i < 4; i++)
            {
                <div class="gallery-thumb gallery-thumb--skeleton shimmer-anim" aria-label="Loading..."></div>
            }
        </div>
    </div>
}
else if (_images.Count > 0)
{
    <div class="gallery-bar">
        <span class="gallery-bar__label" title="Your saved originals and results">
            <i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span>
            <span class="gallery-bar__count">@_images.Count</span>
        </span>
        <div class="gallery-bar__scroll" role="list" aria-label="Your saved images" aria-busy="false">
            @foreach (var img in _images)
            {
                var item = img;
                <div class="gallery-thumb-wrap" role="listitem">
                    <button class="gallery-thumb @KindClass(item.Kind)"
                            title="@item.FileName (@item.Kind.ToString()) — click to use"
                            @onclick="@(() => SelectImage(item))">
                        <img src="@item.ImageUrl" alt="@item.FileName" loading="lazy" />
                        <span class="gallery-thumb__badge" aria-label="@item.Kind"><i class="bi @KindIcon(item.Kind)" aria-hidden="true"></i></span>
                    </button>
                    <button class="gallery-thumb__zoom" title="View full size"
                            aria-label="@($"View {item.FileName} full size")"
                            @onclick="@(() => _lightbox = item)">
                        <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                    </button>
                    <button class="gallery-thumb__delete" title="Delete from My Images"
                            aria-label="@($"Delete {item.FileName}")"
                            disabled="@(_deletingId == item.Id)"
                            @onclick="@(() => DeleteAsync(item))">
                        <i class="bi @(_deletingId == item.Id ? "bi-hourglass" : "bi-x-lg")" aria-hidden="true"></i>
                    </button>
                </div>
            }
        </div>
        <button class="gallery-bar__refresh" @onclick="LoadAsync" title="Refresh gallery" aria-label="Refresh gallery">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
}
else
{
    // F8 mitigation: explicit empty state so the bar doesn't disappear silently.
    // Most common cause: user signed in but Storage:ConnectionString is unset, or new user.
    <div class="gallery-bar gallery-bar--empty" role="status">
        <span class="gallery-bar__label"><i class="bi bi-images me-1"></i><span class="d-none d-sm-inline">My Images</span></span>
        <div class="gallery-bar__empty-hint">
            <i class="bi bi-cloud-arrow-up me-1"></i>
            <span class="d-none d-sm-inline">No images yet — upload one to get started.</span>
            <span class="d-sm-none">No images yet.</span>
        </div>
        <button class="gallery-bar__refresh" @onclick="LoadAsync" title="Refresh gallery" aria-label="Refresh gallery">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
}

@* ── Undo strip. Real undo, not a cosmetic one: the bytes are read before the DELETE
      goes out, so restoring re-saves the same image (under a new id). ───────────── *@
@if (_undo is not null)
{
    <div class="gallery-undo" role="status">
        <img class="gallery-undo__thumb" src="@_undo.PreviewUrl" alt="" />
        <span class="gallery-undo__text">Deleted <strong>@_undo.FileName</strong></span>
        <button class="gallery-undo__btn" @onclick="UndoDeleteAsync" disabled="@_restoring">
            <i class="bi @(_restoring ? "bi-hourglass" : "bi-arrow-counterclockwise") me-1"></i>Undo
        </button>
        <button class="gallery-undo__dismiss" @onclick="@(() => _undo = null)" aria-label="Dismiss">
            <i class="bi bi-x"></i>
        </button>
    </div>
}

@* ── Lightbox ─────────────────────────────────────────────────────────── *@
@if (_lightbox is not null)
{
    <div class="gallery-lightbox" role="dialog" aria-modal="true" aria-label="@_lightbox.FileName"
         @onclick="@(() => _lightbox = null)">
        @* stopPropagation so a click inside the panel doesn't dismiss it *@
        <div class="gallery-lightbox__panel" @onclick:stopPropagation="true">
            <img class="gallery-lightbox__img" src="@_lightbox.ImageUrl" alt="@_lightbox.FileName" />
            <div class="gallery-lightbox__meta">
                <span class="gallery-lightbox__name"><i class="bi @KindIcon(_lightbox.Kind) me-2" aria-hidden="true"></i>@_lightbox.FileName</span>
                <span class="gallery-lightbox__sub">
                    @_lightbox.Kind · @FormatSize(_lightbox.SizeBytes) · @_lightbox.CreatedAt.ToLocalTime().ToString("g")
                </span>
            </div>
            <div class="gallery-lightbox__actions">
                <button class="btn btn-sm btn-primary" @onclick="UseLightboxImage">
                    <i class="bi bi-check2 me-1"></i>Use this image
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="DownloadLightboxImage">
                    <i class="bi bi-download me-1"></i>Download
                </button>
            </div>
            <button class="gallery-lightbox__close" @onclick="@(() => _lightbox = null)" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<GalleryItem> OnImageSelected { get; set; }

    private List<GalleryItem> _images = [];
    private bool _loading = true;
    private GalleryItem? _lightbox;
    private string? _deletingId;
    private PendingUndo? _undo;
    private bool _restoring;

    /// <summary>A just-deleted image held in memory so <see cref="UndoDeleteAsync"/> can re-save it.</summary>
    private sealed record PendingUndo(GalleryItem Item, byte[] Bytes, string FileName, string PreviewUrl);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    public async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            // The gallery is a non-critical widget. Cap the wait so a slow/unreachable backend
            // (e.g. storage emulator down locally, which otherwise retries for ~37s before 500ing)
            // degrades quickly to the empty state instead of shimmering skeletons indefinitely.
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(8));
            var httpResponse = await Http.GetAsync("/api/user-images", cts.Token);
            var contentType = httpResponse.Content.Headers.ContentType?.MediaType;
            if (!httpResponse.IsSuccessStatusCode || contentType != "application/json")
            {
                _images = [];
                return;
            }
            var result = await httpResponse.Content.ReadFromJsonAsync<List<GalleryItem>>(SharedJsonOptions.Default,cts.Token);
            _images = result ?? [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load user image gallery");
            _images = [];
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectImage(GalleryItem item)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync(item.ImageUrl);
            SessionService.SetImage(null, item.ContentType, item.FileName, bytes);
            await OnImageSelected.InvokeAsync(item);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load gallery image {Id}", item.Id);
        }
    }

    private async Task DeleteAsync(GalleryItem item)
    {
        if (_deletingId is not null) return;
        _deletingId = item.Id;
        StateHasChanged();
        try
        {
            // Read the bytes BEFORE deleting — once the blob is gone the undo has nothing to
            // restore from. A failed read only costs the undo affordance, not the delete.
            byte[]? bytes = null;
            try { bytes = await Http.GetByteArrayAsync(item.ImageUrl); }
            catch (Exception ex) { Logger.LogDebug(ex, "Could not buffer {Id} for undo", item.Id); }

            var response = await Http.DeleteAsync($"/api/user-images/{item.Id}");
            if (!response.IsSuccessStatusCode)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Delete failed",
                    $"Server returned {(int)response.StatusCode}. The image is still in your gallery.",
                    duration: 6000);
                return;
            }

            _images.RemoveAll(i => i.Id == item.Id);
            _undo = bytes is null
                ? null
                : new PendingUndo(item, bytes, item.FileName,
                    $"data:{item.ContentType};base64,{Convert.ToBase64String(bytes)}");

            if (_undo is null)
                NotificationService.Notify(NotificationSeverity.Info, "Deleted",
                    $"{item.FileName} was removed.", duration: 3000);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to delete gallery image {Id}", item.Id);
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", ex.Message, duration: 6000);
        }
        finally
        {
            _deletingId = null;
            StateHasChanged();
        }
    }

    private async Task UndoDeleteAsync()
    {
        if (_undo is null || _restoring) return;
        _restoring = true;
        try
        {
            // Restoring mints a new id — the original row and blob are already gone. Route
            // originals and results to their own endpoints so the Kind badge survives.
            var savedId = _undo.Item.Kind == UserImageKind.Original
                ? await UserImageSave.SaveOriginalAsync(_undo.Bytes, _undo.Item.ContentType, _undo.FileName, _undo.Item.Tags)
                : await UserImageSave.SaveResultAsync(_undo.Bytes, _undo.Item.ContentType, _undo.Item.Kind, _undo.Item.Tags);

            if (savedId is null) return; // SaveXxxAsync already raised its own failure toast
            _undo = null;
            await LoadAsync();
        }
        finally
        {
            _restoring = false;
            StateHasChanged();
        }
    }

    private async Task UseLightboxImage()
    {
        var item = _lightbox;
        if (item is null) return;
        _lightbox = null;
        await SelectImage(item);
    }

    private async Task DownloadLightboxImage()
    {
        if (_lightbox is null) return;
        await JSRuntime.InvokeAsync<bool>("downloadImage", _lightbox.ImageUrl, _lightbox.FileName);
    }

    private static string FormatSize(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / 1024.0 / 1024.0:0.#} MB" : $"{bytes / 1024.0:0} KB";

    private static string KindClass(UserImageKind kind) => kind switch
    {
        UserImageKind.Regeneration => "gallery-thumb--regen",
        UserImageKind.Meme => "gallery-thumb--meme",
        UserImageKind.BulkVariation => "gallery-thumb--bulk",
        _ => "gallery-thumb--original"
    };

    /// <summary>
    /// Bootstrap-icon class for the kind badge. These were emoji, which render in whatever
    /// colour and weight the platform font supplies — unusable in a board built on one
    /// consistent stroke, and unreadable at the 16px badge size on several platforms.
    /// </summary>
    private static string KindIcon(UserImageKind kind) => kind switch
    {
        UserImageKind.Regeneration => "bi-palette2",
        UserImageKind.Meme => "bi-chat-square-text",
        UserImageKind.BulkVariation => "bi-grid-3x3",
        _ => "bi-camera"
    };

    public sealed record GalleryItem(
        string Id,
        string FileName,
        string ContentType,
        UserImageKind Kind,
        System.DateTimeOffset CreatedAt,
        long SizeBytes,
        string ImageUrl,
        System.Collections.Generic.IReadOnlyList<string> Tags);
}
