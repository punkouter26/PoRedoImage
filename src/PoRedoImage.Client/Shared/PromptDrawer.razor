@using Radzen
@using Radzen.Blazor
@implements IDisposable
@inject PoRedoImage.Client.Services.PromptHistoryService History

@* No wrapper class: .prompt-drawer__fab is position:fixed and the drawer positions
   itself, so .prompt-drawer-wrapper never needed — or had — a rule. *@
<div>
    @* Floating toggle (FAB). Bootstrap icons — consistent with the rest of the app. *@
    <button type="button"
            class="prompt-drawer__fab @(_isExpanded ? "prompt-drawer__fab--active" : "")"
            @onclick="ToggleDrawer"
            title="@(_isExpanded ? "Close prompts" : "Edit art-style prompts")">
        <i class="bi @(_isExpanded ? "bi-x-lg" : "bi-sliders")"></i>
        <span class="prompt-drawer__fab-label">Prompts</span>
        @if (!_isExpanded && _activePromptCount > 0)
        {
            <span class="prompt-drawer__fab-badge">@_activePromptCount</span>
        }
    </button>

    @if (_isExpanded)
    {
        <div class="prompt-drawer__backdrop" @onclick="ToggleDrawer"></div>
    }

    <aside class="prompt-drawer @(_isExpanded ? "prompt-drawer--open" : "")" aria-hidden="@(!_isExpanded)">
        <div class="prompt-drawer__header">
            <h3 class="prompt-drawer__title">
                <i class="bi bi-sliders me-2"></i>Art Style Prompts
            </h3>
            <span class="prompt-drawer__count">@_activePromptCount active</span>
            <button type="button" class="prompt-drawer__close" @onclick="ToggleDrawer" title="Close" aria-label="Close prompts">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="prompt-drawer__actions">
            <button type="button" class="flap-btn flap-btn--sm" @onclick="ResetDefaults" disabled="@IsSaving">
                <i class="bi bi-eraser"></i><span>Clear</span>
            </button>
            <button type="button" class="flap-btn flap-btn--sm" @onclick="() => OnLoadRequested.InvokeAsync()" disabled="@IsSaving">
                <i class="bi bi-cloud-download"></i><span>Load</span>
            </button>
            <button type="button" class="flap-btn flap-btn--primary flap-btn--sm" @onclick="() => OnSaveRequested.InvokeAsync()" disabled="@IsSaving">
                <i class="bi bi-cloud-upload"></i><span>Save</span>
            </button>
        </div>

        <div class="prompt-drawer__hint">
            <i class="bi bi-info-circle-fill me-1"></i>
            Use <code>&lt;PERSON&gt;</code> — replaced with an AI description of your image
        </div>

        @* ── Recents / pinned. Click fills the slot you last focused (or slot 1). ── *@
        @if (History.Entries.Count > 0)
        {
            <div class="prompt-history">
                <span class="prompt-history__label">
                    <i class="bi bi-clock-history me-1"></i>Recent
                    <span class="prompt-history__target">→ slot @(_targetSlot + 1)</span>
                </span>
                <div class="prompt-history__list">
                    @foreach (var entry in History.Entries)
                    {
                        var e = entry;
                        <div class="prompt-history__chip @(e.Pinned ? "prompt-history__chip--pinned" : "")">
                            <button type="button" class="prompt-history__use" title="@e.Text"
                                    @onclick="@(() => ApplyHistory(e.Text))">
                                @Preview(e.Text)
                            </button>
                            <button type="button" class="prompt-history__pin"
                                    title="@(e.Pinned ? "Unpin" : "Pin to the top")"
                                    aria-pressed="@e.Pinned"
                                    @onclick="@(() => History.TogglePinAsync(e.Text))">
                                <i class="bi @(e.Pinned ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                            <button type="button" class="prompt-history__drop"
                                    aria-label="Forget this prompt"
                                    title="Forget this prompt"
                                    @onclick="@(() => History.RemoveAsync(e.Text))">
                                <i class="bi bi-x" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="prompt-drawer__list">
            @for (int i = 0; i < _localPrompts.Length; i++)
            {
                var idx = i;
                <div class="prompt-drawer__item" @key="@($"{_resetKey}-{idx}")">
                    <div class="prompt-drawer__row">
                        <span class="prompt-drawer__num">@(idx + 1)</span>
                        @* data-autosize: grows to fit its text (see ux.js) so a long prompt does
                           not get its own scrollbar inside the drawer's scrolling list. *@
                        <textarea class="prompt-drawer__textarea"
                                  data-autosize
                                  rows="2"
                                  value="@_localPrompts[idx]"
                                  @onfocus="@(() => _targetSlot = idx)"
                                  @onblur="@(() => History.RememberAsync(_localPrompts[idx]))"
                                  @oninput="@(e => UpdatePrompt(idx, e.Value?.ToString() ?? string.Empty))"
                                  placeholder="@(idx < DefaultPrompts.All.Length ? DefaultPrompts.All[idx][..Math.Min(60, DefaultPrompts.All[idx].Length)] + "…" : "Enter an art style prompt…")" />
                        @if (idx < DefaultPrompts.All.Length
                            && !string.IsNullOrWhiteSpace(_localPrompts[idx])
                            && _localPrompts[idx] != DefaultPrompts.All[idx])
                        {
                            <button type="button" class="prompt-drawer__reset"
                                    aria-label="Reset to default"
                                    title="Reset to default"
                                    @onclick="@(() => ResetRow(idx))">
                                <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </aside>
</div>

@code {
    [Parameter] public string[] Prompts { get; set; } = DefaultPrompts.All;
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public EventCallback<string[]> OnPromptsChanged { get; set; }
    [Parameter] public EventCallback OnSaveRequested { get; set; }
    [Parameter] public EventCallback OnLoadRequested { get; set; }

    private bool _isExpanded;
    private string[] _localPrompts = DefaultPrompts.All.ToArray();
    private int _resetKey = 0;
    private int _targetSlot;
    private int _activePromptCount => _localPrompts.Count(p => !string.IsNullOrWhiteSpace(p));

    protected override async Task OnInitializedAsync()
    {
        History.OnChange += OnHistoryChanged;
        await History.LoadAsync();
    }

    public void Dispose() => History.OnChange -= OnHistoryChanged;

    private void OnHistoryChanged() => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (Prompts is not null && !Prompts.SequenceEqual(_localPrompts))
            _localPrompts = Prompts.ToArray();
    }

    private void ToggleDrawer()
    {
        _isExpanded = !_isExpanded;
    }

    /// <summary>Fills the slot the user last focused (slot 1 before any focus) with a recalled prompt.</summary>
    private async Task ApplyHistory(string text)
    {
        var slot = Math.Clamp(_targetSlot, 0, _localPrompts.Length - 1);
        _localPrompts[slot] = text;
        // The textarea is uncontrolled (value=, not @bind), so it only picks up an external
        // write when its @key changes — same mechanism ResetRow relies on.
        _resetKey++;
        await OnPromptsChanged.InvokeAsync(_localPrompts.ToArray());
        await History.RememberAsync(text);
        StateHasChanged();
    }

    /// <summary>Chip label: enough of the prompt to recognise it, not enough to wrap.</summary>
    private static string Preview(string text) =>
        text.Length <= 44 ? text : text[..43] + "…";

    private async Task UpdatePrompt(int index, string value)
    {
        _localPrompts[index] = value;
        await OnPromptsChanged.InvokeAsync(_localPrompts.ToArray());
    }

    private async Task ResetDefaults()
    {
        _localPrompts = new string[_localPrompts.Length];
        for (int i = 0; i < _localPrompts.Length; i++) _localPrompts[i] = string.Empty;
        _resetKey++;
        await OnPromptsChanged.InvokeAsync(_localPrompts.ToArray());
        StateHasChanged();
    }

    private async Task ResetRow(int index)
    {
        if (index < DefaultPrompts.All.Length)
        {
            _localPrompts[index] = DefaultPrompts.All[index];
            _resetKey++;
            await OnPromptsChanged.InvokeAsync(_localPrompts.ToArray());
            StateHasChanged();
        }
    }
}