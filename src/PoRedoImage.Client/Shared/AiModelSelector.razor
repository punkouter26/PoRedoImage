@using PoRedoImage.Client.Models
@inject IWebAssemblyHostEnvironment Env

@* AI Model Selector — Rule 14.
   RadzenDropDown with grouped items: Remote (Azure), Web Browser, Ollama (dev only).
   Native Radzen keyboard nav (type-ahead, arrow keys) and ARIA combobox semantics. *@
<div class="model-selector">
    <label class="model-selector__label" for="ai-model-select">
        <i class="bi bi-cpu me-1"></i>AI Model
    </label>
    <RadzenDropDown @bind-Value="_selectedModelId"
                    Data="@_allModels"
                    TextProperty="DisplayName"
                    ValueProperty="ModelId"
                    Change="@(async (object? v) => await HandleModelChange(v))"
                    Placeholder="Select a model…"
                    class="model-selector__select w-100"
                    Name="ai-model-select">
        <Template>
            @{
                var model = context as AiModelInfo;
                if (model is null) { return; }
            }
            <div class="model-selector__option">
                <span class="model-selector__option-name">@model.DisplayName</span>
                @if (!string.IsNullOrEmpty(model.Description))
                {
                    <span class="model-selector__option-desc">@model.Description</span>
                }
            </div>
        </Template>
    </RadzenDropDown>
    @if (_selectedModel is not null && !string.IsNullOrEmpty(_selectedModel.Description))
    {
        <div class="model-selector__hint">@_selectedModel.Description</div>
    }
</div>

@code {
    [Parameter] public EventCallback<string> OnModelSelected { get; set; }

    private string? _selectedModelId;
    private AiModelInfo? _selectedModel;
    private IReadOnlyList<AiModelInfo> _allModels = [];

    protected override void OnInitialized()
    {
        // Ollama (and any other dev-only models) are hidden outside Development.
        var isDev = Env.IsDevelopment();
        _allModels = AiModelCatalog.All
            .Where(m => !m.IsDevOnly || isDev)
            .ToList();

        // Default to the first model (e.g. GPT-4o).
        _selectedModel = _allModels.FirstOrDefault();
        _selectedModelId = _selectedModel?.ModelId;
    }

    private async Task HandleModelChange(object? value)
    {
        var id = value as string;
        _selectedModelId = id;
        _selectedModel = AiModelCatalog.Find(id);
        if (OnModelSelected.HasDelegate)
        {
            await OnModelSelected.InvokeAsync(id);
        }
    }
}
