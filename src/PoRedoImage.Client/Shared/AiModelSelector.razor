@using PoRedoImage.Client.Models
@inject IWebAssemblyHostEnvironment Env

@* AI Model Selector — Rule 14
   Native grouped dropdown: models are grouped under Remote (Azure), Web Browser (Local),
   and Ollama (Local Machine). Ollama appears in Development only. *@
<div class="model-selector">
    <label class="model-selector__label" for="ai-model-select">
        <i class="bi bi-cpu me-1"></i>AI Model
    </label>
    <div class="model-selector__dropdown-wrapper">
        <select id="ai-model-select" class="model-selector__select form-select"
                @bind="_selectedModelId" @bind:after="HandleModelChange">
            @foreach (var group in _groups)
            {
                <optgroup label="@group.Category.Label()">
                    @foreach (var m in group.Models)
                    {
                        <option value="@m.ModelId">@m.DisplayName</option>
                    }
                </optgroup>
            }
        </select>
    </div>
    @if (_selectedModel is not null && !string.IsNullOrEmpty(_selectedModel.Description))
    {
        <div class="model-selector__hint">@_selectedModel.Description</div>
    }
</div>

<style>
    .model-selector {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 220px;
    }
    .model-selector__label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .model-selector__dropdown-wrapper {
        position: relative;
    }
    .model-selector__select {
        font-size: 0.9rem;
    }
    .model-selector__hint {
        font-size: 0.7rem;
        color: #64748b;
        line-height: 1.3;
        padding-left: 0.15rem;
    }
</style>

@code {
    [Parameter] public EventCallback<string> OnModelSelected { get; set; }

    private string? _selectedModelId;
    private AiModelInfo? _selectedModel;
    private List<(AiModelCategory Category, List<AiModelInfo> Models)> _groups = new();

    protected override void OnInitialized()
    {
        // Ollama (and any other dev-only models) are hidden outside Development.
        var isDev = Env.IsDevelopment();

        _groups = AiModelCatalog.CategoryOrder
            .Select(cat => (Category: cat,
                Models: AiModelCatalog.All.Where(m => m.Category == cat && (!m.IsDevOnly || isDev)).ToList()))
            .Where(g => g.Models.Count > 0)
            .ToList();

        // Default to the first model in the first group (e.g. GPT-4o).
        _selectedModel = _groups.FirstOrDefault().Models?.FirstOrDefault();
        _selectedModelId = _selectedModel?.ModelId;
    }

    private async Task HandleModelChange()
    {
        _selectedModel = AiModelCatalog.Find(_selectedModelId);
        if (OnModelSelected.HasDelegate)
        {
            await OnModelSelected.InvokeAsync(_selectedModelId);
        }
    }
}
