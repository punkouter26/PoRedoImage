@namespace PoRedoImage.Client.Shared
@using PoRedoImage.Client.Diagnostics
@implements IDisposable
@inject ClientVitalsReporter Reporter

@* Renders nothing. Exists so the layout can start the vitals sample declaratively — the same
   pattern MockDataBanner uses — without turning MainLayout into a code-behind component. *@

@code {
    private readonly CancellationTokenSource _cts = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        // Deliberately not awaited: the sample takes several seconds to settle and must not hold
        // up rendering. The reporter swallows its own failures, so nothing can surface here.
        _ = Reporter.ReportOnceAsync(_cts.Token);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
