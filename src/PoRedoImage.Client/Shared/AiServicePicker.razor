@namespace PoRedoImage.Client.Shared
@using PoRedoImage.Client.LocalAi
@using PoRedoImage.Client.Models
@implements IDisposable
@inject LocalAiService LocalAi
@inject AiSelectionState Selection
@inject IWebAssemblyHostEnvironment HostEnv

@*
    One selector per capability — but only for the capabilities that actually offer a choice.

    Scene detail, Create audio and Generate image have exactly one entry in the catalog and used to
    render as `disabled` selects reading "Only provider configured".
    They still cost a label, a full-width control and a row of vertical rhythm each, and on the home
    page they owned the left rail on desktop and an entire screen above the feature list on mobile.
    A control that cannot be operated is not a control; it is a fact. Facts belong on one line.

    The categories are not interchangeable — Ollama and the browser models cannot generate images —
    so a single global picker could never be correct, which is why this is per-capability at all.
*@
<fieldset class="ai-picker">
    <legend class="ai-picker__legend">AI services</legend>

    @foreach (var capability in Choosable)
    {
        var options = AiServiceCatalog.OptionsFor(capability, _includeDevOnly);
        var selectId = $"ai-picker-{capability}";

        <div class="ai-picker__row">
            <label class="ai-picker__label" for="@selectId">@AiServiceCatalog.LabelFor(capability)</label>

            <select id="@selectId"
                    class="ai-picker__select"
                    value="@Selection.Get(capability)"
                    @onchange="@(e => OnSelected(capability, e.Value?.ToString()))">
                @foreach (var group in options.GroupBy(o => o.Category))
                {
                    <optgroup label="@group.Key">
                        @foreach (var option in group)
                        {
                            <option value="@option.Id">@option.DisplayName — @option.Hint</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
    }

    @if (Fixed.Count > 0)
    {
        @* The single-provider capabilities, stated rather than offered. Kept visible because
           WHICH model runs is still information the user is entitled to — it is the choosing
           that was fictional, not the fact. *@
        <details class="ai-picker__fixed">
            <summary class="ai-picker__fixed-summary">
                @Fixed.Count more @(Fixed.Count == 1 ? "capability has" : "capabilities have") one provider
            </summary>
            <ul class="ai-picker__fixed-list">
                @foreach (var capability in Fixed)
                {
                    var only = AiServiceCatalog.OptionsFor(capability, _includeDevOnly)[0];
                    <li class="ai-picker__fixed-item">
                        <span class="ai-picker__fixed-label">@AiServiceCatalog.LabelFor(capability)</span>
                        <span class="ai-picker__fixed-value">@only.DisplayName</span>
                    </li>
                }
            </ul>
        </details>
    }

    @if (ShowsBrowserModel)
    {
        <p class="ai-picker__device" role="status">
            @if (_browserUnsupported)
            {
                <span>
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                    This browser has no WebGPU adapter, so models run on the CPU — slow, but supported.
                </span>
            }
            else
            {
                <span>
                    <i class="bi bi-gpu-card me-1" aria-hidden="true"></i>
                    WebGPU ready@(_capabilities?.HasShaderF16 == true ? " (shader-f16)" : "")@(_capabilities?.AdapterDescription is { Length: > 0 } d ? $" — {d}" : "")
                </span>
            }
        </p>
    }
</fieldset>

@code {
    private DeviceCapabilities? _capabilities;
    private bool _browserUnsupported;

    // Dev-only providers (Ollama) need a service on the developer's own machine, so they are
    // offered in Development and withheld everywhere else. This is why Choosable/Fixed are instance
    // members rather than static: the split depends on the environment the client booted into.
    private bool _includeDevOnly;

    /// <summary>Capabilities with a real decision behind them — these get a select.</summary>
    private IReadOnlyList<AiCapability> Choosable { get; set; } = [];

    /// <summary>Capabilities with exactly one provider — stated, not offered.</summary>
    private IReadOnlyList<AiCapability> Fixed { get; set; } = [];

    // Only meaningful once a browser-executed model is actually chosen — showing GPU status while
    // every capability is remote would be noise.
    private bool ShowsBrowserModel =>
        AiServiceCatalog.All.Any(c => Selection.GetOption(c).ExecutesInBrowser);

    protected override async Task OnInitializedAsync()
    {
        _includeDevOnly = HostEnv.IsDevelopment();
        Choosable = AiServiceCatalog.All
            .Where(c => AiServiceCatalog.OptionsFor(c, _includeDevOnly).Count > 1).ToArray();
        Fixed = AiServiceCatalog.All
            .Where(c => AiServiceCatalog.OptionsFor(c, _includeDevOnly).Count == 1).ToArray();

        _capabilities = await LocalAi.GetCapabilitiesAsync();

        // Not a blocker: DtypeChain prunes to wasm-capable variants and execution continues on the
        // CPU. This only drives the warning text.
        _browserUnsupported = !_capabilities.HasWebGpu;

        // Seeds the Generate image default from the server's actually-configured provider, so the
        // dropdown shows the provider that will actually run rather than the catalog's fixed first
        // entry. Idempotent — a feature page may have already triggered this fetch.
        await Selection.EnsureInitializedAsync();

        Selection.OnChange += OnSelectionChanged;
    }

    private void OnSelected(AiCapability capability, string? providerId)
    {
        if (!string.IsNullOrEmpty(providerId))
        {
            Selection.Set(capability, providerId);
        }
    }

    private void OnSelectionChanged() => InvokeAsync(StateHasChanged);

    // Deliberately NOT IAsyncDisposable: LocalAiService is a DI-owned scoped service shared with
    // every other component in this scope. Disposing it here would tear down its workers for them
    // too. The container owns its lifetime. Only the event subscription is released.
    public void Dispose() => Selection.OnChange -= OnSelectionChanged;
}
