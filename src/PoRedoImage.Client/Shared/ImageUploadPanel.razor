@using Microsoft.AspNetCore.Components.Forms
@using PoRedoImage.Client.Models
@using PoRedoImage.Client.Shared
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* No tabindex, and no container-level Enter handler.

   The panel used to be `tabindex="0"` so that Enter anywhere in it submitted. That put a tab
   stop on a role="region" — a landmark, not a control — immediately before the file input it
   contains, so reaching the uploader by keyboard cost two stops for one control and the first
   of them did nothing visible. The shortcut it bought was undiscoverable (nothing said "press
   Enter") and every caller either renders this panel's own submit button or supplies one
   directly beneath it. *@
<div class="upload-panel @(IsSplit ? "upload-panel--split" : null)" role="region" aria-label="Image upload">

    @* Two columns, so a desktop can put the photo beside the options instead of above them
       (see .upload-panel--split). On a narrow screen they simply stack, as before. *@
    <div class="upload-panel__source">

    @* ── Camera ─────────────────────────────────────────────────────── *@
    @* Replaces the drop zone rather than sitting beside it: the two are alternative ways to
       answer the same question ("which photo?"), and showing a live camera above an empty
       drop target reads as two separate pending tasks. Rendered only where the hosting page
       wired OnImageIntake, because a capture travels the same path as a paste. *@
    @if (_cameraOpen)
    {
        <div class="camera" role="group" aria-label="Camera">
            <div class="camera__stage">
                @* muted + playsinline are required for an inline autoplaying preview on iOS.
                   The front lens is mirrored so moving left moves the preview left; capturePhoto
                   mirrors the captured frame to match. *@
                <video @ref="_video"
                       class="camera__video @(_facing == "user" ? "camera__video--mirrored" : null)"
                       autoplay muted playsinline
                       aria-label="Live camera preview"></video>
            </div>

            <div class="camera__controls">
                <button type="button" class="flap-btn flap-btn--sm" @onclick="CloseCameraAsync">
                    <i class="bi bi-x-lg me-1" aria-hidden="true"></i>Cancel
                </button>

                @if (_canFlip)
                {
                    <button type="button" class="flap-btn flap-btn--sm" @onclick="FlipCameraAsync"
                            aria-label="Switch camera">
                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Flip
                    </button>
                }

                <button type="button" class="flap-btn flap-btn--primary flap-btn--sm"
                        @onclick="CapturePhotoAsync" disabled="@_cameraBusy">
                    <i class="bi bi-camera-fill me-1" aria-hidden="true"></i>Capture
                </button>
            </div>
        </div>
    }
    else
    {
    @* Once a photo is loaded the zone shrinks to a one-line chip (Compact): the page already
       knows which photo it is working on, so the options and the action move up above the fold
       instead of sitting under a 320px preview. The whole chip is still the file input, so a
       click, a drop or a paste replaces it exactly as before. *@
    <div class="upload-panel__intake @(IsCompact ? "upload-panel__intake--compact" : null)">
    @* ── Drop Zone ──────────────────────────────────────────────────── *@
    <div class="drop-zone @(_isDragging ? "drop-zone--active" : "") @(ImagePreviewUrl != null ? "drop-zone--has-image" : "") @(IsCompact ? "drop-zone--compact" : null)"
         @ondragover:preventDefault
         @ondragover="@(() => _isDragging = true)"
         @ondragleave="@(() => _isDragging = false)"
         @ondrop:preventDefault
         @ondrop="HandleDrop">

        @if (ImagePreviewUrl != null)
        {
            <div class="drop-zone__preview">
                <img src="@ImagePreviewUrl" class="preview-image" alt="Selected image" />
                <div class="drop-zone__preview-overlay">
                    <span class="drop-zone__preview-hint">
                        <i class="bi bi-arrow-repeat me-1"></i>Replace image
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="drop-zone__empty">
                <div class="drop-zone__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                </div>
                <p class="drop-zone__title">
                    <span class="drop-zone__title--desktop">Drop your image here</span>
                    <span class="drop-zone__title--mobile">Tap to upload a photo</span>
                </p>
                <p class="drop-zone__sub drop-zone__sub--desktop">or <span class="drop-zone__browse">browse to upload</span></p>
                <p class="drop-zone__formats">JPG &amp; PNG &middot; up to 20 MB</p>
                <p class="drop-zone__paste drop-zone__sub--desktop">
                    <kbd>Ctrl</kbd>+<kbd>V</kbd> to paste a screenshot, or drop a file anywhere
                </p>
            </div>
        }

        <InputFile OnChange="@OnFileChange" class="drop-zone__input" accept=".jpg,.jpeg,.png"
                   aria-label="Upload an image (JPG or PNG, up to 20 MB)" />
    </div>

    @* Outside the drop zone: the InputFile overlay covers that whole area, so a button placed
       inside it would be unclickable. *@
    @if (OnImageIntake.HasDelegate && _cameraSupported)
    {
        <button type="button" class="upload-panel__camera-btn" @onclick="OpenCameraAsync" disabled="@_cameraBusy"
                aria-label="Take a photo with your camera">
            <i class="bi bi-camera" aria-hidden="true"></i><span class="upload-panel__camera-text">Camera</span>
        </button>
    }
    </div>
    }

    @* ── Error ─────────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(_cameraError))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
            <span>@_cameraError</span>
        </div>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mt-3">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <span>@ErrorMessage</span>
        </div>
    }
    </div>

    @if (ChildContent is not null || ShowProcessButton)
    {
    <div class="upload-panel__settings">

    @* The page's own options (style, caption mode, prompt…) sit between the photo and the
       action that consumes them, so you configure before you are asked to submit. *@
    @ChildContent

    @* ── Process Button ────────────────────────────────────────────── *@
    @* The one primary action. Below md it pins to the bottom of the viewport (.cta-bar) while
       the panel is on screen — this replaced a second, fixed copy of the same button that every
       page used to render for mobile. *@
    @if (ShowProcessButton)
    {
        <div class="cta-bar">
            <button class="flap-btn flap-btn--primary flap-btn--block" @onclick="OnProcessClicked" disabled="@(!CanProcess)">
                <i class="bi @ButtonIcon me-2"></i>@ButtonLabel
            </button>
            @if (!CanProcess && !string.IsNullOrEmpty(DisabledHint))
            {
                <p class="cta-bar__hint" role="status">@DisabledHint</p>
            }
        </div>
    }
    </div>
    }

</div>

@code {
    [Parameter] public bool ShowProcessButton { get; set; } = true;
    [Parameter] public string ButtonLabel { get; set; } = "Process Image";
    [Parameter] public string ButtonIcon { get; set; } = "bi-cpu";
    [Parameter] public string? ImagePreviewUrl { get; set; }
    [Parameter] public EventCallback<string?> ImagePreviewUrlChanged { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool CanProcess { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFileChange { get; set; }
    [Parameter] public EventCallback OnProcessClicked { get; set; }

    /// <summary>Page options rendered between the photo and the process button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Says why the process button is disabled. Shown only while it is.</summary>
    [Parameter] public string? DisabledHint { get; set; } = "Add a photo to enable this.";

    /// <summary>
    /// Shrink a loaded photo to a one-line chip. Off only on Studio, where choosing the photo is
    /// the whole screen's job and a large preview is the confirmation.
    /// </summary>
    [Parameter] public bool Compact { get; set; } = true;

    private bool IsCompact => Compact && ImagePreviewUrl != null;

    /// <summary>
    /// A feature page's panel: options and an action to lay out beside the photo. Studio and
    /// Bulk pass neither (their actions live elsewhere), so they keep the single column.
    /// </summary>
    private bool IsSplit => ChildContent is not null && ShowProcessButton;

    /// <summary>
    /// Raised when an image arrives by clipboard paste or a drop outside the drop zone.
    /// Leave unset to opt the hosting page out of paste/drop intake entirely.
    /// </summary>
    [Parameter] public EventCallback<IntakeImage> OnImageIntake { get; set; }

    private bool _isDragging;
    private DotNetObjectReference<ImageUploadPanel>? _selfRef;

    // ── Camera ──────────────────────────────────────────────────────────────
    // A capture is pushed through poUx's intake path, exactly like a paste or a drop, so it
    // arrives at the hosting page as an IntakeImage and needs no second handler. That is also
    // why the button is gated on OnImageIntake.HasDelegate: without a handler the photo would
    // be taken and then silently dropped.
    private ElementReference _video;
    private bool _cameraSupported = true;
    private bool _cameraOpen;
    private bool _cameraBusy;
    private string? _cameraError;
    private string _facing = "user";
    private bool _canFlip;
    private int _intakeId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OnImageIntake.HasDelegate) return;
        _selfRef = DotNetObjectReference.Create(this);
        try { _intakeId = await JSRuntime.InvokeAsync<int>("poUx.registerIntake", _selfRef); }
        catch (JSException) { /* helpers script unavailable — <InputFile> still works */ }

        // Hide the button rather than let it fail on click. A browser with no getUserMedia, or
        // a page served over plain http to something that is not localhost, can never capture.
        try
        {
            var availability = await JSRuntime.InvokeAsync<string>("poUx.cameraAvailable");
            _cameraSupported = availability == "ok";
            if (_cameraSupported) _canFlip = await JSRuntime.InvokeAsync<bool>("poUx.hasMultipleCameras");
            StateHasChanged();
        }
        catch (JSException) { _cameraSupported = false; }
    }

    private async Task OpenCameraAsync()
    {
        _cameraError = null;
        _cameraBusy = true;
        _cameraOpen = true;
        // Render first: startCamera needs the <video> element to exist before it can bind a
        // stream to it, and the element only exists once _cameraOpen has been through a render.
        StateHasChanged();
        await Task.Yield();

        try
        {
            var result = await JSRuntime.InvokeAsync<string>("poUx.startCamera", _video, _facing);
            if (result != "ok")
            {
                _cameraOpen = false;
                _cameraError = DescribeCameraFailure(result);
            }
        }
        catch (JSException)
        {
            _cameraOpen = false;
            _cameraError = "The camera could not be started.";
        }
        finally
        {
            _cameraBusy = false;
            StateHasChanged();
        }
    }

    private async Task FlipCameraAsync()
    {
        _cameraBusy = true;
        try
        {
            var result = await JSRuntime.InvokeAsync<string>("poUx.flipCamera", _video);
            if (result == "ok")
            {
                _facing = _facing == "user" ? "environment" : "user";
            }
            else
            {
                // The other lens failed, so the first one is already stopped — say so rather
                // than leaving a dead preview on screen.
                _cameraOpen = false;
                _cameraError = DescribeCameraFailure(result);
            }
        }
        catch (JSException) { _cameraError = "The camera could not be switched."; }
        finally { _cameraBusy = false; }
    }

    private async Task CapturePhotoAsync()
    {
        _cameraBusy = true;
        try
        {
            // capturePhoto stops the stream and pushes the frame into AcceptIntake itself, so a
            // successful capture needs nothing further here beyond closing the view.
            var result = await JSRuntime.InvokeAsync<string>("poUx.capturePhoto");
            if (result == "ok")
            {
                _cameraOpen = false;
            }
            else
            {
                _cameraError = result == "notready"
                    ? "The camera is still warming up — try again in a moment."
                    : "The photo could not be captured.";
            }
        }
        catch (JSException) { _cameraError = "The photo could not be captured."; }
        finally { _cameraBusy = false; }
    }

    private async Task CloseCameraAsync()
    {
        _cameraOpen = false;
        _cameraError = null;
        await StopCameraAsync();
    }

    private async Task StopCameraAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("poUx.stopCamera"); }
        catch (JSDisconnectedException) { /* page tearing down */ }
        catch (JSException) { }
    }

    /// <summary>
    /// Turns a poUx failure code into something the user can act on. Every branch names the
    /// remedy — a capture that fails silently reads as the button being broken.
    /// </summary>
    private static string DescribeCameraFailure(string code) => code switch
    {
        "denied" => "Camera access was blocked. Allow camera access for this site in your browser, then try again.",
        "notfound" => "No camera was found on this device.",
        "busy" => "The camera is already in use by another app.",
        "insecure" => "The camera needs a secure connection (https). Upload a file instead.",
        "unsupported" => "This browser cannot open a camera. Upload a file instead.",
        _ => "The camera could not be started.",
    };

    /// <summary>Callback target for <c>poUx.registerIntake</c>. Public only because JS invokes it.</summary>
    [JSInvokable]
    public Task AcceptIntake(IntakeImage payload) => OnImageIntake.InvokeAsync(payload);

    public async ValueTask DisposeAsync()
    {
        // Unconditional, and before the _selfRef guard: the hardware must be released even if
        // this panel never registered an intake ref.
        await StopCameraAsync();

        if (_selfRef is null) return;
        try { await JSRuntime.InvokeVoidAsync("poUx.unregisterIntake", _intakeId); }
        catch (JSDisconnectedException) { /* page tearing down */ }
        catch (JSException) { }
        _selfRef.Dispose();
    }

    private Task HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        // The InputFile overlay covers the drop area and captures files natively
        return Task.CompletedTask;
    }
}
