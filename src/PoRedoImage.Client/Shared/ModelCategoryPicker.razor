@namespace PoRedoImage.Client.Shared
@using PoRedoImage.Client.LocalAi
@inject LocalAiService LocalAi

@* The three model categories AGENT.MD describes. Until now the document claimed a selector the
   Studio page did not have; this is that selector. *@
<fieldset class="model-category">
    <legend class="model-category__legend">AI model</legend>

    <div class="model-category__options">
        @foreach (var option in Options)
        {
            @* Degraded, never disabled: without WebGPU the dtype chain prunes to wasm-capable
               variants and still runs, just slowly. Disabling the option would deny a supported
               configuration. *@
            var degraded = option.Category == ModelCategory.WebBrowser && _browserUnsupported;
            <label class="model-category__option @(Selected == option.Category ? "model-category__option--selected" : "") @(degraded ? "model-category__option--degraded" : "")">
                <input type="radio" name="model-category" value="@option.Category"
                       checked="@(Selected == option.Category)"
                       @onchange="@(() => SelectAsync(option.Category))" />
                <span class="model-category__name">
                    <i class="@option.Icon me-1" aria-hidden="true"></i>@option.Label
                </span>
                <span class="model-category__hint">@option.Hint</span>
            </label>
        }
    </div>

    @if (_capabilities is not null && Selected == ModelCategory.WebBrowser)
    {
        <p class="model-category__device" role="status">
            @if (_browserUnsupported)
            {
                <span>
                    <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
                    This browser has no WebGPU adapter, so models would run on the CPU — slow, but supported.
                </span>
            }
            else
            {
                <span>
                    <i class="bi bi-gpu-card me-1" aria-hidden="true"></i>
                    WebGPU ready@(_capabilities.HasShaderF16 ? " (shader-f16)" : "")@(_capabilities.AdapterDescription is { Length: > 0 } d ? $" — {d}" : "")
                </span>
            }
            <span class="d-block">
                @_visionSummary
            </span>
        </p>
    }
</fieldset>

@code {
    /// <summary>Where a model runs.</summary>
    public enum ModelCategory
    {
        /// <summary>Hosted APIs — Azure OpenAI, Gemini, HuggingFace.</summary>
        Remote = 0,

        /// <summary>In this browser, on a worker, via WebGPU/WebAssembly.</summary>
        WebBrowser = 1,

        /// <summary>A local Ollama service (development only).</summary>
        Ollama = 2,
    }

    [Parameter] public ModelCategory Selected { get; set; } = ModelCategory.Remote;
    [Parameter] public EventCallback<ModelCategory> SelectedChanged { get; set; }

    private DeviceCapabilities? _capabilities;
    private bool _browserUnsupported;
    private string _visionSummary = string.Empty;

    private static readonly (ModelCategory Category, string Label, string Hint, string Icon)[] Options =
    [
        (ModelCategory.Remote, "Remote", "Fastest, uses your API quota", "bi-cloud"),
        (ModelCategory.WebBrowser, "Web Browser", "Runs on your device, free", "bi-cpu"),
        (ModelCategory.Ollama, "Ollama", "Local service, dev only", "bi-hdd-network"),
    ];

    protected override async Task OnInitializedAsync()
    {
        _capabilities = await LocalAi.GetCapabilitiesAsync();

        // Not a blocker: DtypeChain prunes to wasm-capable variants and execution continues on the
        // CPU. This only drives the warning text.
        _browserUnsupported = !_capabilities.HasWebGpu;

        var vision = LocalModelRegistry.DefaultFor(LocalCapability.Vision);
        if (vision is not null)
        {
            var chain = DtypeChain.Create(vision, _capabilities);
            _visionSummary =
                $"{vision.DisplayName} · ~{vision.ApproxDownloadMb} MB first run · {chain}";
        }
    }

    private async Task SelectAsync(ModelCategory category)
    {
        Selected = category;
        await SelectedChanged.InvokeAsync(category);
    }

    // Deliberately NOT IAsyncDisposable: LocalAiService is a DI-owned scoped service shared with
    // every other component in this scope. Disposing it here would tear down its workers for them
    // too the moment this picker is removed from the render tree. The container owns its lifetime.
}
