@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        @{
            var name = context.User.Identity?.Name ?? string.Empty;
            // GUEST users have a name like "GUEST35367543" — display "GUEST LOGGED IN" per spec.
            // Regular users display their email address if available, else name.
            var isGuest = name.StartsWith("GUEST", StringComparison.OrdinalIgnoreCase);
            var email = context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? name;
            var displayLabel = isGuest ? $"GUEST LOGGED IN" : email;
        }
        <div class="d-flex align-items-center gap-2 ms-3">
            <span class="app-nav__user text-truncate" title="@displayLabel">
                <i class="bi bi-person-circle me-1"></i>@displayLabel
            </span>
            @* aria-label is required, not decorative: below the sm breakpoint .d-sm-inline hides the
               text and the link collapses to a bare icon with no accessible name (axe link-name). *@
            <a href="/logout" class="app-nav__link" aria-label="Sign out"
               @onclick="SignOutAsync" @onclick:preventDefault="true">
                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i><span class="d-none d-sm-inline">Sign out</span>
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/login" class="app-nav__link ms-3">
            <i class="bi bi-person me-1"></i>Sign in
        </a>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Clear the persisted GUEST identity from LocalStorage before signing out, otherwise the
    // /login page's auto-restore re-authenticates the user as GUEST immediately after /logout
    // clears the auth cookie. forceLoad ensures the server /logout endpoint actually runs.
    private async Task SignOutAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("poRedoImageGuest.clearGuestId");
        }
        catch (JSException)
        {
            // Non-fatal: proceed with sign-out even if LocalStorage is unavailable.
        }
        NavigationManager.NavigateTo("/logout", forceLoad: true);
    }
}
