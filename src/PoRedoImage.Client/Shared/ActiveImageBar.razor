@implements IDisposable
@inject ImageSessionService SessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (SessionService.HasImage)
{
    <div class="active-image-bar" role="region" aria-label="Active image bar">
        <div class="container-fluid active-image-bar__inner">
            <div class="active-image-bar__thumb-wrap">
                <img src="@SessionService.PreviewUrl" class="active-image-bar__thumb" alt="Active image" />
            </div>
            <span class="active-image-bar__label">
                <i class="bi bi-images me-1 d-none d-sm-inline" aria-hidden="true"></i>
                <span class="active-image-bar__filename">@(SessionService.FileName ?? "Active Image")</span>
            </span>
            <div class="active-image-bar__actions">
                @* #4 — Deep-link back to the last feature the user was working on. *@
                @if (!string.IsNullOrEmpty(SessionService.LastVisitedFeatureRoute)
                     && !NavigationManager.Uri.Contains(SessionService.LastVisitedFeatureRoute, StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@SessionService.LastVisitedFeatureRoute"
                       class="active-image-bar__btn active-image-bar__btn--resume"
                       title="Return to @SessionService.LastVisitedFeatureRoute">
                        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
                        <span class="ms-1 d-none d-sm-inline">Back</span>
                    </a>
                }
                <span class="active-image-bar__try d-none d-md-inline">Also try:</span>
                @foreach (var (href, icon, label) in _features)
                {
                    if (!NavigationManager.Uri.Contains("/" + href, StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@href" class="active-image-bar__btn">
                            <i class="bi @icon" aria-hidden="true"></i><span class="ms-1 d-none d-sm-inline">@label</span>
                        </a>
                    }
                }
                <button class="active-image-bar__clear" @onclick="SessionService.Clear" title="Clear active image" aria-label="Clear active image">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string href, string icon, string label)[] _features =
    [
        ("image-regeneration", "bi-palette2", "Regen"),
        ("meme-generation",    "bi-emoji-laughing", "Meme"),
        ("bulk-generate",      "bi-collection", "Bulk"),
    ];

    protected override void OnInitialized() => SessionService.OnChange += OnSessionChanged;
    public void Dispose()              => SessionService.OnChange -= OnSessionChanged;

    private void OnSessionChanged()
    {
        StateHasChanged();
        _ = PersistSessionAsync();
    }

    private async Task PersistSessionAsync()
    {
        try
        {
            if (SessionService.HasImage)
                await JSRuntime.InvokeVoidAsync("imageSession.save",
                    SessionService.PreviewUrl, SessionService.FileName, SessionService.ContentType);
            else
                await JSRuntime.InvokeVoidAsync("imageSession.clear");
        }
        catch { /* sessionStorage unavailable — non-critical */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || SessionService.HasImage) return;
        try
        {
            // Restore active image from sessionStorage after a full-page navigation (new circuit)
            var stored = await JSRuntime.InvokeAsync<ImageSessionState?>("imageSession.load");
            if (stored is { DataUrl: not null, FileName: not null, ContentType: not null })
            {
                SessionService.SetImage(stored.DataUrl, stored.ContentType, stored.FileName);
                StateHasChanged();
            }
        }
        catch { /* non-critical */ }
    }

    private sealed record ImageSessionState(string? DataUrl, string? FileName, string? ContentType);
}
