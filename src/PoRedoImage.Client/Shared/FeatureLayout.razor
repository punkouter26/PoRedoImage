@using Microsoft.AspNetCore.Components

<div class="feature-page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="feature-page-icon" aria-hidden="true"><i class="bi @IconClass"></i></span>
        <div>
            @* The service name sits in flap cells, so arriving on a feature page reads as the
               board turning over to that destination. *@
            <h1 class="feature-page-title"><FlapText Text="@Title" /></h1>
            <p class="feature-page-desc">@Description
                @if (!string.IsNullOrEmpty(ModelBadge))
                {
                    <span class="badge bg-success ms-2">@ModelBadge</span>
                }
            </p>
        </div>
    </div>
    @if (Steps?.Length > 0)
    {
        <div class="feature-how-it-works mt-3">
            @for (int i = 0; i < Steps.Length; i++)
            {
                var step = Steps[i];
                <span class="feature-how-it-works__step"><i class="bi @step.IconClass me-1"></i>@step.Label</span>
                @if (i < Steps.Length - 1)
                {
                    <i class="bi bi-arrow-right feature-how-it-works__arrow"></i>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string IconClass { get; set; } = "bi-cpu";
    [Parameter] public string Title { get; set; } = "Feature";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? ModelBadge { get; set; }
    [Parameter] public (string IconClass, string Label)[]? Steps { get; set; }
}