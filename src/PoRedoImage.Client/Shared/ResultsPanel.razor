@using PoRedoImage.Client.Models
@* ── Shared compare + actions base for both result panels ─────────────── *@
@inject ImageSessionService SessionService
@inject NavigationManager Nav
@inject NotificationService NotificationService

<div class="split-compare-wrapper mb-4">
    @* Side by side is the only comparison mode. The wipe slider and the 2x loupe, and the
       three-button toggle that switched between them, were removed at the user's request. *@
    <div class="split-compare">
        <div class="split-compare__side overflow-hidden">
            <span class="split-compare__label">Original</span>
            <img src="@ImagePreviewUrl" class="split-compare__img" alt="Original"
                 onload="this.classList.add('loaded')" />
        </div>
        <div class="split-compare__divider">
            <div class="split-compare__divider-line"></div>
            <div class="split-compare__divider-pill"><i class="bi @DividerIcon"></i></div>
        </div>
        <div class="split-compare__side overflow-hidden">
            <span class="split-compare__label">@RightLabel</span>
            @RightSide
        </div>
    </div>
</div>

@if (CaptionContent != null)
{
    @CaptionContent
}

@* ── One toolbar ─────────────────────────────────────────────────────
   Everything you can do with a result, on one row. This was five stacked blocks — the
   page's save button, an "Evolve & Remix" card, a "Use this result as input for" row and
   a separate "Download Original" row — each with its own label and frame. Send-to and
   Remix are menus now: they are choices of destination, not things to read.

   <details> rather than a JS dropdown: it is keyboard-operable and announces its expanded
   state natively, and closing on outside-click is the one thing it lacks (poUx handles it). *@
<div class="results-actions mb-4">
    @PrimaryAction
    <button class="flap-btn flap-btn--sm" @onclick="OnDownloadOriginal">
        <i class="bi bi-download me-1"></i>Original
    </button>

    @if (ResultImageUrl is not null)
    {
        <details class="menu">
            <summary class="flap-btn flap-btn--sm"><i class="bi bi-arrow-right-circle me-1" aria-hidden="true"></i>Send to<i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
            <div class="menu__list" role="group" aria-label="Use this result as input for">
                @foreach (var feature in FeatureCatalog.Except(_currentRoute))
                {
                    var target = feature;
                    <button type="button" class="menu__item" @onclick="@(() => SendResultTo(target))" title="@target.Description">
                        <i class="bi @target.Icon me-2" aria-hidden="true"></i>@target.Title
                    </button>
                }
            </div>
        </details>

        @* Remix = send this result back to Regeneration with a style appended. The styles are
           the Style Recipe catalog, so the menu and the recipe picker cannot drift into two
           different lists of "cinematic" the way the hard-coded modifiers here once did. *@
        <details class="menu">
            <summary class="flap-btn flap-btn--sm"><i class="bi bi-magic me-1" aria-hidden="true"></i>Remix<i class="bi bi-chevron-down" aria-hidden="true"></i></summary>
            <div class="menu__list menu__list--scroll" role="group" aria-label="Remix in a style">
                @foreach (var recipe in StyleRecipeCatalog.All)
                {
                    var r = recipe;
                    <button type="button" class="menu__item" @onclick="@(() => Remix(r))" title="@r.Description">
                        <i class="bi @r.Icon me-2" aria-hidden="true"></i>@r.Title
                    </button>
                }
            </div>
        </details>
    }

    @if (ElapsedSeconds is { } secs)
    {
        <span class="results-actions__meta" title="Total processing time"><i class="bi bi-clock me-1" aria-hidden="true"></i>@secs.ToString("F1")s</span>
    }
</div>

@if (FooterContent != null)
{
    @FooterContent
}

@code {
    [Parameter] public string? ImagePreviewUrl { get; set; }
    [Parameter, EditorRequired] public string RightLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DividerIcon { get; set; } = string.Empty;
    [Parameter, EditorRequired] public RenderFragment RightSide { get; set; } = default!;

    /// <summary>
    /// The generated image as a <c>data:</c> URI. Drives result-chaining and the remix row —
    /// both are hidden when it is null, which is also the "generation produced nothing" case.
    /// </summary>
    [Parameter] public string? ResultImageUrl { get; set; }

    /// <summary>Suggested file name for the chained session image.</summary>
    [Parameter] public string ResultFileName { get; set; } = "poredoimage-result.png";

    [Parameter] public RenderFragment? CaptionContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment PrimaryAction { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnDownloadOriginal { get; set; }

    /// <summary>End-to-end processing time, shown once at the end of the toolbar.</summary>
    [Parameter] public double? ElapsedSeconds { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    private string _currentRoute = string.Empty;

    protected override void OnInitialized() => _currentRoute = new Uri(Nav.Uri).AbsolutePath;

    private void Remix(StyleRecipe recipe)
    {
        var existing = SessionService.LastFinalPrompt ?? "";
        SessionService.StagePrompt(string.IsNullOrWhiteSpace(existing)
            ? recipe.PromptSnippet
            : $"{existing}, {recipe.PromptSnippet}");
        if (ResultImageUrl != null)
            SessionService.SetImage(ResultImageUrl, ContentTypeOf(ResultImageUrl), ResultFileName);
        NotificationService.Notify(NotificationSeverity.Info, $"Remix: {recipe.Title}",
            "Opening Regeneration with this result and the style staged.", duration: 3000);
        Nav.NavigateTo("/image-regeneration");
    }

    /// <summary>
    /// Makes the generated image the session's active image and navigates to
    /// <paramref name="feature"/>, so a transformation can be chained onto its own output.
    /// </summary>
    private void SendResultTo(FeatureLink feature)
    {
        if (ResultImageUrl is null) return;

        // SetImage parses the bytes back out of the data URI itself, so only one copy is held.
        SessionService.SetImage(ResultImageUrl, ContentTypeOf(ResultImageUrl), ResultFileName);
        NotificationService.Notify(NotificationSeverity.Info, "Result carried over",
            $"Opening {feature.Title} with this image as the input.", duration: 3000);
        Nav.NavigateTo(feature.Route);
    }

    /// <summary>Reads the media type out of a <c>data:&lt;type&gt;;base64,…</c> URI.</summary>
    private static string ContentTypeOf(string dataUri)
    {
        const string prefix = "data:";
        if (!dataUri.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) return "image/png";
        var semi = dataUri.IndexOf(';');
        return semi > prefix.Length ? dataUri[prefix.Length..semi] : "image/png";
    }
}
