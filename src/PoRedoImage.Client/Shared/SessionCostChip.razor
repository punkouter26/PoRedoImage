@* Running session cost estimate across all AI services. Hidden until pricing loads
   AND at least one AI service operation has occurred. *@
@implements IDisposable
@inject PoRedoImage.Client.Services.SessionCostService Cost

@if (Cost.Pricing is not null && Cost.TotalOperations > 0)
{
    <div class="session-cost-wrapper">
        <button type="button" class="session-cost btn p-0 border-0 text-start"
                title="@BuildTooltip()"
                @onclick="ToggleBreakdown"
                aria-expanded="@_showBreakdown"
                aria-label="@($"Estimated session AI cost {Cost.Format(Cost.EstimatedTotal)}")">
            <i class="bi bi-receipt me-1" aria-hidden="true"></i>
            <span class="session-cost__value">
                <FlapText Text="@Cost.Format(Cost.EstimatedTotal)" Class="flapstrip--sm" />
            </span>
            <span class="session-cost__meta">· @Cost.TotalOperations AI @(Cost.TotalOperations == 1 ? "op" : "ops")</span>
        </button>

        @if (_showBreakdown)
        {
            <div class="session-cost-popover" role="dialog" aria-label="Session AI Cost Breakdown">
                <div class="session-cost-popover__header d-flex justify-content-between align-items-center">
                    <span class="fw-bold"><i class="bi bi-cpu me-1 text-warning"></i>SESSION AI BREAKDOWN</span>
                    <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Close" @onclick="ToggleBreakdown"></button>
                </div>
                <div class="session-cost-popover__body">
                    <table class="table table-sm table-dark table-borderless mb-2">
                        <tbody>
                            @foreach (var item in Cost.GetBreakdown())
                            {
                                <tr>
                                    <td><i class="bi @item.IconClass me-1 text-info"></i>@item.Name</td>
                                    <td class="text-end text-muted">@item.Count &times; @Cost.Format(item.UnitPriceUsd)</td>
                                    <td class="text-end fw-bold text-amber">@Cost.Format(item.SubtotalUsd)</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-top border-secondary">
                                <td class="fw-bold">Total Estimated</td>
                                <td class="text-end text-muted">@Cost.TotalOperations ops</td>
                                <td class="text-end fw-bold text-amber">@Cost.Format(Cost.EstimatedTotal)</td>
                            </tr>
                        </tfoot>
                    </table>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <small class="text-muted fst-italic" style="font-size: 0.65rem;">Indicative estimate · not billing</small>
                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="ResetCost">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private bool _showBreakdown;

    protected override async Task OnInitializedAsync()
    {
        Cost.OnChange += OnCostChanged;
        await Cost.EnsureLoadedAsync();
    }

    public void Dispose() => Cost.OnChange -= OnCostChanged;

    private void OnCostChanged() => InvokeAsync(StateHasChanged);

    private void ToggleBreakdown() => _showBreakdown = !_showBreakdown;

    private void ResetCost()
    {
        Cost.Reset();
        _showBreakdown = false;
    }

    private string BuildTooltip()
    {
        var items = Cost.GetBreakdown();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Estimated AI Spend: {Cost.Format(Cost.EstimatedTotal)} ({Cost.TotalOperations} ops)");
        foreach (var item in items)
        {
            sb.AppendLine($"• {item.Name} ({item.Count}): {Cost.Format(item.SubtotalUsd)}");
        }
        sb.Append("Click to view breakdown. Indicative estimate from configuration.");
        return sb.ToString();
    }
}

