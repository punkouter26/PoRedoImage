@inherits LayoutComponentBase
@inject IWebAssemblyHostEnvironment Env

<MockDataBanner />

@* Skip link. The rail now carries five feature links plus the brand and the account
   controls, so a keyboard or screen-reader user met seven stops before the page's own
   first control on every single navigation. It is visually hidden until focused. *@
<a class="skip-link" href="#main-content">Skip to main content</a>

<header class="app-header">
    @* A plain div, not a <nav>: NavMenu inside it IS the navigation landmark, and wrapping
       it in a second one gave assistive tech two nested "navigation" regions to choose
       between when only one of them held links. *@
    <div class="app-nav container-fluid">
        @* The wordmark is painted on real flap cells — the board naming itself. The mark beside
           it is a single flap mid-turn, which is this product's whole idea in one glyph. *@
        <a class="app-nav__brand" href="/" aria-label="PoRedoImage home">
            <span class="app-nav__brand-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <rect x="1.5" y="1.5" width="13" height="13" stroke="currentColor" stroke-width="1.4" />
                    <path d="M1.5 8h13" stroke="currentColor" stroke-width="1.4" />
                    <path d="M2.6 8 8 4.4 13.4 8" fill="currentColor" />
                </svg>
            </span>
            <FlapText Text="PoRedoImage" />
        </a>
        <NavMenu />
        <LoginDisplay />
    </div>
</header>
<ImageSessionPersistence />

@*
    The shell adds NO padding of its own. It used to carry `px-4 py-4` plus a
    `.content { padding-top: 1rem }` rule, and every page then set its own
    `container py-4` on top — three independent decisions stacked into ~3.5rem of
    dead space above every screen's first control. Spacing now belongs to whatever
    the page puts here: FeatureShell for the feature pages, the page itself for the
    Studio board and /diag.
*@
<main class="app-main" id="main-content" tabindex="-1">
    <article class="content">
        @Body
    </article>
</main>


<footer class="app-footer">
    <div class="app-footer__inner container-fluid">
        <span class="app-footer__center">PoRedoImage &copy; @DateTime.UtcNow.Year</span>
        <SessionCostChip />
        <span class="app-footer__env">
            @if (!Env.IsProduction())
            {
                <span class="app-footer__env-badge" title="Running in Development mode — Key Vault and real auth are bypassed">@Env.Environment.ToUpperInvariant()</span>
            }
        </span>
    </div>
</footer>

@* Radzen hosts. Notification was already here; Dialog is new and is what gives the
   gallery lightbox a focus trap, an Escape handler and focus restore — see
   Shared/GalleryLightbox.razor for why that is worth a dependency. *@
<RadzenNotification />
<RadzenDialog />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-hidden="true">&#215;</span>
</div>
