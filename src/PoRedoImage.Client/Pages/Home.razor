@page "/"
@inject HttpClient Http
@inject NotificationService NotificationService

<PageTitle>PoRedoImage — Image Reimagined</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-4">
    <RadzenText TextStyle="TextStyle.H3">PoRedoImage</RadzenText>
    <RadzenText TextStyle="TextStyle.Subtitle1">Upload an image to analyze, regenerate, or create a meme.</RadzenText>

    <RadzenCard>
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6">Upload Image</RadzenText>

            <InputFile OnChange="OnFileSelected" accept="image/png,image/jpeg" class="form-control" />

            @if (_previewUrl is not null)
            {
                <img src="@_previewUrl" alt="Preview" style="display:block;max-width:100%;max-height:300px;width:auto;height:auto;border-radius:8px;margin:0 auto;" />
            }

            <RadzenRow Gap="0.5rem">
                <RadzenColumn>
                    <RadzenSelectBar @bind-Value="_mode" TValue="ProcessingMode">
                        <Items>
                            <RadzenSelectBarItem Text="Regenerate" Value="ProcessingMode.ImageRegeneration" />
                            <RadzenSelectBarItem Text="Meme" Value="ProcessingMode.MemeGeneration" />
                        </Items>
                    </RadzenSelectBar>
                </RadzenColumn>
                <RadzenColumn>
                    <RadzenNumeric TValue="int" @bind-Value="_descLength" Min="200" Max="500" Placeholder="Description words (200-500)" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenButton Text="Analyze &amp; Generate" Icon="auto_awesome"
                          Click="AnalyzeAsync" IsBusy="_loading" BusyText="Processing..."
                          Disabled="@(_imageData is null)" />
        </RadzenStack>
    </RadzenCard>

    @if (_result is not null)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.H6">Results</RadzenText>
            <RadzenStack Gap="0.5rem">
                @if (!string.IsNullOrEmpty(_result.Description))
                {
                    <RadzenText><strong>Description:</strong> @_result.Description</RadzenText>
                }
                @if (_result.Tags.Count > 0)
                {
                    <RadzenText><strong>Tags:</strong> @string.Join(", ", _result.Tags)</RadzenText>
                }
                @if (_result.RegeneratedImageData is not null)
                {
                    <img src="data:@_result.RegeneratedImageContentType;base64,@_result.RegeneratedImageData"
                         alt="Generated image" style="max-width:100%;border-radius:8px;" />
                }
                @if (_result.MemeImageData is not null)
                {
                    <img src="data:image/png;base64,@_result.MemeImageData"
                         alt="Meme" style="max-width:100%;border-radius:8px;" />
                    <RadzenText>@_result.MemeCaption</RadzenText>
                }
                <RadzenText TextStyle="TextStyle.Caption">
                    Analysis: @_result.Metrics.ImageAnalysisTimeMs ms |
                    Generation: @_result.Metrics.ImageRegenerationTimeMs ms |
                    Total: @_result.Metrics.TotalProcessingTimeMs ms
                </RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>

@code {
    private string? _previewUrl;
    private string? _imageData;
    private string? _contentType;
    private bool _loading;
    private ProcessingMode _mode = ProcessingMode.ImageRegeneration;
    private int _descLength = 200;
    private ImageAnalysisResponse? _result;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        const long MaxBytes = 10 * 1024 * 1024;
        using var stream = file.OpenReadStream(MaxBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();

        _imageData = Convert.ToBase64String(bytes);
        _contentType = file.ContentType;
        _previewUrl = $"data:{file.ContentType};base64,{_imageData}";
    }

    private async Task AnalyzeAsync()
    {
        if (_imageData is null) return;
        _loading = true;
        _result = null;

        try
        {
            var request = new ImageAnalysisRequest
            {
                ImageData = _imageData,
                ContentType = _contentType ?? "image/png",
                DescriptionLength = _descLength,
                Mode = _mode
            };

            var response = await Http.PostAsJsonAsync("/api/images/analyze", request);
            if (response.IsSuccessStatusCode)
            {
                _result = await response.Content.ReadFromJsonAsync<ImageAnalysisResponse>();
                NotificationService.Notify(NotificationSeverity.Success, "Done!", "Image processed successfully.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                NotificationService.Notify(NotificationSeverity.Error, "Error", error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
