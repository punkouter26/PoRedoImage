@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Page Not Found — PoRedoImage</PageTitle>

@* A cancelled service: the board's own way of saying this destination isn't running. *@
<div class="container py-5">
    <div class="not-found">
        <span class="status status--failed">Cancelled</span>
        <h1 class="not-found__title"><FlapText Text="No such page" /></h1>
        <p class="not-found__hint">
            That route isn’t on the board — it may have been moved or never existed.
        </p>
        <a href="/" class="btn-process not-found__back">Back to departures</a>
    </div>
</div>