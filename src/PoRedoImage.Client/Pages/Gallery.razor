@page "/gallery"
@attribute [Authorize]
@using PoRedoImage.Domain.Entities
@using PoRedoImage.Shared.DTOs
@using PoRedoImage.Client.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject ImageSessionService SessionService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject TooltipService TooltipService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Gallery> Logger

<PageTitle>Gallery & Asset Manager — PoRedoImage</PageTitle>

<div class="gallery-page p-3 p-md-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1 text-light"><i class="bi bi-images me-2 text-warning"></i>Gallery & Asset Manager</h1>
            <p class="text-muted small mb-0">Browse, organize, chain, and batch-export your studio creations.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="flap-btn flap-btn--sm" @onclick="LoadGalleryAsync" disabled="@_loading" title="Refresh gallery">
                <i class="bi bi-arrow-clockwise me-1 @(_loading ? "spin" : "")"></i>Refresh
            </button>
            <button class="flap-btn flap-btn--primary flap-btn--sm" @onclick="@(() => Nav.NavigateTo("/"))">
                <i class="bi bi-plus-lg me-1"></i>New Creation
            </button>
        </div>
    </div>

    @* ── Filter & Search Toolbar ────────────────────────────────────── *@
    <div class="card bg-dark border-secondary mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                @* RadzenTextBox + RadzenButton rather than a Bootstrap input-group: the
                   input-group/form-control/btn-outline-secondary classes stopped existing when the
                   Bootstrap bundle was dropped, so this control was rendering unstyled. Radzen owns
                   the field chrome now and app.css retints it into the board's palette. *@
                <div class="col-md-5">
                    <label class="visually-hidden" for="gallery-search">Search images</label>
                    <div class="gallery-search">
                        <i class="bi bi-search gallery-search__icon" aria-hidden="true"></i>
                        <RadzenTextBox @bind-Value="_searchQuery"
                                       Name="gallery-search"
                                       Placeholder="Search by file name or AI tag..."
                                       aria-label="Search images"
                                       class="gallery-search__input"
                                       @oninput="@(e => _searchQuery = e.Value?.ToString() ?? string.Empty)" />
                        @if (!string.IsNullOrWhiteSpace(_searchQuery))
                        {
                            <RadzenButton Icon="close"
                                          ButtonStyle="ButtonStyle.Light"
                                          Variant="Variant.Text"
                                          Size="ButtonSize.Small"
                                          class="gallery-search__clear"
                                          aria-label="Clear search"
                                          Click="@(() => _searchQuery = string.Empty)" />
                        }
                    </div>
                </div>

                @* One RadzenSelectBar instead of five hand-rolled buttons that each re-derived
                   their own aria-checked and active class. The counts stay in the labels because
                   "Memes (0)" is what tells you a filter is worth clicking. *@
                <div class="col-md-7">
                    <div class="gallery-kinds">
                        <RadzenSelectBar @bind-Value="_selectedKind"
                                         TValue="UserImageKind?"
                                         Size="ButtonSize.Small"
                                         Change="@(_ => _selectedIds.Clear())"
                                         aria-label="Filter by image kind">
                            <Items>
                                <RadzenSelectBarItem Text="@($"All ({_images.Count})")" Value="@((UserImageKind?)null)" />
                                @foreach (var kind in FilterKinds)
                                {
                                    <RadzenSelectBarItem Text="@($"{KindLabel(kind)} ({CountFor(kind)})")"
                                                         Value="@((UserImageKind?)kind)" />
                                }
                            </Items>
                        </RadzenSelectBar>
                    </div>
                </div>
            </div>

            @* Batch action bar *@
            @if (_selectedIds.Count > 0)
            {
                <div class="d-flex align-items-center justify-content-between mt-3 pt-2 border-top border-secondary flex-wrap gap-2">
                    <div class="small text-warning">
                        <i class="bi bi-check-square me-1"></i><strong>@_selectedIds.Count</strong> image(s) selected
                    </div>
                    <div class="d-flex gap-2">
                        <button class="flap-btn flap-btn--sm" @onclick="DownloadSelectedZipAsync" disabled="@_batchWorking">
                            <i class="bi bi-file-earmark-zip me-1"></i>Download ZIP (@_selectedIds.Count)
                        </button>
                        <button class="flap-btn flap-btn--sm text-danger" @onclick="DeleteSelectedAsync" disabled="@_batchWorking">
                            <i class="bi bi-trash me-1"></i>Delete Selected
                        </button>
                        <button class="flap-btn flap-btn--sm" @onclick="@(() => _selectedIds.Clear())">
                            Clear Selection
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Content Grid ─────────────────────────────────────────────── *@
    @if (_loading)
    {
        @* Skeletons match the loaded grid: six thumbs, same column count, the same
           shimmer-anim the bulk slots use, so the loading frame matches the loaded one. *@
        <div class="row g-3" aria-busy="true" aria-live="polite">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card bg-dark border-secondary h-100 gallery-thumb gallery-thumb--skeleton shimmer-anim"
                         aria-label="Loading image"></div>
                </div>
            }
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
            <div>
                <strong>Error loading gallery:</strong> @_loadError
                <button class="btn btn-sm btn-outline-danger ms-3" @onclick="LoadGalleryAsync">Retry</button>
            </div>
        </div>
    }
    else if (FilteredImages.Count == 0)
    {
        <div class="text-center py-5 border border-dashed border-secondary rounded p-4">
            <i class="bi bi-images text-muted fs-1 mb-2 d-block"></i>
            <h4 class="text-light">No images found</h4>
            <p class="text-muted small">
                @if (!string.IsNullOrWhiteSpace(_searchQuery) || _selectedKind != null)
                {
                    <span>No items match your active search or filter. Try clearing them.</span>
                }
                else
                {
                    <span>Your studio gallery is empty. Upload and transform a photo to get started!</span>
                }
            </p>
            <button class="flap-btn flap-btn--primary mt-2" @onclick="@(() => Nav.NavigateTo("/"))">
                Go to Studio
            </button>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
            <div class="small text-muted">Showing <strong>@FilteredImages.Count</strong> item(s)</div>
            @* A checkbox, not a link styled as one: "select all" is a toggle, and RadzenCheckBox
               already renders the indeterminate state for a partial selection. The old markup used
               btn-link / text-decoration-none, neither of which exists any more. *@
            <label class="gallery-selectall">
                <RadzenCheckBox TValue="bool?"
                                TriState="true"
                                Value="@SelectAllState"
                                Change="@(_ => ToggleSelectAll())"
                                aria-label="Select all images" />
                <span>@(AllSelected ? "Deselect all" : "Select all")</span>
            </label>
        </div>

        <div class="row g-3">
            @foreach (var img in FilteredImages)
            {
                var isSelected = _selectedIds.Contains(img.Id);
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card bg-dark border-secondary h-100 gallery-card @(isSelected ? "border-warning" : "")">
                        @* The kind chip and the select box are positioned by .gallery-card__* rules
                           below. They used to ride on `position-absolute top-0 start-0 / end-0`,
                           Bootstrap utilities that no longer exist — so neither was positioned and
                           the checkbox rendered inline straight through the chip's label. *@
                        <div class="gallery-card__thumb-wrapper">
                            <img src="@img.ImageUrl" alt="@img.FileName" class="gallery-card__img" loading="lazy" />
                            <span class="badge gallery-card__kind @KindBadgeClass(img.Kind)">
                                <i class="bi @KindIcon(img.Kind) me-1"></i>@img.Kind
                            </span>
                            <div class="gallery-card__select">
                                <RadzenCheckBox TValue="bool"
                                                Value="@isSelected"
                                                Change="@(_ => ToggleSelect(img.Id))"
                                                aria-label="@($"Select {img.FileName}")" />
                            </div>
                        </div>

                        <div class="card-body p-2 d-flex flex-column justify-content-between">
                            <div>
                                <div class="small text-light text-truncate fw-semibold" title="@img.FileName">
                                    @img.FileName
                                </div>
                                <div class="text-muted extra-small d-flex justify-content-between mt-1">
                                    <span>@img.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                                    <span>@FormatSize(img.SizeBytes)</span>
                                </div>

                                @if (img.Tags?.Count > 0)
                                {
                                    <div class="mt-2 d-flex flex-wrap gap-1" style="max-height: 48px; overflow: hidden;">
                                        @foreach (var tag in img.Tags.Take(4))
                                        {
                                            <span class="badge bg-secondary extra-small cursor-pointer"
                                                  @onclick="@(() => _searchQuery = tag)" title="Filter by tag: @tag">
                                                #@tag
                                            </span>
                                        }
                                        @if (img.Tags.Count > 4)
                                        {
                                            <span class="badge bg-dark border border-secondary extra-small">+@(img.Tags.Count - 4)</span>
                                        }
                                    </div>
                                }
                            </div>

                            @* RadzenButton + TooltipService. These were `btn btn-outline-secondary
                               btn-sm` / `btn-outline-danger` — Bootstrap classes that stopped
                               existing when the bundle was dropped, so the row was rendering as
                               four unstyled icons. The native `title` attribute is replaced by a
                               real tooltip: TooltipService was already registered by
                               AddRadzenComponents() and had no callers anywhere in the app.
                               aria-label carries the same text, because a tooltip is not an
                               accessible name. *@
                            <div class="gallery-card__actions">
                                <div class="gallery-card__actions-group">
                                    <RadzenButton Icon="fullscreen" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  aria-label="View full size"
                                                  MouseEnter="@(el => ShowTooltip(el, "View full size"))"
                                                  Click="@(() => OpenLightboxAsync(img))" />
                                    <RadzenButton Icon="arrow_circle_right" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Warning"
                                                  aria-label="Use as session input"
                                                  MouseEnter="@(el => ShowTooltip(el, "Use as session input"))"
                                                  Click="@(() => UseAsInput(img))" />
                                    <RadzenButton Icon="content_copy" Variant="Variant.Text" Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  aria-label="Copy to clipboard"
                                                  MouseEnter="@(el => ShowTooltip(el, "Copy to clipboard"))"
                                                  Click="@(() => CopyToClipboardAsync(img.ImageUrl))" />
                                </div>
                                <RadzenButton Icon="@(_deletingId == img.Id ? "hourglass_top" : "delete")"
                                              Variant="Variant.Text" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Disabled="@(_deletingId == img.Id)"
                                              aria-label="Delete image"
                                              MouseEnter="@(el => ShowTooltip(el, "Delete image"))"
                                              Click="@(() => DeleteSingleAsync(img))" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .extra-small { font-size: 0.72rem; }
    .gallery-card { transition: transform 0.15s ease, border-color 0.15s ease; }
    .gallery-card:hover { transform: translateY(-2px); }
    .gallery-card__thumb-wrapper { height: 180px; overflow: hidden; background: #111; display: flex; align-items: center; justify-content: center; }
    .gallery-card__img { width: 100%; height: 100%; object-fit: cover; }
    .cursor-pointer { cursor: pointer; }
    .spin { animation: spin 1s linear infinite; }
    @@keyframes spin { 100% { transform: rotate(360deg); } }
</style>
