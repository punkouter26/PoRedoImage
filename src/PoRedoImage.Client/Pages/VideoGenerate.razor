@page "/video"
@attribute [Authorize]
@inherits FeaturePageBase

<PageTitle>Video — PoRedoImage</PageTitle>

<FeatureShell IconClass="bi-film"
              Title="Video"
              Description="Describe what should happen and Veo animates your photo into an 8-second clip with sound."
              ModelBadge="Veo 3.1 Lite">
    <ChildContent>

    @if (!isProcessing && !isComplete)
    {
        <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGalleryImage" />
        <ImageUploadPanel
            ShowDescriptionLength="true"
            ButtonLabel="Create video"
            ButtonIcon="bi-film"
            DescriptionLength="@descriptionLength"
            @bind-ImagePreviewUrl="@imagePreviewUrl"
            ErrorMessage="@errorMessage"
            CanProcess="@(canProcessImage && !string.IsNullOrWhiteSpace(_prompt))"
            OnFileChange="LoadFile"
            OnImageIntake="HandleImageIntake"
            OnProcessClicked="CreateVideo"
            OnDescriptionLengthChanged="@(l => descriptionLength = l)" />

        <div class="video-prompt-help">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <span>Describe motion and audio. Veo 3.1 Lite at 720p, ~$0.40 per 8-second clip.</span>
        </div>
    }

    @if (isProcessing)
    {
        <ProcessingProgressBar Message="@progressMessage" />
    }

    @if (isComplete)
    {
        <ResultsPanel ImagePreviewUrl="@imagePreviewUrl"
                      RightLabel="Generated clip"
                      DividerIcon="bi-film"
                      OnDownloadOriginal="DownloadVideoAsync">
            <RightSide>
                @if (!string.IsNullOrEmpty(_videoUrl))
                {
                    <video controls preload="metadata" src="@_videoUrl" aria-label="Generated video"
                           class="video-result__player"></video>
                }
            </RightSide>
            <PrimaryAction>
                <button class="flap-btn" @onclick="StartOver">Try another</button>
            </PrimaryAction>
        </ResultsPanel>
    }

    </ChildContent>
</FeatureShell>

@code {
    private int descriptionLength;
}
