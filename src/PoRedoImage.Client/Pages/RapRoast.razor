@page "/rap-roast"
@attribute [Authorize]
@inherits FeaturePageBase
@using System.Net.Http.Json

<PageTitle>Rap Roast — PoRedoImage</PageTitle>

<div class="container py-4">
    <FeatureLayout
        IconClass="bi-mic-fill"
        Title="Rap Roast"
        Description="Upload a photo and AI writes a roast verse, then performs it over a beat."
        Steps="@(new[] {
            ("bi-upload", "Upload photo"),
            ("bi-pencil", "AI writes the bars"),
            ("bi-music-note-beamed", "Hear the track")
        })" />

    @if (!isProcessing && !isComplete)
    {
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGalleryImage" />

                <ImageUploadPanel
                    ShowDescriptionLength="false"
                    ButtonLabel="Roast It"
                    ButtonIcon="bi-mic-fill"
                    ImagePreviewUrl="@imagePreviewUrl"
                    ErrorMessage="@errorMessage"
                    CanProcess="@canProcessImage"
                    OnFileChange="LoadFile"
                    OnProcessClicked="RoastAsync" />

                <fieldset class="roast-style mt-3">
                    <legend class="roast-style__legend">Beat style</legend>
                    <div class="roast-style__options">
                        @foreach (var option in StyleOptions)
                        {
                            <label class="roast-style__option @(_style == option.Value ? "roast-style__option--selected" : "")">
                                <input type="radio" name="rap-style" value="@option.Value"
                                       checked="@(_style == option.Value)"
                                       @onchange="@(() => _style = option.Value)" />
                                <span class="roast-style__name">@option.Label</span>
                                <span class="roast-style__hint">@option.Hint</span>
                            </label>
                        }
                    </div>
                </fieldset>

                <p class="roast-disclaimer">
                    <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                    Roasts stay on styling, pose and vibe — never on appearance traits like race,
                    body size, age or disability. Best used on photos of yourself and friends.
                </p>
            </div>
        </div>
    }

    @if (isProcessing)
    {
        <ProcessingProgressBar Percentage="progressPercentage" Message="@progressMessage" />
    }

    @if (isComplete && _result is not null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                @* The photo the roast is about — without it the bars have no referent, and you
                   cannot tell whether the AI actually saw what it claims to have seen. *@
                @if (!string.IsNullOrEmpty(_roastedImageUrl))
                {
                    <figure class="roast-subject">
                        <img src="@_roastedImageUrl" alt="The photo this roast is about" class="roast-subject__img" />
                        <figcaption class="roast-subject__caption">The subject of this roast</figcaption>
                    </figure>
                }

                @if (_result.AudioRefused)
                {
                    <div class="roast-refused" role="status">
                        <i class="bi bi-volume-mute me-2" aria-hidden="true"></i>
                        <div>
                            <strong>The music model declined this one.</strong>
                            <p class="mb-0 small">
                                Your bars are below — the track just didn't get made.
                                @if (!string.IsNullOrWhiteSpace(_result.RefusalReason))
                                {
                                    <span class="d-block text-break">@_result.RefusalReason</span>
                                }
                            </p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="roast-player">
                        <audio controls preload="metadata" class="roast-player__audio"
                               src="@($"data:{_result.AudioContentType};base64,{_result.AudioData}")">
                            Your browser does not support audio playback.
                        </audio>
                    </div>
                }

                @if (_result.LyricsSoftened)
                {
                    <p class="roast-softened small" role="status">
                        <i class="bi bi-emoji-smile me-1" aria-hidden="true"></i>
                        The first draft was too spicy for the music model, so this is the friendlier cut.
                    </p>
                }

                <section class="roast-lyrics" aria-label="Roast lyrics">
                    <h2 class="roast-lyrics__heading">The bars</h2>
                    <pre class="roast-lyrics__text">@_result.Lyrics</pre>
                </section>

                <details class="roast-seen" open="@(!_result.DescriptionIsDetailed)">
                    <summary>What the AI saw</summary>

                    @if (_result.Scene is { } scene)
                    {
                        @* Named slots rather than a paragraph — you can see at a glance whether the
                           model actually read the scene, and which detail the bars leaned on. *@
                        <dl class="scene-slots">
                            @if (scene.TextInImage.Count > 0)
                            {
                                <dt>Text in frame</dt>
                                <dd>
                                    @foreach (var line in scene.TextInImage)
                                    {
                                        <span class="scene-slots__chip">@line</span>
                                    }
                                </dd>
                            }
                            @if (scene.Outfit.Count > 0)
                            {
                                <dt>Wearing</dt>
                                <dd>@string.Join(", ", scene.Outfit)</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(scene.Pose))
                            {
                                <dt>Pose</dt>
                                <dd>@scene.Pose</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(scene.Expression))
                            {
                                <dt>Expression</dt>
                                <dd>@scene.Expression</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(scene.Setting))
                            {
                                <dt>Setting</dt>
                                <dd>@scene.Setting</dd>
                            }
                            @if (scene.Props.Count > 0)
                            {
                                <dt>Props</dt>
                                <dd>@string.Join(", ", scene.Props)</dd>
                            }
                            @if (!string.IsNullOrWhiteSpace(scene.MostIncongruousDetail))
                            {
                                <dt>Funniest detail</dt>
                                <dd>@scene.MostIncongruousDetail</dd>
                            }
                        </dl>
                    }
                    else
                    {
                        <p class="mb-0 small">@_result.ImageDescription</p>
                    }
                    @if (!_result.DescriptionIsDetailed)
                    {
                        <p class="roast-seen__thin mb-0">
                            <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
                            That's a keyword list, not a description — no vision model was available, so
                            the bars are working from labels alone. Configure <code>HuggingFace:ApiKey</code>
                            for a detailed read of the scene.
                        </p>
                    }
                </details>

                <div class="d-flex gap-2 mt-3">
                    <button class="btn btn-primary" @onclick="Reset">
                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Roast another
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private RapRoastResponse? _result;
    private RapStyle _style = RapStyle.BoomBap;

    // Snapshotted when the roast is submitted, not read live: the session image can change while a
    // result is on screen, which would leave the bars describing a photo that is no longer shown.
    private string? _roastedImageUrl;

    private static readonly (RapStyle Value, string Label, string Hint)[] StyleOptions =
    [
        (RapStyle.BoomBap, "Boom-bap", "90s, dusty drums"),
        (RapStyle.Trap, "Trap", "808s, hi-hat rolls"),
        (RapStyle.OldSchool, "Old-school", "Funk break, horns"),
    ];

    protected override void OnGalleryImageSelected() => _result = null;

    /// <summary>Studio "Surprise me" hand-off — the default beat style is enough to run.</summary>
    protected override Task? AutoStartAsync() => RoastAsync();

    private async Task RoastAsync()
    {
        if (!canProcessImage) return;

        isProcessing = true;
        isComplete = false;
        errorMessage = null;
        _result = null;
        progressPercentage = 15;
        progressMessage = "Looking at your photo…";
        StateHasChanged();

        try
        {
            var previewUrl = imagePreviewUrl ?? SessionService.PreviewUrl;
            if (string.IsNullOrEmpty(previewUrl))
            {
                errorMessage = "No image loaded.";
                return;
            }

            progressPercentage = 45;
            progressMessage = "Writing your bars…";
            StateHasChanged();

            _roastedImageUrl = previewUrl;

            var request = new RapRoastRequest
            {
                ImageData = ExtractBase64(previewUrl),
                ContentType = SessionService.ContentType ?? "image/png",
                Style = _style,
            };

            var response = await Http.PostAsJsonAsync("/api/rap-roast", request, SharedJsonOptions.Default);

            if (!response.IsSuccessStatusCode)
            {
                // 401 = BFF session cookie missing/expired. Send to /login instead of the
                // generic "roast pipeline failed" message. See ImageRegeneration.razor for
                // the matching fix.
                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    errorMessage = "Your session has expired. Please sign in again.";
                    NotificationService.Notify(
                        NotificationSeverity.Warning,
                        "Session expired",
                        "Please sign in again to continue.",
                        duration: 4000);
                    NavigationManager.NavigateTo("/login", forceLoad: true);
                    return;
                }

                errorMessage = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.TooManyRequests =>
                        "You're roasting faster than the beat. Give it a minute and try again.",
                    System.Net.HttpStatusCode.BadRequest =>
                        "That image couldn't be read. Try a JPG or PNG.",
                    _ => "The roast pipeline failed. Please try again.",
                };
                Logger.LogWarning("Rap roast failed: {Status}", response.StatusCode);
                return;
            }

            progressPercentage = 85;
            progressMessage = "Cutting the track…";
            StateHasChanged();

            _result = await response.Content.ReadFromJsonAsync<RapRoastResponse>(SharedJsonOptions.Default);
            isComplete = _result is not null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Rap roast request failed");
            errorMessage = "Something went wrong making your track. Please try again.";
        }
        finally
        {
            isProcessing = false;
            progressPercentage = 100;
            StateHasChanged();
        }
    }

    private void Reset()
    {
        _result = null;
        _roastedImageUrl = null;
        isComplete = false;
        errorMessage = null;
        StateHasChanged();
    }
}
