@page "/bulk-generate"
@attribute [Authorize]
@inherits FeaturePageBase
@inject PoRedoImage.Client.Services.JobTrayService Jobs

<PageTitle>Bulk Generate — PoRedoImage</PageTitle>

@* Split measure: a setup rail beside the ten-slot board. The shell sizes the rail from its
   contents and gives the board everything else.

   ModelBadge carries the provider AND the per-image price from the server's live pricing
   payload. Those used to sit in a separate cost row under the header that repeated the
   provider label a second time and the footer's session total a third. *@
<FeatureShell Title="Bulk Generate"
              ModelBadge="@(Cost.Pricing is { } pricing ? $"{pricing.ImageProviderLabel} · ≈{Cost.Format(pricing.ImageToImageUsd)}/image" : null)">

    <Aside>
    @if (!_isGenerating)
    {
        <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGalleryImage" />
        <ImageUploadPanel
            ShowProcessButton="false"
            ImagePreviewUrl="@imagePreviewUrl"
            ErrorMessage="@errorMessage"
            OnFileChange="LoadFile"
            OnImageIntake="HandleImageIntake" />

        <div class="cta-bar">
            <button class="flap-btn flap-btn--primary flap-btn--block"
                    @onclick="StartGeneration"
                    disabled="@(string.IsNullOrEmpty(imagePreviewUrl) || _activePromptCount == 0)">
                <i class="bi bi-collection-play me-1"></i>Generate @(_activePromptCount == 10 ? "All 10" : _activePromptCount.ToString()) Variation@(_activePromptCount == 1 ? "" : "s")
            </button>
            @if (_completedResults.Count > 0)
            {
                <button class="flap-btn flap-btn--block" @onclick="DownloadAllAsZip" disabled="@_zipping">
                    <i class="bi @(_zipping ? "bi-hourglass-split" : "bi-file-earmark-zip") me-1"></i>
                    @(_zipping ? "Packing…" : $"Download All ({_completedResults.Count}) as ZIP")
                </button>
            }
            @if (_favorites.Count > 0 && _results.Any(r => r.Status == BulkGenerateStatus.Complete))
            {
                <button class="flap-btn flap-btn--block" @onclick="DownloadFavorites" disabled="@_zipping">
                    <i class="bi bi-heart-fill me-1"></i>Download Favorites (@_favorites.Count)
                </button>
            }
        </div>

        @* Under the button it configures. It was a fixed bottom-left FAB that sat on the board's
           empty-state text on a phone. Outside .cta-bar on purpose: that bar is sticky with a
           z-index on a phone, which would trap the drawer beneath the header. *@
        <PromptDrawer
            Prompts="@_prompts"
            IsSaving="@_isSaving"
            OnPromptsChanged="@(p => { _prompts = p; StateHasChanged(); })"
            OnSaveRequested="SavePrompts"
            OnLoadRequested="LoadPrompts" />
    }
    else if (imagePreviewUrl is not null)
    {
        <div class="bulk-upload-preview mb-3">
            <img src="@imagePreviewUrl" alt="Source image" />
        </div>
    }
    </Aside>

    <ChildContent>
    <BulkGallery
        @ref="_bulkGallery"
        Results="@_results"
        CompletedCount="@_completedCount"
        Favorites="@_favorites"
        IsGenerating="@_isGenerating"
        OnCancel="CancelGeneration"
        OnDownloadImage="DownloadImage"
        OnToggleFavorite="ToggleFavorite"
        OnReroll="RerollFromSlot"
        OnAcceptReroll="AcceptReroll" />
    </ChildContent>
</FeatureShell>
