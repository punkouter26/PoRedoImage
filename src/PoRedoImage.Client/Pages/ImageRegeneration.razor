@page "/image-regeneration"
@attribute [Authorize]
@inherits FeaturePageBase
@inject IJSRuntime JSRuntime

<PageTitle>Image Regeneration — PoRedoImage</PageTitle>

<FeatureShell IconClass="bi-palette2"
              Title="Image Regeneration"
              Description="Upload a photo and AI will create a brand-new artistic version using Gemini."
              ModelBadge="Gemini">
    <ChildContent>

    @if (!isProcessing && !isComplete)
    {
        <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGalleryImage" />
        <StyleRecipeDrawer OnRecipeSelected="HandleRecipeSelected" CurrentRecipeId="@_activeRecipe?.Id" />
        <ImageUploadPanel
            ShowDescriptionLength="true"
            ButtonLabel="Process Image"
            ButtonIcon="bi-cpu"
            DescriptionLength="@descriptionLength"
            @bind-ImagePreviewUrl="@imagePreviewUrl"
            ErrorMessage="@errorMessage"
            CanProcess="@canProcessImage"
            OnFileChange="LoadFile"
            OnImageIntake="HandleImageIntake"
            OnProcessClicked="ProcessImage"
            OnDescriptionLengthChanged="@(l => descriptionLength = l)" />
    }

    @if (isProcessing)
    {
        <ProcessingProgressBar Message="@progressMessage" />
    }

    @if (isComplete)
    {
        <ResultsPanel ImagePreviewUrl="@imagePreviewUrl"
                      RightLabel="AI Regenerated"
                      DividerIcon="bi-arrows-expand-vertical"
                      OnDownloadOriginal="DownloadOriginal"
                      ResultImageUrl="@regeneratedImageUrl"
                      ResultFileName="regenerated.png">
            <RightSide>
                @if (regeneratedImageUrl != null)
                {
                    <img src="@regeneratedImageUrl" class="split-compare__img" alt="Regenerated"
                         onload="this.classList.add('loaded')"
                         onerror="this.onerror=null; this.src='images/image-error.png'; this.classList.add('error');" />
                }
                else
                {
                    <div class="split-compare__unavailable">Image not available</div>
                }
            </RightSide>
            <PrimaryAction>
                @if (regeneratedImageUrl != null)
                {
                    <button class="flap-btn flap-btn--primary flap-btn--sm" @onclick="DownloadRegenerated">
                        <i class="bi bi-download me-2"></i>Save &amp; Download Result
                    </button>
                }
            </PrimaryAction>
            <FooterContent>
                @if (!string.IsNullOrEmpty(imageDescription))
                {
                    <div class="description-accordion mb-3">
                        <button class="description-accordion__toggle" @onclick="@(() => _descExpanded = !_descExpanded)">
                            <span><i class="bi bi-text-left me-1"></i>AI Description</span>
                            <span class="description-accordion__meta">
                                @(imageDescription.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length) words
                                @if (analysisResult?.Metrics != null)
                                {
                                    <span class="description-accordion__time ms-2">@((analysisResult.Metrics.TotalProcessingTimeMs / 1000.0).ToString("F1"))s</span>
                                }
                                <i class="bi @(_descExpanded ? "bi-chevron-up" : "bi-chevron-down") ms-2"></i>
                            </span>
                        </button>
                        @if (_descExpanded)
                        {
                            <div class="description-accordion__body">
                                <p class="description-text">@((MarkupString)(System.Net.WebUtility.HtmlEncode(imageDescription).Replace("\n", "<br />")))</p>
                            </div>
                        }
                    </div>
                }
                @* The server names the reason when the description did not come from a model
                   that actually looked at the photo. Without this the user sees tag-derived text
                   and concludes the AI ignored their image. *@
                @if (!string.IsNullOrEmpty(analysisResult?.DescriptionFallbackReason))
                {
                    <p class="description-fallback small mb-3" role="status">
                        <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
                        @analysisResult.DescriptionFallbackReason
                    </p>
                }
            </FooterContent>
        </ResultsPanel>
    }
    </ChildContent>

    <StickyAction>
        @if (!isProcessing && !isComplete)
        {
            <button class="flap-btn flap-btn--primary mobile-sticky-cta__btn"
                    @onclick="ProcessImage" disabled="@(!canProcessImage)">
                <i class="bi bi-cpu me-1"></i>Process Image
            </button>
        }
    </StickyAction>
</FeatureShell>

@code {
    private string? regeneratedImageUrl;
    private string? imageDescription;
    private int descriptionLength = 350;
    private ImageAnalysisResponse? analysisResult;
    private bool _descExpanded;
    private PoRedoImage.Client.Models.StyleRecipe? _activeRecipe;

    private void HandleRecipeSelected(PoRedoImage.Client.Models.StyleRecipe recipe)
    {
        _activeRecipe = recipe;
        NotificationService.Notify(NotificationSeverity.Info, "Recipe Applied",
            $"{recipe.Title}: {recipe.Description}", duration: 3500);
    }

    protected override void OnGalleryImageSelected()
    {
        regeneratedImageUrl = null;
        analysisResult = null;
    }

    /// <summary>Studio "Surprise me" hand-off — the photo is all this page needs.</summary>
    protected override Task? AutoStartAsync() => ProcessImage();

    private async Task AutoSaveResultAsync(byte[] bytes, string contentType)
    {
        // Vision tags from Azure Computer Vision ride along so the gallery can filter by
        // content later. Keep them raw for now — the server side wraps them safely.
        var tags = analysisResult?.Tags;
        var savedId = await UserImageSave.SaveResultAsync(bytes, contentType, UserImageKind.Regeneration, tags);
        if (savedId is not null && _gallery is not null)
            await _gallery.LoadAsync();
    }

    private async Task ProcessImage()
    {
        if (imagePreviewUrl == null) return;

        try
        {
            isProcessing = true;
            errorMessage = null;
            progressMessage = "Preparing image for analysis...";
            StateHasChanged();

            var base64Data = ExtractBase64(imagePreviewUrl);

            // The local step (§ai-service-pickers finding #3) gets its own, more generous budget:
            // first-run browser-local inference includes a ~230 MB model download plus WASM/WebGPU
            // load, which a 3-minute budget shared with the HTTP call could exhaust on a slow
            // connection. The 3-minute HTTP CTS below is created only once the request is built, so
            // it covers just the round trip it was originally scoped to.
            using var localCts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            ImageAnalysisRequest request;
            try
            {
                request = await BuildAnalysisRequestAsync(
                    imageData: base64Data,
                    contentType: selectedFile?.ContentType ?? SessionService.ContentType ?? "image/jpeg",
                    fileName: selectedFile?.Name ?? SessionService.FileName ?? "image.jpg",
                    descriptionLength: descriptionLength,
                    mode: ProcessingMode.ImageRegeneration,
                    ct: localCts.Token);

                if (_activeRecipe != null || SessionService.StagedPrompt != null)
                {
                    var staged = SessionService.TakeStagedPrompt();
                    var promptAddition = string.Join(", ", new[] { staged, _activeRecipe?.PromptSnippet }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    if (!string.IsNullOrWhiteSpace(promptAddition))
                    {
                        request.PrecomputedDescription = string.IsNullOrWhiteSpace(request.PrecomputedDescription)
                            ? promptAddition
                            : $"{request.PrecomputedDescription}, {promptAddition}";
                    }
                }
            }
            catch (LocalInferenceException ex)
            {
                errorMessage = LocalAiErrorClassifier.Describe(ex.Failure);
                isProcessing = false;
                return;
            }
            catch (OperationCanceledException)
            {
                // LocalInferenceSession deliberately rethrows OperationCanceledException unwrapped
                // (it is not a LocalInferenceException), so it must be caught here explicitly rather
                // than falling through to the generic catch below — which would skip this reset and
                // leave the progress bar frozen.
                errorMessage = "On-device model setup took too long, likely the first-run model "
                    + "download. Try again on a faster connection, or pick a remote provider in AI services.";
                isProcessing = false;
                return;
            }

            progressMessage = "Analyzing image...";
            StateHasChanged();

            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            try
            {
                var httpResponse = await Http.PostAsJsonAsync("api/images/analyze", request, SharedJsonOptions.Default, cts.Token);

                if (!httpResponse.IsSuccessStatusCode)
                {
                    // 401 means the BFF session cookie is missing/expired (idle tab, server
                    // restart with rotated DataProtection keys, browser cleared the cookie, …).
                    // The server returns an empty body in this case, so ReadFromJsonAsync would
                    // fall into the catch and the user would see the misleading "Check that Azure
                    // services are configured" message. Send them back to /login instead.
            if (httpResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                    {
                        errorMessage = "Your session has expired. Please sign in again.";
                        NotificationService.Notify(
                            NotificationSeverity.Warning,
                            "Session expired",
                            "Please sign in again to continue.",
                            duration: 4000);
                        // forceLoad bypasses the SPA router so the cookie + auth state are
                        // re-established on the next page load.
                        NavigationManager.NavigateTo("/login", forceLoad: true);
                        return;
                    }

            try
                    {
                        var problem = await httpResponse.Content.ReadFromJsonAsync<ProblemDetailsDto>(SharedJsonOptions.Default);
                        errorMessage = problem?.Detail ?? $"Request failed ({(int)httpResponse.StatusCode})";
                    }
            catch
                    {
                        errorMessage = $"Request failed ({(int)httpResponse.StatusCode}). Check that Azure services are configured.";
                    }
                }
                else
                {
                    // Server response is a multi-MB base64 payload; deserialising it via the
                    // generated IJsonTypeInfoResolver can swallow an exception in Blazor WASM
                    // (the response reads as success but the circuit never receives the typed
                    // graph, leaving the progress spinner stuck). Read the raw body first, update
                    // the progress bar through the circuit so the spinner doesn't get stuck,
                    // then deserialize explicitly.
            progressMessage = "Decoding result…";
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
            using var respStream = await httpResponse.Content.ReadAsStreamAsync(cts.Token);
            progressMessage = "Rendering result…";
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
            analysisResult = await System.Text.Json.JsonSerializer.DeserializeAsync<ImageAnalysisResponse>(
                        respStream,
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true },
                        cts.Token);

            if (analysisResult == null)
                        throw new InvalidOperationException("No response received from API.");

            imageDescription = analysisResult.Description;
            SessionService.RecordFeatureVisit("/image-regeneration", analysisResult.Description);
            regeneratedImageUrl = !string.IsNullOrEmpty(analysisResult.RegeneratedImageData)
                        ? $"data:{analysisResult.RegeneratedImageContentType};base64,{analysisResult.RegeneratedImageData}"
                        : null;

            Cost.RecordVision(1);
            Cost.RecordTextReasoning(1);
            if (!string.IsNullOrEmpty(analysisResult.RegeneratedImageData))
                Cost.RecordImages(1);

            if (_userId is not null && !string.IsNullOrEmpty(analysisResult.RegeneratedImageData))
                        _ = AutoSaveResultAsync(
                            Convert.FromBase64String(analysisResult.RegeneratedImageData),
                            analysisResult.RegeneratedImageContentType);
                }
            }
            catch (OperationCanceledException ex)
            {
                Logger.LogError(ex, "Request timed out after 3 minutes");
                errorMessage = "Image generation timed out. Please try again with a different image.";
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error calling API");
                errorMessage = $"Error processing image: {ex.Message}";
            }
            finally
            {
                progressMessage = string.IsNullOrEmpty(errorMessage) ? "Processing complete!" : "Processing failed.";
                isProcessing = false;
                isComplete = string.IsNullOrEmpty(errorMessage);
                if (string.IsNullOrEmpty(errorMessage))
            NotificationService.Notify(NotificationSeverity.Success, "Done!", "Your regenerated image is ready.", duration: 4000);
                // Force a re-render on the UI thread so the spinner can't get stuck if the
                // deserialization of the 2 MB base64 response left the circuit waiting.
                try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
                try { StateHasChanged(); } catch (ObjectDisposedException) { }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing image: {ex.Message}";
            isProcessing = false;
            Logger.LogError(ex, "Error processing image");
            try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        }
    }

    private async Task DownloadOriginal()
    {
        if (imagePreviewUrl == null) return;
        var ok = await JSRuntime.InvokeAsync<bool>("downloadImage", imagePreviewUrl, selectedFile?.Name ?? "original.jpg");
        if (!ok) errorMessage = "There was a problem downloading the image.";
        else Logger.LogInformation("Original image download initiated");
    }

    private async Task DownloadRegenerated()
    {
        if (regeneratedImageUrl == null) return;
        var ok = await JSRuntime.InvokeAsync<bool>("downloadImage", regeneratedImageUrl, "regenerated-" + (selectedFile?.Name ?? "image.png"));
        if (!ok) errorMessage = "There was a problem downloading the regenerated image.";
        else Logger.LogInformation("Regenerated image download initiated");
    }

}
