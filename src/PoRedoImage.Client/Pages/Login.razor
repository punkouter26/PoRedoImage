@page "/login"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject IWebHostEnvironment Env
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Sign in — PoRedoImage</PageTitle>

<div class="login-page d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="login-card">
        <div class="text-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5" class="mb-3 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813
                         a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12
                         l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            <h2 class="login-title">PoRedoImage</h2>
            <p class="login-subtitle">Sign in to access your image variations and saved prompts</p>
        </div>

        @* Microsoft sign-in button — both environments *@
        <a href="@($"/challenge-microsoft?returnUrl={Uri.EscapeDataString(_returnUrl)}")" class="btn-ms-signin w-100 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 21 21" class="me-2">
                <rect x="1" y="1" width="9" height="9" fill="#F25022"/>
                <rect x="11" y="1" width="9" height="9" fill="#7FBA00"/>
                <rect x="1" y="11" width="9" height="9" fill="#00A4EF"/>
                <rect x="11" y="11" width="9" height="9" fill="#FFB900"/>
            </svg>
            Sign in with Microsoft
        </a>

        @if (Env.IsDevelopment())
        {
            <div class="login-divider"><span>or</span></div>

            <a href="/dev-login?email=guest%40guest.local&returnUrl=@Uri.EscapeDataString(_returnUrl)"
               class="btn-anon-signin w-100">
                <i class="bi bi-incognito me-2"></i>Continue as GUEST
                <span class="anon-badge">testing</span>
            </a>
        }
    </div>
</div>

<style>
    .login-page {
        background: radial-gradient(ellipse 90% 80% at 50% -10%, rgba(5,39,103,0.18), transparent);
    }
    .login-card {
        background: #0f172a;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 16px;
        padding: 2rem 2.25rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 16px 48px rgba(0,0,0,.55);
        position: relative;
        overflow: hidden;
    }
    .login-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: linear-gradient(90deg, #052767, #3a0647, #052767);
    }
    .login-title { font-size: 1.4rem; font-weight: 700; margin: 0; color: #f1f5f9; }
    .login-subtitle { font-size: .85rem; color: #94a3b8; margin-top: .3rem; }

    .btn-ms-signin {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: #1a1a1a;
        border: 1px solid #d0d7de;
        border-radius: 6px;
        padding: .6rem 1rem;
        font-size: .95rem;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s, box-shadow .15s;
    }
    .btn-ms-signin:hover {
        background: #f3f4f6;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
        color: #1a1a1a;
    }

    .login-divider {
        display: flex; align-items: center; gap: .75rem;
        color: #484f58; font-size: .8rem; margin: 1.25rem 0;
    }
    .login-divider::before, .login-divider::after {
        content: ''; flex: 1; height: 1px; background: #30363d;
    }

    .btn-anon-signin {
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #94a3b8;
        border: 1px solid #30363d;
        border-radius: 6px;
        padding: .6rem 1rem;
        font-size: .95rem;
        font-weight: 500;
        text-decoration: none;
        transition: background .15s, border-color .15s, color .15s;
        gap: .25rem;
    }
    .btn-anon-signin:hover {
        background: rgba(148,163,184,.08);
        border-color: #94a3b8;
        color: #e2e8f0;
    }
    .anon-badge {
        font-size: .65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #f0883e;
        background: rgba(240,136,62,.12);
        border: 1px solid rgba(240,136,62,.25);
        border-radius: 4px;
        padding: .1rem .35rem;
        margin-left: .4rem;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string _returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        // Redirect away if already authenticated
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(_returnUrl, forceLoad: true);
            return;
        }

        // Sanitize ReturnUrl: only allow relative paths to prevent open-redirect
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            && !ReturnUrl.StartsWith("//"))
        {
            _returnUrl = ReturnUrl;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Hide GUEST login button in production per Rule 6 (UI Hardening)
            await JS.InvokeVoidAsync("poRedoImageGuest.hideGuestButtonInProduction");

            // Auto-restore GUEST session from LocalStorage if available
            var storedGuestId = await JS.InvokeAsync<string>("poRedoImageGuest.loadGuestId");
            if (!string.IsNullOrEmpty(storedGuestId))
            {
                // Use stored guest ID to re-authenticate via guestId parameter
                NavigationManager.NavigateTo($"/dev-login?guestId={Uri.EscapeDataString(storedGuestId)}&returnUrl={Uri.EscapeDataString(_returnUrl)}", forceLoad: true);
            }
        }
    }
}
