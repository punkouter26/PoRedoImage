@page "/login"
@attribute [AllowAnonymous]
@inject IWebAssemblyHostEnvironment Env
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Sign in — PoRedoImage</PageTitle>

<div class="login-page d-flex align-items-center justify-content-center" style="min-height:80vh">
    <div class="login-card">
        <div class="text-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.5" class="mb-3 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813
                         a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12
                         l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            <h2 class="login-title">PoRedoImage</h2>
            <p class="login-subtitle">Sign in to access your image variations and saved prompts</p>
        </div>

        @* Microsoft sign-in button — both environments *@
        <a href="@($"/challenge-microsoft?returnUrl={Uri.EscapeDataString(_returnUrl)}")" class="btn-ms-signin w-100 mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 21 21" class="me-2">
                <rect x="1" y="1" width="9" height="9" fill="#F25022"/>
                <rect x="11" y="1" width="9" height="9" fill="#7FBA00"/>
                <rect x="1" y="11" width="9" height="9" fill="#00A4EF"/>
                <rect x="11" y="11" width="9" height="9" fill="#FFB900"/>
            </svg>
            Sign in with Microsoft
        </a>

        @if (Env.IsDevelopment())
        {
            <div class="login-divider"><span>or</span></div>

            <a href="/dev-login?email=guest%40guest.local&returnUrl=@Uri.EscapeDataString(_returnUrl)"
               class="btn-anon-signin w-100">
                <i class="bi bi-incognito me-2"></i>Continue as GUEST
                <span class="anon-badge">testing</span>
            </a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string _returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        // Redirect away if already authenticated
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(_returnUrl, forceLoad: true);
            return;
        }

        // Sanitize ReturnUrl: only allow relative paths to prevent open-redirect
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            && !ReturnUrl.StartsWith("//"))
        {
            _returnUrl = ReturnUrl;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Hide GUEST login button in production per Rule 6 (UI Hardening)
            await JS.InvokeVoidAsync("poRedoImageGuest.hideGuestButtonInProduction");

            // Auto-restore GUEST session from LocalStorage if available
            var storedGuestId = await JS.InvokeAsync<string>("poRedoImageGuest.loadGuestId");
            if (!string.IsNullOrEmpty(storedGuestId))
            {
                // Use stored guest ID to re-authenticate via guestId parameter
                NavigationManager.NavigateTo($"/dev-login?guestId={Uri.EscapeDataString(storedGuestId)}&returnUrl={Uri.EscapeDataString(_returnUrl)}", forceLoad: true);
            }
        }
    }
}
