@page "/login"
@attribute [AllowAnonymous]
@inject IWebAssemblyHostEnvironment Env
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Sign in — PoRedoImage</PageTitle>

<div class="login-page">
    <div class="login-card">
        @* The steel rail names the board, exactly as it does on every other panel. *@
        <div class="login-card__rail">
            <h2 class="login-title">Sign in</h2>
        </div>

        <div class="login-card__body">
            <p class="login-subtitle">
                Sign in to reach your saved images, variations, and prompts.
            </p>

            @* Microsoft sign-in — available in both environments. Uses forceLoad to ensure
               Blazor WASM client router does not intercept the server-side OIDC endpoint. *@
            <a href="@($"/challenge-microsoft?returnUrl={Uri.EscapeDataString(_returnUrl)}")"
               @onclick="SignInWithMicrosoft"
               @onclick:preventDefault="true"
               class="btn-ms-signin w-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 21 21" aria-hidden="true">
                    <rect x="1" y="1" width="9" height="9" fill="#F25022"/>
                    <rect x="11" y="1" width="9" height="9" fill="#7FBA00"/>
                    <rect x="1" y="11" width="9" height="9" fill="#00A4EF"/>
                    <rect x="11" y="11" width="9" height="9" fill="#FFB900"/>
                </svg>
                Continue with Microsoft
            </a>

            @if (Env.IsDevelopment())
            {
                <div class="login-divider"><span>or</span></div>

                @* Uses forceLoad to ensure browser performs a full GET to the Minimal API /dev-login endpoint. *@
                <a href="@($"/dev-login?email=guest%40guest.local&returnUrl={Uri.EscapeDataString(_returnUrl)}")"
                   @onclick="SignInAsGuest"
                   @onclick:preventDefault="true"
                   class="btn-anon-signin w-100">
                    <i class="bi bi-incognito" aria-hidden="true"></i>Continue as guest
                    <span class="anon-badge">testing</span>
                </a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "ReturnUrl")]
    public string? ReturnUrl { get; set; }

    private string _returnUrl = "/";

    protected override async Task OnInitializedAsync()
    {
        // Redirect away if already authenticated
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(_returnUrl, forceLoad: true);
            return;
        }

        // Sanitize ReturnUrl: only allow relative paths to prevent open-redirect
        if (!string.IsNullOrWhiteSpace(ReturnUrl)
            && Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
            && !ReturnUrl.StartsWith("//"))
        {
            _returnUrl = ReturnUrl;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Hide GUEST login button in production per Rule 6 (UI Hardening)
            await JS.InvokeVoidAsync("poRedoImageGuest.hideGuestButtonInProduction");

            // Auto-restore GUEST session from LocalStorage if available
            var storedGuestId = await JS.InvokeAsync<string>("poRedoImageGuest.loadGuestId");
            if (!string.IsNullOrEmpty(storedGuestId))
            {
                // Use stored guest ID to re-authenticate via guestId parameter
                NavigationManager.NavigateTo($"/dev-login?guestId={Uri.EscapeDataString(storedGuestId)}&returnUrl={Uri.EscapeDataString(_returnUrl)}", forceLoad: true);
            }
        }
    }

    private void SignInWithMicrosoft()
    {
        NavigationManager.NavigateTo($"/challenge-microsoft?returnUrl={Uri.EscapeDataString(_returnUrl)}", forceLoad: true);
    }

    private void SignInAsGuest()
    {
        NavigationManager.NavigateTo($"/dev-login?email=guest%40guest.local&returnUrl={Uri.EscapeDataString(_returnUrl)}", forceLoad: true);
    }
}
