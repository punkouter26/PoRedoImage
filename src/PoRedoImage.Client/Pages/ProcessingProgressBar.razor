<div class="shimmer-wrapper">
    <div class="shimmer-header">
        @* A running row lamp, not a spinning ring: this world signals work with amber
           dots stepping across a dark strip. Colours come from the tokens so the strip
           cannot drift away from the board. *@
        <div class="shimmer-spinner" role="status" aria-label="Working">
            <span class="lamp-run" aria-hidden="true"></span>
        </div>
        <div class="flex-grow-1">
            <div class="shimmer-status-label">@Message</div>
            <div class="shimmer-progress mt-2">
                <div class="shimmer-progress__bar" style="--progress: @((Percentage / 100.0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));"></div>
            </div>
        </div>
        <span class="shimmer-pct">@Percentage%</span>
    </div>
</div>

@code {
    [Parameter] public int Percentage { get; set; }
    [Parameter] public string Message { get; set; } = string.Empty;
}

