@page "/"
@inject ImageSessionService SessionService
@inject NavigationManager Nav

<PageTitle>PoRedoImage — Studio</PageTitle>

<div class="studio-page">

    @* ── Hero ──────────────────────────────────────────────────────── *@
    <div class="studio-hero">
        <div class="studio-hero__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
        </div>
        <div>
            <h1 class="studio-hero__title">AI Image Studio</h1>
            <p class="studio-hero__sub">Upload a photo, then choose how to transform it.</p>
        </div>
    </div>

    @* ── My Images gallery (auth users only) ───────────────────────── *@
    <AuthorizeView>
        <Authorized>
            <div class="studio-gallery-row">
                <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGallerySelect" />
            </div>
        </Authorized>
    </AuthorizeView>

    @* ── Upload zone + feature cards ──────────────────────────────── *@
    <div class="studio-body">
        <div class="studio-upload-col">
            <AiServicePicker />

            <ImageUploadPanel
                ShowDescriptionLength="false"
                ShowProcessButton="false"
                ImagePreviewUrl="@_previewUrl"
                ErrorMessage="@_error"
                CanProcess="false"
                OnFileChange="LoadFile"
                OnImageIntake="HandleImageIntake" />
        </div>

        <div class="studio-features-col">
            <div class="studio-feature-cards">
                @foreach (var feature in FeatureCatalog.All)
                {
                    <a class="studio-feature-card @(_hasImage ? "studio-feature-card--ready" : "")" href="@feature.Route">
                        <span class="studio-feature-card__icon">@feature.Emoji</span>
                        <div>
                            <div class="studio-feature-card__title">@feature.Title</div>
                            <p class="studio-feature-card__desc">@feature.Description</p>
                        </div>
                        <span class="studio-feature-card__cta">
                            @(_hasImage ? "Process now →" : "Try it →")
                        </span>
                    </a>
                }
            </div>

            @if (_hasImage)
            {
                <div class="studio-ready">
                    <p class="studio-ready-hint mb-0">
                        <i class="bi bi-check-circle-fill text-success me-1"></i>
                        Image ready — click any transformation above to start.
                    </p>
                    <button class="studio-surprise" @onclick="SurpriseMe"
                            title="Pick a transformation at random and run it on this image">
                        <i class="bi bi-dice-5-fill me-1"></i>Surprise me
                    </button>
                </div>
            }
        </div>
    </div>

</div>

@code {
    private string? _previewUrl;
    private string? _error;
    private bool _hasImage => SessionService.HasImage;
    private MyImagesGallery? _gallery;

    protected override void OnInitialized()
    {
        _previewUrl = SessionService.PreviewUrl;
        SessionService.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        _previewUrl = SessionService.PreviewUrl;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        _error = null;
        var (result, error) = await ImageLoadHelper.LoadAsync(e.File);
        if (error is not null) { _error = error; return; }
        _previewUrl = result!.PreviewUrl;
        SessionService.SetImage(result.PreviewUrl, result.ContentType, e.File.Name, result.Bytes);
        StateHasChanged();
    }

    /// <summary>Clipboard paste / drop-anywhere intake — same destination as an upload.</summary>
    private void HandleImageIntake(IntakeImage payload)
    {
        if (payload.Error is not null) { _error = payload.Error; StateHasChanged(); return; }
        var bytes = payload.Decode();
        if (bytes is null) { _error = "The pasted image could not be read."; StateHasChanged(); return; }

        _error = null;
        var contentType = payload.ContentType ?? "image/png";
        _previewUrl = $"data:{contentType};base64,{payload.Base64}";
        SessionService.SetImage(_previewUrl, contentType, payload.FileName ?? "pasted-image.png", bytes);
        StateHasChanged();
    }

    /// <summary>
    /// Picks a transformation at random and opens it with <c>?auto=1</c>, which
    /// <see cref="FeaturePageBase.AutoStartAsync"/> turns into an immediate run.
    /// </summary>
    /// <remarks>
    /// Bulk Generate is deliberately not in the pool: it produces ten images, and spending ten
    /// generations on a dice roll is a cost surprise, not a delight. The pool is the four
    /// single-output features, each of which needs nothing but the photo.
    /// </remarks>
    private void SurpriseMe()
    {
        if (!_hasImage) return;

        var pool = FeatureCatalog.Except("/bulk-generate").ToArray();
        var pick = pool[Random.Shared.Next(pool.Length)];
        Nav.NavigateTo($"{pick.Route}?auto=1");
    }

    private void HandleGallerySelect(MyImagesGallery.GalleryItem item)
    {
        _previewUrl = SessionService.PreviewUrl;
        StateHasChanged();
    }

    public void Dispose() => SessionService.OnChange -= OnSessionChanged;
}
