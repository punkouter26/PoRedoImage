@page "/"
@inject ImageSessionService SessionService
@inject IJSRuntime Js

<PageTitle>PoRedoImage — Studio</PageTitle>

<div class="studio-page">

    @* The visible board head and the saved-images strip were removed at the user's request, so the
       page opens straight on the intake bay. The <h1> stays in the document but not on screen: a
       page with no level-one heading is a real accessibility defect (screen-reader users navigate
       by heading, and the document outline starts at h2), and removing a visual treatment is not a
       reason to remove document structure. E2E LoginUiTests assert on it across three viewports. *@
    <h1 class="visually-hidden">Studio</h1>


    @* ── Upload zone + feature cards ──────────────────────────────── *@
    <div class="studio-body">
        <div class="studio-upload-col">
            <AiServicePicker />

            <ImageUploadPanel
                ShowDescriptionLength="false"
                ShowProcessButton="false"
                ImagePreviewUrl="@_previewUrl"
                ErrorMessage="@_error"
                CanProcess="false"
                OnFileChange="LoadFile"
                OnImageIntake="HandleImageIntake" />
        </div>

        <div class="studio-features-col">
            @* Ruled board rows, not a grid of cards. The status column reads QUEUED until a
               photo is loaded and BOARDING once one is, so the board itself tells you whether
               the service can depart. *@
            <div class="studio-feature-cards">
                <div class="row-head" aria-hidden="true">
                    <span></span>
                    <span>Service</span>
                    <span>Status</span>
                </div>

                @foreach (var feature in FeatureCatalog.All)
                {
                    <a class="studio-feature-card @(_hasImage ? "studio-feature-card--ready" : "")" href="@feature.Route">
                        <span class="studio-feature-card__icon" aria-hidden="true">
                            <i class="bi @feature.Icon"></i>
                        </span>
                        <div>
                            <div class="studio-feature-card__title">@feature.Title</div>
                            <p class="studio-feature-card__desc">@feature.Description</p>
                        </div>
                        @* The row's own status column: AWAITING PHOTO until one is loaded, READY
                           once it is.

                           It used to read BOARDING, which was the departure-board metaphor talking
                           rather than the interface. "Boarding" is a state of the SERVICE, but the
                           thing a reader needs to know here is what happens when they click — and
                           nothing is boarding, they are.

                           The status stays QUEUED in both cases, and that matters. Amber with a lit
                           lamp means WORKING in this app's four-value vocabulary, and nothing is
                           running on this screen; using it for "ready" made the board claim work
                           that was not happening. The amber affordance for a callable row comes
                           from .studio-feature-card--ready instead, which is where it already was. *@
                        <StatusCell Class="studio-feature-card__cta"
                                    Status="BoardStatus.Queued"
                                    Label="@(_hasImage ? "Ready" : "Awaiting photo")"
                                    ShowLamp="true" />
                    </a>
                }
            </div>
        </div>
    </div>

</div>

@code {
    private string? _previewUrl;
    private string? _error;
    private bool _hasImage => SessionService.HasImage;

    protected override void OnInitialized()
    {
        _previewUrl = SessionService.PreviewUrl;
        SessionService.OnChange += OnSessionChanged;
    }

    private void OnSessionChanged()
    {
        _previewUrl = SessionService.PreviewUrl;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadFile(InputFileChangeEventArgs e)
    {
        _error = null;
        var (result, error) = await ImageLoadHelper.LoadAsync(e.File, Js);
        if (error is not null) { _error = error; return; }
        _previewUrl = result!.PreviewUrl;
        SessionService.SetImage(result.PreviewUrl, result.ContentType, e.File.Name, result.Bytes);
        StateHasChanged();
    }

    /// <summary>Clipboard paste / drop-anywhere intake — same destination as an upload.</summary>
    private async Task HandleImageIntake(IntakeImage payload)
    {
        if (payload.Error is not null) { _error = payload.Error; StateHasChanged(); return; }
        var bytes = payload.Decode();
        if (bytes is null) { _error = "The pasted image could not be read."; StateHasChanged(); return; }

        _error = null;
        var contentType = payload.ContentType ?? "image/png";
        // Same downscale an uploaded file gets — see ImageLoadHelper.MaxUploadEdge.
        var shrunk = await ImageLoadHelper.ShrinkAsync(
            $"data:{contentType};base64,{payload.Base64}", contentType, bytes, Js);
        _previewUrl = shrunk.PreviewUrl;
        SessionService.SetImage(
            shrunk.PreviewUrl, shrunk.ContentType, payload.FileName ?? "pasted-image.png", shrunk.Bytes);
        StateHasChanged();
    }

    public void Dispose() => SessionService.OnChange -= OnSessionChanged;
}
