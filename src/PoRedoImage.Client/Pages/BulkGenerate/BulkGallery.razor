@namespace PoRedoImage.Client.Pages
@using PoRedoImage.Client.Models
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject DialogService DialogService

<div role="region" aria-label="Bulk generation gallery">
    @if (Results.Count == 0)
    {
        <div class="bulk-empty-state" role="status">
            <i class="bi bi-images bulk-empty-state__icon" aria-hidden="true"></i>
            <h3 class="bulk-empty-state__title">Ready to generate variations</h3>
            <p class="bulk-empty-state__hint">Upload an image and click <strong>Generate</strong> to create up to 10 artistic variations using AI.</p>
        </div>
    }
    else
    {
        <div class="mb-3">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <div class="bulk-progress-header mb-0">
                    <span id="bulk-progress-label">Generated @CompletedCount of @Results.Count images</span>
                    <span aria-hidden="true" class="ms-2 badge bg-secondary">@(Results.Count > 0 ? (int)(CompletedCount * 100.0 / Results.Count) : 0)%</span>
                </div>
                <div class="d-flex gap-2">
                    @if (_pinnedIndices.Count >= 2)
                    {
                        <button type="button" class="flap-btn flap-btn--sm flap-btn--primary" @onclick="OpenCompareMatrixAsync">
                            <i class="bi bi-grid-fill me-1 text-warning"></i>2x2 Matrix (@_pinnedIndices.Count)
                        </button>
                    }
                    @if (CompletedCount > 0)
                    {
                        <button type="button" class="flap-btn flap-btn--sm" @onclick="DownloadZipAsync" disabled="@_zipping" title="Download all completed images in a single ZIP">
                            <i class="bi @(_zipping ? "bi-hourglass-split" : "bi-file-earmark-zip") me-1 text-warning"></i>@(_zipping ? "Zipping…" : "Download All (ZIP)")
                        </button>
                    }
                </div>
            </div>
            <div class="bulk-progress-bar" role="progressbar"
                 aria-labelledby="bulk-progress-label"
                 aria-valuenow="@(Results.Count > 0 ? (int)(CompletedCount * 100.0 / Results.Count) : 0)"
                 aria-valuemin="0" aria-valuemax="100">
                <div class="bulk-progress-bar__fill"
                     style="--progress: @(Results.Count > 0 ? (CompletedCount / (double)Results.Count).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "0")">
                </div>
            </div>
        </div>

        <div class="bulk-gallery" aria-live="polite" aria-busy="@(CompletedCount < Results.Count)">
            @* NOT <Virtualize>: the container is a multi-column responsive grid, so the
               block-axis ItemSize spacer that Virtualize sizes would lie about the rendered
               height. The catalog is hard-capped at 10, so a plain foreach is the right call. *@
            @foreach (var result in Results)
            {
                <div class="bulk-slot bulk-slot--@result.Status.ToString().ToLower()">
                    <div class="bulk-slot__header">
                        @* The bay number belongs in real flap cells: this is the board's position
                           column, the one value on the page that is literally a board number. *@
                        <span class="bulk-slot__num">
                            <FlapText Text="@($"{result.Index + 1:00}")" Class="flapstrip--sm" />
                        </span>
                        @* Four states, four words, one colour law. The lamp only lights while a
                           bay is actually working, so a glance down the board finds live rows. *@
                        <StatusCell Status="@ToBoardStatus(result.Status)" ShowLamp="true" />
                    </div>

                    <div class="bulk-slot__img-area bulk-slot__img-area--@result.Status.ToString().ToLower()">
                        @switch (result.Status)
                        {
                            case BulkGenerateStatus.Pending:
                                <div class="bulk-slot__shimmer shimmer-anim" aria-label="Awaiting generation"></div>
                                break;
                            case BulkGenerateStatus.Processing:
                                <div class="bulk-slot__img-area--processing">
                                    <div class="bulk-slot__spinner" role="status" aria-label="Generating"></div>
                                    <span>Generating…</span>
                                </div>
                                break;
                            case BulkGenerateStatus.Complete when result.ImageUrl is not null:
                                <img src="@result.ImageUrl" alt="Generated variation @(result.Index + 1)" loading="lazy"
                                     class="bulk-slot__img-clickable"
                                     tabindex="0"
                                     role="button"
                                     aria-label="View variation @(result.Index + 1) at full size"
                                     @onclick="@(() => OpenVariationModalAsync(result))"
                                     @onkeydown="@(e => HandleSlotKey(e, result))" />
                                break;
                            case BulkGenerateStatus.Failed:
                                <div class="bulk-slot__img-area--failed" role="alert">
                                    <i class="bi bi-exclamation-triangle fs-4" aria-hidden="true"></i>
                                    <span>@(result.ErrorMessage ?? "Generation failed")</span>
                                </div>
                                break;
                        }
                    </div>

                    <div class="bulk-slot__footer">
                        <span class="bulk-slot__prompt-preview" title="@result.Prompt">@result.Prompt</span>
                        @if (result.Status == BulkGenerateStatus.Complete && result.ImageUrl is not null)
                        {
                            <div class="bulk-slot__actions">
                                <button class="btn-heart-slot @(_pinnedIndices.Contains(result.Index) ? "btn-heart-slot--active" : "")"
                                        aria-label="Pin variation for 2x2 comparison"
                                        @onclick="@(() => TogglePin(result.Index))"
                                        title="@(_pinnedIndices.Contains(result.Index) ? "Unpin from 2x2 matrix" : "Pin to compare in 2x2 matrix")">
                                    <i class="bi @(_pinnedIndices.Contains(result.Index) ? "bi-pin-angle-fill text-warning" : "bi-pin-angle")" aria-hidden="true"></i>
                                </button>
                                <button class="btn-heart-slot @(Favorites.Contains(result.Index) ? "btn-heart-slot--active" : "")"
                                        aria-pressed="@Favorites.Contains(result.Index)"
                                        aria-label="@(Favorites.Contains(result.Index) ? "Remove from favorites" : "Save to favorites")"
                                        @onclick="@(() => OnToggleFavorite.InvokeAsync(result.Index))"
                                        title="@(Favorites.Contains(result.Index) ? "Remove" : "Save to favorites")">
                                    <i class="bi @(Favorites.Contains(result.Index) ? "bi-heart-fill" : "bi-heart")" aria-hidden="true"></i>
                                </button>
                                <button class="btn-dl-slot"
                                        aria-label="Download variation @(result.Index + 1)"
                                        @onclick="@(() => OnDownloadImage.InvokeAsync(result.Index))">
                                    <i class="bi bi-download me-1" aria-hidden="true"></i>Save
                                </button>
                                <button class="btn-reroll-slot"
                                        aria-label="Re-roll variation @(result.Index + 1)"
                                        @onclick="@(() => OnReroll.InvokeAsync(result.Index))"
                                        disabled="@IsRerolling(result.Index)"
                                        title="Generate 3 fresh variations from this prompt (Idea #11)">
                                    @if (IsRerolling(result.Index))
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        <span>Re-rolling…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i><span>Re-roll × 3</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @* Variation modal is opened via DialogService.OpenAsync from OpenVariationModalAsync —
       Radzen provides the focus trap, Escape-to-close, and inert backdrop. The dialog's
       content lives in BulkImageModal.razor, which only paints the panel surface.
       See GalleryLightbox.razor for the rationale. *@

    @* Idea #11 — One-Tap Re-roll panel. Shows the 3 fresh variations from the last re-roll. *@
    @if (_rerollVariations.Count > 0)
    {
        <div class="bulk-reroll-panel mt-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <strong><i class="bi bi-arrow-repeat me-1"></i>Re-roll results for slot #@(_rerollSourceIndex + 1)</strong>
                <button class="flap-btn flap-btn--quiet flap-btn--sm" @onclick="@(() => _rerollVariations = [])">Close</button>
            </div>
            <div class="bulk-reroll-grid">
                @foreach (var r in _rerollVariations)
                {
                    <div class="bulk-reroll-cell">
                        <img src="@($"data:{r.ContentType};base64,{r.ImageData}")" alt="Re-roll #@(r.Index + 1)" />
                        <button class="flap-btn flap-btn--primary flap-btn--sm flap-btn--block mt-1"
                                @onclick="@(() => AcceptReroll(r))">
                            <i class="bi bi-check2 me-1"></i>Use this
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    @* The 2x2 comparison matrix is opened via DialogService.OpenAsync from
       OpenCompareMatrixAsync, the same way the single-variation modal above is. Its content
       lives in BulkCompareMatrix.razor — see that file for why it moved off the inline
       Bootstrap modal markup it used to be. *@
</div>

@code {
    /// <summary>
    /// Maps this slice's own progress enum onto the board vocabulary. The mapping is
    /// deliberately explicit: a new BulkGenerateStatus must be given a board meaning here
    /// rather than silently defaulting to a lit or an unlit row.
    /// </summary>
    private static BoardStatus ToBoardStatus(BulkGenerateStatus status) => status switch
    {
        BulkGenerateStatus.Processing => BoardStatus.Working,
        BulkGenerateStatus.Complete => BoardStatus.Done,
        BulkGenerateStatus.Failed => BoardStatus.Failed,
        _ => BoardStatus.Queued,
    };

    [Parameter] public List<BulkGenerateImageResult> Results { get; set; } = [];
    [Parameter] public int CompletedCount { get; set; }
    [Parameter] public HashSet<int> Favorites { get; set; } = [];
    [Parameter] public EventCallback<int> OnDownloadImage { get; set; }
    [Parameter] public EventCallback<int> OnToggleFavorite { get; set; }
    [Parameter] public EventCallback<int> OnReroll { get; set; }
    [Parameter] public EventCallback<(int SourceIndex, BulkRerollVariation Variation)> OnAcceptReroll { get; set; }

    private readonly HashSet<int> _rerollingIndices = [];
    private List<BulkRerollVariation> _rerollVariations = [];
    private int _rerollSourceIndex = -1;
    private readonly HashSet<int> _pinnedIndices = [];
    private bool _zipping;

    /// <summary>Opens the variation lightbox via Radzen's DialogService. The dialog's Escape
    /// handler, focus trap, inert backdrop and focus restore come from Radzen — see the
    /// why-Radzen comment at the top of GalleryLightbox.razor for the rationale.</summary>
    /// <summary>
    /// Opens the pin comparison matrix. Mirrors <see cref="OpenVariationModalAsync"/> — Radzen owns
    /// the focus trap, Escape handling and the inert backdrop, none of which the inline modal this
    /// replaced had once its Bootstrap classes stopped existing.
    /// </summary>
    private async Task OpenCompareMatrixAsync()
    {
        // Resolved here rather than inside the dialog: the dialog is a separate component instance
        // with no access to Results, and it should render what was pinned at the moment it opened.
        var items = _pinnedIndices
            .Take(4)
            .Select(idx => Results.FirstOrDefault(r => r.Index == idx))
            .Where(r => r is { ImageUrl: not null })
            .Select(r => r!)
            .OrderBy(r => r.Index)
            .ToList();

        var parameters = new Dictionary<string, object>
        {
            ["Items"] = items,
            ["Favorites"] = Favorites.ToHashSet(),
            ["OnUnpin"] = EventCallback.Factory.Create<int>(this, TogglePin),
            ["OnToggleFavorite"] = EventCallback.Factory.Create<int>(this, idx => OnToggleFavorite.InvokeAsync(idx)),
            ["OnDownload"] = EventCallback.Factory.Create<int>(this, idx => OnDownloadImage.InvokeAsync(idx)),
        };

        await DialogService.OpenAsync<BulkCompareMatrix>(
            title: "2x2 comparison matrix",
            parameters: parameters,
            options: new DialogOptions
            {
                Width = "min(900px, 94vw)",
                CloseDialogOnOverlayClick = true,
                CloseDialogOnEsc = true,
                ShowClose = true,
                Draggable = false,
                Resizable = false,
            });

        // The dialog mutates the pinned set through OnUnpin, so the trigger button's count is stale
        // by the time it closes.
        StateHasChanged();
    }

    private async Task OpenVariationModalAsync(BulkGenerateImageResult result)
    {
        var parameters = new Dictionary<string, object>
        {
            ["Result"] = result,
            ["IsFavorite"] = Favorites.Contains(result.Index),
            ["OnToggleFavorite"] = EventCallback.Factory.Create<int>(this, idx => OnToggleFavorite.InvokeAsync(idx)),
            ["OnDownload"] = EventCallback.Factory.Create<int>(this, idx => OnDownloadImage.InvokeAsync(idx)),
        };
        await DialogService.OpenAsync<BulkImageModal>(
            title: $"Variation #{result.Index + 1}",
            parameters: parameters,
            options: new DialogOptions
            {
                Width = "min(720px, 92vw)",
                CloseDialogOnOverlayClick = true,
                CloseDialogOnEsc = true,
                ShowClose = true,
                Draggable = false,
                Resizable = false,
            });
    }

    private void TogglePin(int index)
    {
        if (_pinnedIndices.Contains(index))
            _pinnedIndices.Remove(index);
        else
        {
            if (_pinnedIndices.Count >= 4)
            {
                NotificationService.Notify(NotificationSeverity.Info, "Matrix full", "You can pin up to 4 variations in the 2x2 matrix.", duration: 2500);
                return;
            }
            _pinnedIndices.Add(index);
        }
        StateHasChanged();
    }

    private async Task DownloadZipAsync()
    {
        if (_zipping) return;
        _zipping = true;
        try
        {
            var completed = Results.Where(r => r.Status == BulkGenerateStatus.Complete && !string.IsNullOrEmpty(r.ImageUrl))
                .Select(r => new { url = r.ImageUrl, name = $"variation-{r.Index + 1}.png" })
                .ToList();
            if (completed.Count == 0) return;
            var ok = await JSRuntime.InvokeAsync<bool>("poUx.downloadZip", completed, "bulk-variations.zip");
            if (ok)
            {
                NotificationService.Notify(NotificationSeverity.Success, "ZIP Downloaded", $"Packaged {completed.Count} variations into bulk-variations.zip", duration: 3000);
            }
            else
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Download issue", "Failed to build ZIP file.", duration: 3500);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Download failed", ex.Message, duration: 4000);
        }
        finally
        {
            _zipping = false;
        }
    }

    private bool IsRerolling(int index) => _rerollingIndices.Contains(index);

    /// <summary>Keyboard handler so the clickable image tile is keyboard-activatable (WCAG 2.1.1).</summary>
    private async Task HandleSlotKey(KeyboardEventArgs e, BulkGenerateImageResult result)
    {
        if (e is null) return;
        if (e.Key is "Enter" or " " or "Spacebar")
        {
            await OpenVariationModalAsync(result);
        }
    }

    public void BeginReroll(int index)
    {
        _rerollingIndices.Add(index);
        StateHasChanged();
    }

    public void EndReroll(int index, IReadOnlyList<BulkRerollVariation> variations)
    {
        _rerollingIndices.Remove(index);
        _rerollVariations = variations.ToList();
        _rerollSourceIndex = index;
        StateHasChanged();
    }

    public void ClearRerollPanel()
    {
        _rerollVariations = [];
        _rerollSourceIndex = -1;
        StateHasChanged();
    }

    private async Task AcceptReroll(BulkRerollVariation variation)
    {
        if (_rerollSourceIndex < 0) return;
        await OnAcceptReroll.InvokeAsync((_rerollSourceIndex, variation));
        _rerollVariations = [];
        _rerollSourceIndex = -1;
        StateHasChanged();
    }
}
