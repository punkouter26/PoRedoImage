@* ── Meme result — delegates shared structure to ResultsPanel ────────── *@
<ResultsPanel ImagePreviewUrl="@ImagePreviewUrl"
              RightLabel="Meme"
              DividerIcon="bi-emoji-laughing"
              OnDownloadOriginal="OnDownloadOriginal"
              OnStartOver="OnStartOver"
              CrossLink1Href="/image-regeneration"
              CrossLink1Icon="bi-palette2"
              CrossLink1Label="Regenerate Instead">
    <RightSide>
        @if (!string.IsNullOrEmpty(AnalysisResult?.MemeImageData))
        {
            var memeUrl = $"data:image/png;base64,{AnalysisResult.MemeImageData}";
            <img src="@memeUrl" class="split-compare__img" alt="Meme"
                 onload="this.classList.add('loaded')" />
        }
        else
        {
            <div class="split-compare__unavailable">Meme not available</div>
        }
    </RightSide>
    <CaptionContent>
        @if (!string.IsNullOrEmpty(AnalysisResult?.MemeCaption))
        {
            <div class="meme-caption-reveal mb-4">
                @foreach (var line in AnalysisResult.MemeCaption.Split('\n'))
                {
                    <h3 class="meme-caption-line fw-bold text-uppercase">@line</h3>
                }
            </div>
        }
    </CaptionContent>
    <PrimaryAction>
        @if (!string.IsNullOrEmpty(AnalysisResult?.MemeImageData))
        {
            <button class="btn-result-primary" @onclick="OnDownloadMeme">
                <i class="bi bi-download me-2"></i>Save &amp; Download Meme
            </button>
            <button class="btn-result-secondary" @onclick="OnManualSave" title="Save the meme to My Images gallery">
                <i class="bi bi-images me-2"></i>Save to My Images
            </button>
        }
    </PrimaryAction>
    <AdditionalMoreOptions>
        @if (AnalysisResult?.Metrics != null)
        {
            <span class="btn btn-outline-secondary btn-sm disabled">
                <i class="bi bi-clock me-1"></i>@((AnalysisResult.Metrics.TotalProcessingTimeMs / 1000.0).ToString("F1"))s
            </span>
        }
    </AdditionalMoreOptions>
</ResultsPanel>

@code {
    [Parameter] public string? ImagePreviewUrl { get; set; }
    [Parameter] public ImageAnalysisResponse? AnalysisResult { get; set; }
    [Parameter] public EventCallback OnDownloadOriginal { get; set; }
    [Parameter] public EventCallback OnDownloadMeme { get; set; }
    [Parameter] public EventCallback OnManualSave { get; set; }
    [Parameter] public EventCallback OnStartOver { get; set; }
}

