@page "/diag"
@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<Diag> Logger

<PageTitle>Diagnostics - PoRedoImage</PageTitle>

<div class="container py-4 diag-page">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <h1 class="diag-title mb-1"><i class="bi bi-activity me-2 text-primary"></i>Diagnostics</h1>
            <p class="text-muted mb-0 small">Runtime configuration &amp; service connectivity (from the BFF /api/diag). Sensitive values are masked.</p>
        </div>
        <button class="flap-btn flap-btn--sm px-3" @onclick="LoadDiagnostics" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            else
            {
                <i class="bi bi-arrow-clockwise me-1"></i>
            }
            Refresh
        </button>
    </div>

    @if (isLoading && diag is null)
    {
        <div class="alert alert-info">Loading diagnostics…</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i><span>@errorMessage</span>
        </div>
    }
    else if (diag is not null)
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-md-3"><div class="diag-stat"><div class="diag-stat__label">Environment</div><div class="diag-stat__value diag-stat__value--env">@diag.Environment</div></div></div>
            <div class="col-sm-6 col-md-3"><div class="diag-stat"><div class="diag-stat__label">.NET Version</div><div class="diag-stat__value">@diag.DotNetVersion</div></div></div>
            <div class="col-sm-6 col-md-3"><div class="diag-stat"><div class="diag-stat__label">Machine</div><div class="diag-stat__value">@diag.MachineName</div></div></div>
            <div class="col-sm-6 col-md-3"><div class="diag-stat"><div class="diag-stat__label">Process ID</div><div class="diag-stat__value">@diag.ProcessId</div></div></div>
        </div>

        @if (diag.Health is not null)
        {
            <div class="card mb-3">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="bi bi-heart-pulse me-2"></i>Health Checks</h5>
                    <span class="badge @(diag.Health.Status == "Healthy" ? "bg-success" : "bg-danger")">@diag.Health.Status</span>
                </div>
                <div class="card-body p-0">
                    <RadzenDataGrid Data="@_healthRows" TItem="HealthRow" AllowSorting="true" AllowFiltering="true"
                                    AllowPaging="false" PageSize="20" Density="Density.Compact"
                                    class="diag-config-table">
                        <Columns>
                            <RadzenDataGridColumn TItem="HealthRow" Property="Key" Title="Check" Width="40%" />
                            <RadzenDataGridColumn TItem="HealthRow" Property="StatusBadge" Title="Status" Width="14%" />
                            <RadzenDataGridColumn TItem="HealthRow" Property="Description" Title="Detail" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        }

        @if (diag.Configuration is not null)
        {
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="bi bi-gear me-2"></i>Configuration</h5>
                    <span class="badge bg-secondary">@diag.Configuration.Count entries</span>
                </div>
                <div class="card-body p-0">
                    <RadzenDataGrid Data="@_configRows" TItem="ConfigRow" AllowSorting="true" AllowFiltering="true"
                                    AllowPaging="false" PageSize="20" Density="Density.Compact"
                                    class="diag-config-table">
                        <Columns>
                            <RadzenDataGridColumn TItem="ConfigRow" Property="Key" Title="Key" Width="40%" />
                            <RadzenDataGridColumn TItem="ConfigRow" Property="Value" Title="Value" />
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </div>
        }
    }
</div>

@code {
    private DiagPayload? diag;
    private string? errorMessage;
    private bool isLoading = true;
    private IReadOnlyList<HealthRow> _healthRows = [];
    private IReadOnlyList<ConfigRow> _configRows = [];

    protected override async Task OnInitializedAsync() => await LoadDiagnostics();

    private async Task LoadDiagnostics()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();
            diag = await Http.GetFromJsonAsync<DiagPayload>("/api/diag", SharedJsonOptions.Default);
            ProjectRows();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load diagnostics: {ex.Message}";
            Logger.LogError(ex, "Error loading diagnostics");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ProjectRows()
    {
        if (diag is null) { _healthRows = []; _configRows = []; return; }
        _healthRows = diag.Health?.Entries
            .Select(kv => new HealthRow(kv.Key, kv.Value.Status ?? "?", kv.Value.Description ?? string.Empty))
            .ToList() ?? [];
        _configRows = diag.Configuration?
            .Select(kv => new ConfigRow(kv.Key, kv.Value ?? "(null)"))
            .ToList() ?? [];
    }

    private sealed record HealthRow(string Key, string StatusBadge, string Description);
    private sealed record ConfigRow(string Key, string Value);

    private sealed class DiagPayload
    {
        public string? Environment { get; set; }
        public string? MachineName { get; set; }
        public string? DotNetVersion { get; set; }
        public int ProcessId { get; set; }
        public HealthPayload? Health { get; set; }
        public Dictionary<string, string?>? Configuration { get; set; }
    }

    private sealed class HealthPayload
    {
        public string? Status { get; set; }
        public Dictionary<string, HealthEntry> Entries { get; set; } = new();
    }

    private sealed class HealthEntry
    {
        public string? Status { get; set; }
        public string? Description { get; set; }
        public double DurationMs { get; set; }
    }
}
