@using Microsoft.AspNetCore.Components.Forms
@using PoRedoImage.Client.Models
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@* No tabindex, and no container-level Enter handler.

   The panel used to be `tabindex="0"` so that Enter anywhere in it submitted. That put a tab
   stop on a role="region" — a landmark, not a control — immediately before the file input it
   contains, so reaching the uploader by keyboard cost two stops for one control and the first
   of them did nothing visible. The shortcut it bought was undiscoverable (nothing said "press
   Enter") and every caller either renders this panel's own submit button or supplies one
   directly beneath it. *@
<div class="upload-panel" role="region" aria-label="Image upload">

    @* ── Description Length Presets (Image Regeneration only) ─────── *@
    @* Placed above the drop zone so the user can choose detail level   *@
    @* before uploading — it is a prerequisite choice, not a follow-up. *@
    @if (ShowDescriptionLength)
    {
        <div class="preset-section mb-4">
            @* The sub-labels used to read "~200 / ~350 / ~500 words". They no longer do, because the
       enhancement step no longer produces paragraphs — it produces a comma-separated visual
       specification for an image generator, which is what those models actually read. The preset
       now buys more distinct visual clauses, not more prose. See
       AzureOpenAiService.EnhanceDescriptionAsync. *@
    <span class="preset-section__label"><i class="bi bi-sliders me-1"></i>Prompt detail</span>
            <div class="flap-choices flap-choices--tight">
                <button type="button"
                        class="flap-choice flap-choice--stack @(DescriptionLength <= 220 ? "flap-choice--active" : "")"
                        @onclick="@(() => OnDescriptionLengthChanged.InvokeAsync(200))">
                    <span class="flap-choice__name">Quick</span>
                    <span class="flap-choice__meta">Fewest clauses</span>
                </button>
                <button type="button"
                        class="flap-choice flap-choice--stack @(DescriptionLength > 220 && DescriptionLength <= 420 ? "flap-choice--active" : "")"
                        @onclick="@(() => OnDescriptionLengthChanged.InvokeAsync(350))">
                    <span class="flap-choice__name">Standard</span>
                    <span class="flap-choice__meta">Balanced</span>
                    <span class="flap-choice__badge">Recommended</span>
                </button>
                <button type="button"
                        class="flap-choice flap-choice--stack @(DescriptionLength > 420 ? "flap-choice--active" : "")"
                        @onclick="@(() => OnDescriptionLengthChanged.InvokeAsync(500))">
                    <span class="flap-choice__name">Detailed</span>
                    <span class="flap-choice__meta">Most clauses</span>
                </button>
            </div>
        </div>
    }

    @* ── Drop Zone ──────────────────────────────────────────────────── *@
    <div class="drop-zone @(_isDragging ? "drop-zone--active" : "") @(ImagePreviewUrl != null ? "drop-zone--has-image" : "")"
         @ondragover:preventDefault
         @ondragover="@(() => _isDragging = true)"
         @ondragleave="@(() => _isDragging = false)"
         @ondrop:preventDefault
         @ondrop="HandleDrop">

        @if (ImagePreviewUrl != null)
        {
            <div class="drop-zone__preview">
                <img src="@ImagePreviewUrl" class="preview-image" alt="Selected image" />
                <div class="drop-zone__preview-overlay">
                    <span class="drop-zone__preview-hint">
                        <i class="bi bi-arrow-repeat me-1"></i>Replace image
                    </span>
                </div>
            </div>
        }
        else
        {
            <div class="drop-zone__empty">
                <div class="drop-zone__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
                    </svg>
                </div>
                <p class="drop-zone__title">
                    <span class="drop-zone__title--desktop">Drop your image here</span>
                    <span class="drop-zone__title--mobile">Tap to upload a photo</span>
                </p>
                <p class="drop-zone__sub drop-zone__sub--desktop">or <span class="drop-zone__browse">browse to upload</span></p>
                <p class="drop-zone__formats">JPG &amp; PNG &middot; up to 20 MB</p>
                <p class="drop-zone__paste drop-zone__sub--desktop">
                    <kbd>Ctrl</kbd>+<kbd>V</kbd> to paste a screenshot, or drop a file anywhere
                </p>
            </div>
        }

        <InputFile OnChange="@OnFileChange" class="drop-zone__input" accept=".jpg,.jpeg,.png"
                   aria-label="Upload an image (JPG or PNG, up to 20 MB)" />
    </div>

    @* ── Error ─────────────────────────────────────────────────────── *@
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mt-3">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
            <span>@ErrorMessage</span>
        </div>
    }

    @* ── Process Button ────────────────────────────────────────────── *@
    @if (ShowProcessButton)
    {
        <button class="flap-btn flap-btn--primary flap-btn--block mt-4" @onclick="OnProcessClicked" disabled="@(!CanProcess)">
            <i class="bi @ButtonIcon me-2"></i>@ButtonLabel
        </button>
    }

</div>

@code {
    [Parameter] public bool ShowDescriptionLength { get; set; }
    [Parameter] public bool ShowProcessButton { get; set; } = true;
    [Parameter] public string ButtonLabel { get; set; } = "Process Image";
    [Parameter] public string ButtonIcon { get; set; } = "bi-cpu";
    [Parameter] public int DescriptionLength { get; set; }
    [Parameter] public string? ImagePreviewUrl { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool CanProcess { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFileChange { get; set; }
    [Parameter] public EventCallback OnProcessClicked { get; set; }
    [Parameter] public EventCallback<int> OnDescriptionLengthChanged { get; set; }

    /// <summary>
    /// Raised when an image arrives by clipboard paste or a drop outside the drop zone.
    /// Leave unset to opt the hosting page out of paste/drop intake entirely.
    /// </summary>
    [Parameter] public EventCallback<IntakeImage> OnImageIntake { get; set; }

    private bool _isDragging;
    private DotNetObjectReference<ImageUploadPanel>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OnImageIntake.HasDelegate) return;
        _selfRef = DotNetObjectReference.Create(this);
        try { await JSRuntime.InvokeVoidAsync("poUx.registerIntake", _selfRef); }
        catch (JSException) { /* helpers script unavailable — <InputFile> still works */ }
    }

    /// <summary>Callback target for <c>poUx.registerIntake</c>. Public only because JS invokes it.</summary>
    [JSInvokable]
    public Task AcceptIntake(IntakeImage payload) => OnImageIntake.InvokeAsync(payload);

    public async ValueTask DisposeAsync()
    {
        if (_selfRef is null) return;
        try { await JSRuntime.InvokeVoidAsync("poUx.unregisterIntake"); }
        catch (JSDisconnectedException) { /* page tearing down */ }
        catch (JSException) { }
        _selfRef.Dispose();
    }

    private Task HandleDrop(DragEventArgs e)
    {
        _isDragging = false;
        // The InputFile overlay covers the drop area and captures files natively
        return Task.CompletedTask;
    }
}
