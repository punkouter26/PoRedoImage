@page "/meme-generation"
@attribute [Authorize]
@inherits FeaturePageBase
@inject IJSRuntime JSRuntime

<PageTitle>Meme Generation — PoRedoImage</PageTitle>

<FeatureShell IconClass="bi-emoji-laughing"
              Title="Meme Generation"
              Description="Upload a photo and AI will write a witty caption and overlay it on your image."
              Steps="@(new[] {
                  ("bi-upload", "Upload photo"),
                  ("bi-cpu", "AI writes caption"),
                  ("bi-image", "Download your meme")
              })">
    <ChildContent>

    @if (!isProcessing && !isComplete)
    {
        <MyImagesGallery @ref="_gallery" OnImageSelected="HandleGalleryImage" />
        <ImageUploadPanel
            ShowDescriptionLength="false"
            ButtonLabel="@(_useTemplate ? "Render Template" : "Generate Meme")"
            ButtonIcon="@(_useTemplate ? "bi-grid-3x3-gap" : "bi-emoji-laughing")"
            DescriptionLength="350"
            @bind-ImagePreviewUrl="@imagePreviewUrl"
            ErrorMessage="@errorMessage"
            CanProcess="@canProcessImage"
            OnFileChange="LoadFile"
            OnImageIntake="HandleImageIntake"
            OnProcessClicked="ProcessImage" />

        @* ── Idea #17 — Meme Template Library toggle ────────────── *@
        <div class="meme-template-card mt-3 p-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-grid-3x3-gap-fill"></i>
                <strong>Template Library</strong>
                <div class="form-check form-switch ms-auto">
                    <input class="form-check-input" type="checkbox" id="tplToggle"
                           checked="@_useTemplate" @onchange="OnTemplateToggleChanged" />
                    <label class="form-check-label small" for="tplToggle">
                        @(_useTemplate ? "On" : "Off")
                    </label>
                </div>
            </div>
            @if (_useTemplate)
            {
                @if (_templates is null)
                {
                    <div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Loading templates…</div>
                }
                else
                {
                    <div class="meme-template-grid" role="radiogroup" aria-label="Meme template">
                        @foreach (var t in _templates)
                        {
                            var isSelected = _selectedTemplateId == t.Id;
                            <button type="button"
                                    class="flap-choice flap-choice--tile @(isSelected ? "flap-choice--active" : null)"
                                    role="radio"
                                    aria-checked="@isSelected.ToString().ToLowerInvariant()"
                                    aria-label="@($"{t.Name} — {t.Description}")"
                                    @onclick="@(() => SelectTemplate(t.Id))">
                                <span class="flap-choice__name">@t.Name</span>
                                <span class="flap-choice__meta">@t.Category · @t.RequiredZoneCount zone@(t.RequiredZoneCount == 1 ? "" : "s")</span>
                            </button>
                        }
                    </div>

                    @if (_selectedTemplate is not null)
                    {
                        <div class="meme-template-zones mt-3">
                            <p class="small text-muted mb-2">
                                <i class="bi bi-info-circle me-1"></i>@_selectedTemplate.Description
                            </p>
                            @for (var i = 0; i < _selectedTemplate.RequiredZoneCount; i++)
                            {
                                var zone = _selectedTemplate.Zones[i];
                                var zoneId = $"meme-zone-{i}";
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold" for="@zoneId">@zone.Label</label>
                                    <input id="@zoneId"
                                           class="form-control form-control-sm"
                                           placeholder="Type the text for this zone…"
                                           maxlength="120"
                                           value="@(_zoneTexts.Count > i ? _zoneTexts[i] : string.Empty)"
                                           @onchange="@(e => UpdateZoneText(i, e.Value?.ToString() ?? string.Empty))" />
                                </div>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <p class="small text-muted mb-0">
                    <i class="bi bi-lightbulb me-1"></i>
                    AI will write a witty caption automatically. Toggle on to pick from
                    20 classic formats instead.
                </p>
            }
        </div>
    }

    @if (isProcessing)
    {
        <ProcessingProgressBar Message="@progressMessage" />
    }

    @if (isComplete)
    {
        <ResultsPanel ImagePreviewUrl="@imagePreviewUrl"
                      RightLabel="Meme"
                      DividerIcon="bi-emoji-laughing"
                      OnDownloadOriginal="DownloadOriginal"
                      ResultImageUrl="@MemeImageUrl"
                      ResultFileName="meme.png">
            <RightSide>
                @if (MemeImageUrl is not null)
                {
                    <img src="@MemeImageUrl" class="split-compare__img" alt="Meme"
                         onload="this.classList.add('loaded')" />
                }
                else
                {
                    <div class="split-compare__unavailable">Meme not available</div>
                }
            </RightSide>
            <CaptionContent>
                @if (!string.IsNullOrEmpty(analysisResult?.MemeCaption))
                {
                    <div class="meme-caption-reveal mb-4">
                        @foreach (var line in analysisResult.MemeCaption.Split('\n'))
                        {
                            <h3 class="meme-caption-line fw-bold text-uppercase">@line</h3>
                        }
                    </div>
                }
                    @* The server names the reason when the description did not come from a model
                       that actually looked at the photo. Without this the user sees tag-derived text
                       and concludes the AI ignored their image. *@
                    @if (!string.IsNullOrEmpty(analysisResult?.DescriptionFallbackReason))
                    {
                        <p class="description-fallback small mb-3" role="status">
                            <i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>
                            @analysisResult.DescriptionFallbackReason
                        </p>
                    }
            </CaptionContent>
            <PrimaryAction>
                @if (!string.IsNullOrEmpty(analysisResult?.MemeImageData))
                {
                    <button class="flap-btn flap-btn--primary flap-btn--sm" @onclick="DownloadMeme">
                        <i class="bi bi-download me-2"></i>Save &amp; Download Meme
                    </button>
                }
            </PrimaryAction>
            <AdditionalMoreOptions>
                @if (analysisResult?.Metrics != null)
                {
                    <span class="flap-btn flap-btn--sm">
                        <i class="bi bi-clock me-1"></i>@((analysisResult.Metrics.TotalProcessingTimeMs / 1000.0).ToString("F1"))s
                    </span>
                }
            </AdditionalMoreOptions>
        </ResultsPanel>
    }
    </ChildContent>

    <StickyAction>
        @if (!isProcessing && !isComplete)
        {
            <button class="flap-btn flap-btn--primary mobile-sticky-cta__btn"
                    @onclick="ProcessImage" disabled="@(!canProcessImage)">
                <i class="bi @(_useTemplate ? "bi-grid-3x3-gap" : "bi-emoji-laughing") me-1"></i>@(_useTemplate ? "Render Template" : "Generate Meme")
            </button>
        }
    </StickyAction>
</FeatureShell>
