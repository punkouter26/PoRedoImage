<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Trimming hygiene (§1): run the trim analyzer on the WASM client's own code so
         trim-unsafe patterns surface as warnings. We deliberately do NOT set
         <IsTrimmable>true</IsTrimmable> here: that flag is for audited *library* assemblies and
         opts THIS app assembly into aggressive member-level trimming. Because the root component
         (Routes) and every page/layout are resolved by type-name from server-emitted render-mode
         markers — never via a static reference from the WASM entry point — the trimmer sees no
         component graph and strips them all, so the WASM runtime throws "Root component type
         'PoRedoImage.Client.Routes' could not be found in the assembly". EnableTrimAnalyzer keeps
         the warnings; leaving IsTrimmable unset lets the Blazor SDK root the app assembly's
         components as it does by default. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- IL2111: framework Router.NotFoundPage setter (reflection-annotated), not user code.
         IL2026/IL3050: every HttpClient JSON call site now passes SharedJsonOptions.Default, so
         at RUNTIME the shared DTOs resolve through the source-generated SharedJsonContext. The
         analyzer still flags them because it reasons about overload signatures, not option
         contents: only the JsonTypeInfo<T>-taking overloads are statically provable, and the
         JsonSerializerOptions-taking ones carry the [RequiresUnreferencedCode] annotation
         regardless of which resolver the options actually hold. Converting all ~25 call sites to
         the JsonTypeInfo overloads would also force the page-local view models (Diag's payload,
         the gallery item) into a serializer context, which is churn for no runtime gain while
         IsTrimmable and AOT are both off. -->
    <NoWarn>$(NoWarn);IL2111;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- WebAssembly.Authentication supplies AddAuthenticationStateDeserialization(), the WASM-side
         counterpart to the server's AddAuthenticationStateSerialization(). It is the SAFE, claims-only
         API — `AddOidcAuthentication()` (the unsafe, token-handling API in the same package) is never
         used here. The BFF invariant (no tokens in the browser) is preserved. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Radzen.Blazor" />
    <ProjectReference Include="..\PoRedoImage.Shared\PoRedoImage.Shared.csproj" />
    <ProjectReference Include="..\PoRedoImage.Domain\PoRedoImage.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Slice / contract tests live in PoRedoImage.Tests.Unit and exercise Client types. -->
    <InternalsVisibleTo Include="PoRedoImage.Tests.Unit" />
  </ItemGroup>

</Project>
