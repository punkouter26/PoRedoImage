<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoRedoImage.Application\PoRedoImage.Application.csproj" />
    <ProjectReference Include="..\PoRedoImage.Domain\PoRedoImage.Domain.csproj" />
    <ProjectReference Include="..\PoRedoImage.Shared\PoRedoImage.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoRedoImage.Tests.Unit" />
    <InternalsVisibleTo Include="PoRedoImage.Tests.Integration" />
    <InternalsVisibleTo Include="PoRedoImage.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock sample assets: dev-only video used by MockVeoVideoGenerationService when Mocks:UseMockAi
         is true. Gitignored (see .gitignore entry under "Mock sample assets"), so it is present on a
         dev box and ABSENT on a CI runner and in a fresh clone.
         This MUST stay a wildcard. A literal Include="MockSamples\mock-video.mp4" fails the build with
         MSB3030 ("Could not copy ... because it was not found") wherever the file is absent — which is
         every CI run. A glob matching nothing is silently dropped by MSBuild, so the build works both
         ways and MockVeoVideoGenerationService falls back to its embedded TinyMp4 stub at runtime
         (see MockAiServices.GetMockVideoBytes). -->
    <None Include="MockSamples\*.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure SDKs used by infrastructure implementations -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.AI.Vision.ImageAnalysis" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

</Project>
