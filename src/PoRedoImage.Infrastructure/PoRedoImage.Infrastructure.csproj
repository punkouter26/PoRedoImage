<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoRedoImage.Application\PoRedoImage.Application.csproj" />
    <ProjectReference Include="..\PoRedoImage.Domain\PoRedoImage.Domain.csproj" />
    <ProjectReference Include="..\PoRedoImage.Shared\PoRedoImage.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PoRedoImage.Tests.Unit" />
    <InternalsVisibleTo Include="PoRedoImage.Tests.Integration" />
    <InternalsVisibleTo Include="PoRedoImage.Web" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mock sample assets: dev-only video used by MockVeoVideoGenerationService when Mocks:UseMockAi
         is true. Gitignored (see .gitignore entry under "Mock sample assets"); a missing file falls
         back to the embedded TinyMp4 stub so the build never breaks for a missing artefact. -->
    <None Include="MockSamples\mock-video.mp4" CopyToOutputDirectory="PreserveNewest" Link="MockSamples\mock-video.mp4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure SDKs used by infrastructure implementations -->
    <PackageReference Include="Azure.AI.OpenAI" />
    <PackageReference Include="Azure.AI.Vision.ImageAnalysis" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

</Project>
