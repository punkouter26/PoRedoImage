{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeyVault": {
    "Uri": ""
  },
  "AZURE_KEY_VAULT_ENDPOINT": "",
  "ComputerVision": {
    "MinTagConfidence": 0.6
  },
  "OpenAI": {
    "ChatCompletionsDeployment": "gpt-4o"
  },
  "Google": {
    "ApiKey": "",
    "Imagen3Model": "gemini-2.0-flash-exp-image-generation"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "common",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc"
  },
  "FeatureFlags": {
    "UseRealAiInDev": true,
    "UseRealAiInIntegrationTests": false,
    "EnableBulkGenerate": true,
    "EnableMemeGeneration": true,
    "EnableImagen3": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "PoRedoImage"
    }
  }
}
