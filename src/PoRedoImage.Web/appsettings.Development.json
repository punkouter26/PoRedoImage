  "ImageGen": {
    "Provider": "google"
  },
  "AzureAd": {
    "TenantId": "common",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
