{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/",
    "RequireAllSecrets": false
  },
  "ComputerVision": {
    "MinTagConfidence": 0.6
  },
  "Google": {
    "Imagen3Model": "gemini-2.5-flash-image"
  },
