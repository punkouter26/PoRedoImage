{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KeyVault": {
    "Uri": "https://kv-poshared.vault.azure.net/",
    "RequireAllSecrets": false
  },
  "ComputerVision": {
    "MinTagConfidence": 0.6
  },
  "Google": {
    "Imagen3Model": "gemini-2.0-flash-exp-image-generation"
  },
  "// ImageGen": "Both Dev and Production use the cheaper HuggingFace FLUX/Qwen provider today; Google is only reachable via an explicit per-request id. Token is in user-secrets (HuggingFace:ApiKey).",
  "ImageGen": {
    "Provider": "huggingface"
  },
  "AzureAd": {
    "TenantId": "common",
    "ClientId": "",
    "ClientSecret": "",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-oidc"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
