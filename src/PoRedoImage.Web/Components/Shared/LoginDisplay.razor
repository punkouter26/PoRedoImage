<AuthorizeView>
    <Authorized>
        @{
            var name = context.User.Identity?.Name ?? string.Empty;
            // ANON users have a name like "ANON463443" — display "ANON LOGGED IN" per spec.
            var isAnon = name.StartsWith("ANON", StringComparison.OrdinalIgnoreCase);
            var displayLabel = isAnon ? "Guest" : name;
        }
        <div class="d-flex align-items-center gap-2 ms-3">
            <span class="app-nav__user text-truncate" style="max-width:200px" title="@displayLabel">
                <i class="bi bi-person-circle me-1"></i>@displayLabel
            </span>
            <a href="/logout" class="app-nav__link">
                <i class="bi bi-box-arrow-right me-1"></i>Sign out
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="/login" class="app-nav__link ms-3">
            <i class="bi bi-person me-1"></i>Sign in
        </a>
    </NotAuthorized>
</AuthorizeView>
