@using PoRedoImage.Client
@code {
    // Global Interactive WebAssembly (no prerender): the whole app — router, layout, pages —
    // runs in the browser. The host (this server project) is the BFF/API only.
    private static readonly Microsoft.AspNetCore.Components.IComponentRenderMode WasmMode = RenderModes.WasmNoPrerender;

    /// <summary>
    /// The design direction contract, emitted as a real HTML comment in the served document so it
    /// can be audited with <c>grep 11888fdd</c> against production output.
    ///
    /// It has to go through <see cref="MarkupString"/>: the Razor compiler strips literal
    /// <c>&lt;!-- --&gt;</c> comments out of .razor files, so writing the contract inline in the
    /// markup below compiled away silently and the served &lt;body&gt; carried nothing. Raw markup
    /// is the only form that survives the build here. Do not "tidy" this back into plain markup.
    /// </summary>
    private static readonly MarkupString DirectionContract = (MarkupString)"""
    <!--
    THESIS: The queue is the interface. Every job is a live board row that changes state in
      place; this refuses the dark-glass AI dashboard and its grid of same-size feature cards.
    OWN-WORLD: Matte flap-black #0D0D0F faces set in ruled character cells, brushed-steel frames,
      paint-white #F2F2F2 caps in Archivo Narrow, amber #FFB400 for working, red #D32F2F for
      failed. Square corners, hairline rules, no glass, no gradient decoration.
    STORY: The visitor sees one photo held at the head of the board, picks a transformation from a
      ruled list, and watches that row flap from QUEUED through WORKING to DONE.
    FIRST VIEWPORT: Portrait. Steel-framed board header, the intake bay at the head of the board,
      then the five transformations as ruled rows with status columns. Intake is the primary action.
    FORM: Split-Flap Concourse — user-chosen challenger over assigned index 6; seed key 11888fdd.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the
      verdict, and DESIGN.md
    -->
    """;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Archivo Narrow paints the flap faces (condensed signage caps); Archivo carries running copy.
       One family, two widths — the board's voice without a second type personality. *@
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Narrow:wght@500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* Bootstrap's CSS bundle is gone. The app used ~90 of its classes — a grid, a
       spacing scale and five components — and then spent 44 rules and 46 !important
       declarations disagreeing with the rest of it. foundation.css supplies exactly
       that set in the board's own terms. Bootstrap ICONS stay: that is a font, and
       every glyph in the app comes from it.

       Radzen's stylesheet is no longer linked here either — foundation.css @imports
       it into the `vendor` cascade layer, because unlayered CSS outranks layered CSS
       and a plain <link> would put Radzen above the entire design system. *@
    <link rel="stylesheet" href="@Assets["css/foundation.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["PoRedoImage.Client.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="WasmMode" />
    <title>PoRedoImage</title>
</head>

<body>
    @* Direction contract, as raw markup so the Razor compiler cannot strip it. See the
       DirectionContract field above for why this form is required. Do not delete. *@
    @DirectionContract
    <Routes @rendermode="WasmMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="js/imageProcessing.js"></script>
    <script src="js/recents.js"></script>
    <script src="js/guestStorage.js"></script>
    <script src="js/ux.js"></script>
    <script src="js/roastStage.js"></script>
    <!-- Local AI interop. The workers themselves are ES modules loaded on demand by this script,
         so nothing model-related is fetched unless the user actually selects a browser model. -->
    <script src="js/local-ai/local-ai-interop.js"></script>
</body>

</html>
