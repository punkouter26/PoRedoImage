    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoRedoImage.Domain\PoRedoImage.Domain.csproj" />
  </ItemGroup>

</Project>
