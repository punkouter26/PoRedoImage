{
  "workspaces": [
    {
      "name": "src",
      "path": "src",
      "areas": [
        {
          "name": "PoRedoImage.Domain",
          "applyTo": "PoRedoImage.Domain/**"
        },
        {
          "name": "PoRedoImage.Application",
          "applyTo": "PoRedoImage.Application/**"
        },
        {
          "name": "PoRedoImage.Infrastructure",
          "applyTo": "PoRedoImage.Infrastructure/**"
        },
        {
          "name": "PoRedoImage.Shared",
          "applyTo": "PoRedoImage.Shared/**"
        },
        {
          "name": "PoRedoImage.Client",
          "applyTo": "PoRedoImage.Client/**"
        },
        {
          "name": "PoRedoImage.Web",
          "applyTo": "PoRedoImage.Web/**"
        }
      ]
    },
    {
      "name": "tests",
      "path": "tests",
      "areas": [
        {
          "name": "PoRedoImage.Tests.Integration",
          "applyTo": "PoRedoImage.Tests.Integration/**"
        },
        {
          "name": "PoRedoImage.Tests.Unit",
          "applyTo": "PoRedoImage.Tests.Unit/**"
        }
      ]
    }
  ],
  "strategy": "flat"
}
