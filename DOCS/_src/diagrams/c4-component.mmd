flowchart LR
  subgraph ep["Endpoint slices — PoRedoImage.Web/Features"]
    direction TB
    e1["/api/images<br/><small>ImageAnalysisEndpoints</small>"]
    e2["/api/bulk-generate<br/><small>BulkGenerateEndpoints</small>"]
    e3["/api/user-images<br/><small>UserImageEndpoints</small>"]
    e4["/api/style-director<br/><small>StyleDirectorEndpoints</small>"]
    e5["/api/rap-roast<br/><small>RapRoastEndpoints</small>"]
    e6["/api/meme-templates<br/><small>MemeTemplateEndpoints</small>"]
    e7["/api/diag<br/><small>DiagnosticsEndpoints</small>"]
    e8["/api/pricing<br/><small>PricingEndpoints</small>"]
    e9["/auth/*<br/><small>AuthEndpoints</small>"]
  end

  subgraph cross["Cross-cutting filters & middleware"]
    direction TB
    vf["ValidationFilter&lt;T&gt;"]
    idem["IdempotencyKeyFilter<br/><small>24 h IMemoryCache de-dup</small>"]
    rl["Rate limiter 'ai-endpoints'<br/><small>10 req/min sliding, per user id</small>"]
    rc["RequestContextMiddleware"]
  end

  subgraph app["Application layer"]
    direction TB
    a1["ImageAnalysisOrchestrator"]
    a2["StyleDirectorWorkflow<br/><small>Vision → Strategist → Refiner → Critic</small>"]
    a3["RapRoastOrchestrator<br/><small>SceneDescriber → RoastLyricsWriter</small>"]
    a4["UserImageService"]
  end

  subgraph dom["Domain ports"]
    direction TB
    p1["IVisionServiceRouter"]
    p2["IGenerativeAiService"]
    p3["IImageGenerationRouter"]
    p4["IChatCompletionService"]
    p5["IMusicGenerationService"]
    p6["IUserImageRepository"]
    p7["IBulkPromptRepository"]
    p8["IMemeGeneratorService"]
  end

