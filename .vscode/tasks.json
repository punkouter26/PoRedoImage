{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PoRedoImage.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "${workspaceFolder}/PoRedoImage.slnx"
            ],
            "problemMatcher": "$msCompile",
            "group": "test"
        },
        {
            "label": "kill-dotnet",
            "type": "shell",
            "command": "taskkill /F /IM dotnet.exe /T 2>$null; exit 0",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "kill-dotnet-and-build",
            "dependsOrder": "sequence",
            "dependsOn": ["kill-dotnet", "build"]
        },
        {
            "label": "test-coverage",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/PoRedoImage.slnx",
                "--collect:XPlat Code Coverage",
                "--results-directory",
                "${workspaceFolder}/TestResults",
                "--logger",
                "trx;LogFileName=results.trx"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/src/PoRedoImage.Web"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true
        },
        {
            "label": "clean",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/PoRedoImage.slnx"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "restore",
            "command": "dotnet",
            "type": "process",
            "args": [
                "restore",
                "${workspaceFolder}/PoRedoImage.slnx"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test-e2e",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/tests/PoRedoImage.Tests.E2E"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}
